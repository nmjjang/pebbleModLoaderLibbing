function Section:Keybind(config)
    config = config or {}
    local theme = self.Window.Theme
    config.RightReserve = config.RightReserve or 70

    local row, title = makeRow(self, config, config.Height or 30)

    local display = makeText(row, {
        Text = config.Display or config.Text or "=",
        Button = true,
        TextColor3 = config.KeyTextColor or theme.DimText,
        TextSize = config.KeyTextSize or 11,
        Font = theme.Font,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -24, 0.5, 0),
        Size = UDim2.fromOffset(config.DisplayWidth or 45, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local state = {
        Value = config.Value or config.Default or nil,
        Locked = config.Locked or false,
        Picking = false,
        Blacklist = config.Blacklist or { Enum.KeyCode.Escape },
    }

    local object = {
        __type = "Keybind",
        UIElements = { Row = row, Title = title, Display = display },
    }

    local function keyName(value)
        if typeof(value) == "EnumItem" then
            return value.Name
        elseif type(value) == "string" then
            return value
        end
        return config.Display or "="
    end

    local function isBlacklisted(key)
        for _, blocked in ipairs(state.Blacklist) do
            if key == blocked then
                return true
            end
        end
        return false
    end

    local function render()
        if state.Picking then
            display.Text = config.PickingText or "..."
            display.TextColor3 = config.PickingColor or theme.Accent
        elseif config.CompactDisplay == true then
            display.Text = config.Display or "="
            display.TextColor3 = config.KeyTextColor or theme.DimText
        else
            display.Text = state.Value and keyName(state.Value) or (config.Display or "=")
            display.TextColor3 = config.KeyTextColor or theme.DimText
        end
    end

    function object:Set(value, fireCallback)
        state.Value = value
        render()
        if fireCallback ~= false then
            safeCallback(config.Callback, state.Value)
        end
        return self
    end

    function object:Get()
        return state.Value
    end

    function object:Pick()
        if state.Locked then return self end
        state.Picking = true
        render()
        return self
    end

    display.MouseButton1Click:Connect(function()
        if state.Locked then return end
        object:Pick()
    end)

    local connection
    connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not row.Parent then
            connection:Disconnect()
            return
        end

        if not state.Picking or gameProcessed then
            return
        end

        local key = input.KeyCode
        if key == Enum.KeyCode.Unknown or isBlacklisted(key) then
            state.Picking = false
            render()
            return
        end

        state.Picking = false
        state.Value = key
        render()
        safeCallback(config.Callback, key)
    end)

    attachLockAPI(object, state, display)
    render()
    return object
end

function Section:Slider(config)
    config = config or {}
    local theme = self.Window.Theme

    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100
    if min > max then min, max = max, min end

    local default = tonumber(config.Default or config.Value) or min
    default = clamp(default, min, max)

    local holder = Instance.new("Frame")
    holder.Name = config.Title or "Slider"
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(1, 0, 0, config.Height or 46)
    holder.LayoutOrder = self:_nextOrder()
    holder.Parent = self.Content

    local title = makeText(holder, {
        Text = config.Title or "Slider",
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 12,
        Font = theme.Font,
        Size = UDim2.new(1, -55, 0, 20),
    })

    local valueText = makeText(holder, {
        Text = tostring(default),
        TextColor3 = config.ValueColor or theme.MutedText,
        TextSize = config.ValueTextSize or 11,
        Font = theme.Font,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(52, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = Instance.new("TextButton")
    track.BackgroundColor3 = config.TrackColor or theme.Element
    track.BorderSizePixel = 0
    track.Position = UDim2.fromOffset(0, 30)
    track.Size = UDim2.new(1, 0, 0, config.TrackHeight or 4)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = holder
    round(track, 99)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = config.FillColor or theme.Accent
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.Parent = track
    round(fill, 99)

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = config.KnobColor or theme.Text
    knob.BorderSizePixel = 0
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.Size = UDim2.fromOffset(config.KnobSize or 10, config.KnobSize or 10)
    knob.Parent = track
    round(knob, 99)

    local state = {
        Value = default,
        Locked = config.Locked or false,
        Dragging = false,
    }

    local object = {
        __type = "Slider",
        UIElements = { Holder = holder, Title = title, Track = track, Fill = fill, Knob = knob, Value = valueText },
    }

    local function roundStep(value)
        local step = tonumber(config.Step) or 1
        if step <= 0 then step = 1 end
        return math.floor((value / step) + 0.5) * step
    end

    local function render()
        local ratio = (state.Value - min) / math.max(0.0001, max - min)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        local suffix = config.Suffix or ""
        valueText.Text = tostring(state.Value) .. suffix
    end

    function object:Set(value, fireCallback)
        value = roundStep(clamp(tonumber(value) or state.Value, min, max))
        state.Value = value
        render()
        if fireCallback ~= false then
            safeCallback(config.Callback, state.Value)
        end
        return self
    end

    function object:Get()
        return state.Value
    end

    function object:SetRange(newMin, newMax)
        min = tonumber(newMin) or min
        max = tonumber(newMax) or max
        if min > max then min, max = max, min end
        object:Set(clamp(state.Value, min, max), false)
        return self
    end

    local function updateFromX(x)
        local ratio = clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
        object:Set(min + ((max - min) * ratio), true)
    end

    track.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            state.Dragging = true
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not state.Dragging or state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            state.Dragging = false
        end
    end)

    attachLockAPI(object, state, track)
    render()
    return object
end

