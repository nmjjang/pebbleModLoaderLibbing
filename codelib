local Tab = {}
Tab.__index = Tab

function Tab:_nextSectionOrder(side)
    self.SectionOrders[side] += 1
    return self.SectionOrders[side]
end

function Tab:Section(config)
    config = config or {}
    local side = string.lower(config.Side or "Left")
    side = side == "right" and "Right" or "Left"

    local parent = side == "Right" and self.RightContainer or self.LeftContainer
    local theme = self.Window.Theme

    local frame = Instance.new("Frame")
    frame.Name = config.Title or "Section"
    frame.BackgroundColor3 = config.BackgroundColor or theme.Section
    frame.BorderSizePixel = 0
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.LayoutOrder = self:_nextSectionOrder(side)
    frame.Parent = parent
    round(frame, config.Corner or 6)

    local headerHeight = config.HeaderHeight or 30

    local header = Instance.new("Frame")
    header.BackgroundTransparency = 1
    header.Position = UDim2.fromOffset(12, 0)
    header.Size = UDim2.new(1, -24, 0, headerHeight)
    header.Parent = frame

    local iconOffset = 0
    if config.Icon then
        local icon = createIcon(header, config.Icon, config.IconSize or 13, config.IconColor or theme.MutedText)
        if icon then
            icon.AnchorPoint = Vector2.new(0, 0.5)
            icon.Position = UDim2.new(0, 0, 0.5, 0)
            iconOffset = (config.IconSize or 13) + 7
        end
    end

    local title = makeText(header, {
        Text = config.Title or "Section",
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Position = UDim2.fromOffset(iconOffset, 0),
        Size = UDim2.new(1, -iconOffset, 1, 0),
    })

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.BackgroundTransparency = 1
    content.Position = UDim2.fromOffset(12, headerHeight)
    content.Size = UDim2.new(1, -24, 0, 0)
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Parent = frame

    local contentLayout = list(content, config.ElementGap or 0)

    local section = setmetatable({
        __type = "Section",
        Window = self.Window,
        Tab = self,
        Side = side,
        Frame = frame,
        Header = header,
        Title = title,
        Content = content,
        Layout = contentLayout,
        HeaderHeight = headerHeight,
        PaddingBottom = config.PaddingBottom or 10,
        Order = 0,
    }, Section)

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        section:_recalculateHeight()
    end)

    section:_recalculateHeight()
    table.insert(self.Sections, section)
    return section
end

function Tab:Divider(config)
