    -- radius as the window, then mask only its inner/right edge back to a square.
    -- Result: all four OUTER window corners are rounded, while the sidebar/content
    -- divider remains perfectly straight.
    local windowCorner = config.Corner or 8
    round(sidebar, windowCorner)

