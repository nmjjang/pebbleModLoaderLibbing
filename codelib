Library.__index = Library

--============================================================
-- Utilities
--============================================================

local function clamp(v, a, b)
    return math.max(a, math.min(b, v))
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[MovementWaveUI] Callback error:", err)
    end
end

local function copyTable(tbl)
    local out = {}
    for k, v in pairs(tbl or {}) do
        if type(v) == "table" then
            out[k] = copyTable(v)
        else
            out[k] = v
        end
    end
    return out
end

local function merge(base, override)
    local out = copyTable(base)
    for k, v in pairs(override or {}) do
        if type(v) == "table" and type(out[k]) == "table" then
            out[k] = merge(out[k], v)
        else
            out[k] = v
        end
    end
    return out
end

local function round(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(60, 60, 60)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = parent
    return s
end

local function padding(parent, left, right, top, bottom)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, left or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.Parent = parent
    return p
end

local function list(parent, gap, fillDirection)
    local l = Instance.new("UIListLayout")
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, gap or 0)
    l.FillDirection = fillDirection or Enum.FillDirection.Vertical
    l.Parent = parent
    return l
end

local function tween(obj, duration, props, style, direction)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(
            duration or 0.15,
            style or Enum.EasingStyle.Quart,
            direction or Enum.EasingDirection.Out
        ),
        props
    )
    t:Play()
    return t
end

local function makeText(parent, props)
    props = props or {}

    local label = Instance.new(props.Button and "TextButton" or "TextLabel")
    label.BackgroundTransparency = props.BackgroundTransparency == nil and 1 or props.BackgroundTransparency
    label.BackgroundColor3 = props.BackgroundColor3 or Color3.new(1, 1, 1)
    label.BorderSizePixel = 0
    label.Text = props.Text or ""
    label.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
    label.TextSize = props.TextSize or 12
    label.Font = props.Font or Enum.Font.Gotham
    label.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    label.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
    label.TextWrapped = props.TextWrapped or false
    label.RichText = props.RichText or false
    if label:IsA("TextButton") then
        label.AutoButtonColor = false
    end
    label.Size = props.Size or UDim2.new(1, 0, 0, 24)
    label.Position = props.Position or UDim2.new()
    label.AnchorPoint = props.AnchorPoint or Vector2.new()
    label.Visible = props.Visible == nil and true or props.Visible
    label.ZIndex = props.ZIndex or 1
    label.Parent = parent

    return label
end

--============================================================
-- Lucide loader
--============================================================

local ICONS_URL = "https://raw.githubusercontent.com/Footagesus/Icons/main/Main-v2.lua"
local Lucide

do
    local ok, result = pcall(function()
        return loadstring(game:HttpGet(ICONS_URL))()
    end)

    if ok then
        Lucide = result
        if Lucide and Lucide.SetIconsType then
            Lucide.SetIconsType("lucide")
        end
    else
        warn("[MovementWaveUI] Failed to load Lucide:", result)
    end
end

local function createIcon(parent, iconName, size, color, zIndex)
    if not iconName or iconName == "" or not Lucide then
        return nil
    end

    local ok, iconData = pcall(function()
        return Lucide.Icon2(iconName)
    end)

    if not ok or not iconData then
        warn("[MovementWaveUI] Icon not found:", iconName)
        return nil
    end

    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon_" .. tostring(iconName)
    icon.BackgroundTransparency = 1
    icon.Size = UDim2.fromOffset(size or 14, size or 14)
    icon.ImageColor3 = color or Color3.new(1, 1, 1)
    icon.ZIndex = zIndex or 2

    if type(iconData) == "table" then
        icon.Image = iconData[1]
        if iconData[2] then
            icon.ImageRectSize = iconData[2].ImageRectSize
            icon.ImageRectOffset = iconData[2].ImageRectPosition
        end
    elseif type(iconData) == "string" then
        icon.Image = iconData
    end

    icon.Parent = parent
    return icon
end

