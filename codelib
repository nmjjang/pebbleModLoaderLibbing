    })

    local chev = createIcon(selector, "chevrons-up-down", 14, theme.MutedText, 3)
    if chev then
        chev.AnchorPoint = Vector2.new(1, 0.5)
        chev.Position = UDim2.new(1, -8, 0.5, 0)
    end

    local menu = Instance.new("Frame")
    menu.Name = "DropdownMenu"
    menu.BackgroundColor3 = config.MenuColor or theme.Popup
    menu.BorderSizePixel = 0
    menu.Visible = false
    menu.Position = UDim2.new(0, 0, 1, 6)
    menu.Size = UDim2.new(1, 0, 0, 0)
    menu.ZIndex = 30
    menu.ClipsDescendants = true
    menu.Parent = selector
    round(menu, config.MenuCorner or 5)
    stroke(menu, theme.Border, 1, 0.5)

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 0
    scroll.ScrollBarImageTransparency = 1
    scroll.CanvasSize = UDim2.new()
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.ZIndex = 31
    scroll.Parent = menu
    padding(scroll, 5, 5, 5, 5)
    local menuLayout = list(scroll, 4)

    local state = {
        Value = current,
        Values = values,
        Open = false,
        Locked = config.Locked or false,
    }

    local object = {
        __type = "Dropdown",
        UIElements = { Holder = holder, Title = title, Selector = selector, Value = valueLabel, Menu = menu, Scroll = scroll },
    }

    local function valueToText()
        if multi then
            if #state.Value == 0 then
                return config.Placeholder or "Select..."
            end
            local parts = {}
            for _, v in ipairs(state.Value) do
                table.insert(parts, type(v) == "table" and (v.Title or v.Name or tostring(v)) or tostring(v))
            end
            return table.concat(parts, ", ")
        end

        if state.Value == nil then
            return config.Placeholder or "Select..."
        end

        return type(state.Value) == "table" and (state.Value.Title or state.Value.Name or tostring(state.Value)) or tostring(state.Value)
    end

    local function contains(tbl, value)
        for i, v in ipairs(tbl) do
            if v == value then
                return true, i
            end
        end
        return false, nil
    end

    local function renderValue()
        valueLabel.Text = valueToText()
    end

    local function closeMenu()
        state.Open = false
        tween(menu, 0.12, { Size = UDim2.new(1, 0, 0, 0) })
        task.delay(0.13, function()
            if not state.Open and menu.Parent then
                menu.Visible = false
            end
        end)
    end

    local function openMenu()
        if state.Locked then return end
        state.Open = true
        menu.Visible = true
        local count = math.min(#state.Values, config.MaxVisible or 6)
        local h = count * (config.ItemHeight or 28) + math.max(0, count - 1) * 4 + 10
        tween(menu, 0.12, { Size = UDim2.new(1, 0, 0, h) })
    end

    local function clearMenu()
        for _, child in ipairs(scroll:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end
    end

    local function rebuild()
        clearMenu()

        for index, value in ipairs(state.Values) do
            local text = type(value) == "table" and (value.Title or value.Name or tostring(index)) or tostring(value)

            local item = makeText(scroll, {
                Text = text,
                Button = true,
                TextColor3 = theme.Text,
                TextSize = 11,
                Font = theme.Font,
                BackgroundColor3 = theme.Element,
                BackgroundTransparency = 0,
                Size = UDim2.new(1, 0, 0, config.ItemHeight or 28),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 32,
            })
            item.LayoutOrder = index
            round(item, 4)
            padding(item, 8, 8, 0, 0)

            item.MouseEnter:Connect(function()
                tween(item, 0.08, { BackgroundColor3 = theme.ElementHover })
            end)

            item.MouseLeave:Connect(function()
                tween(item, 0.08, { BackgroundColor3 = theme.Element })
            end)

            item.MouseButton1Click:Connect(function()
                if state.Locked then return end

                if multi then
                    local exists, idx = contains(state.Value, value)
                    if exists then
                        if config.AllowNone == false and #state.Value <= 1 then
                            return
                        end
                        table.remove(state.Value, idx)
                    else
                        table.insert(state.Value, value)
                    end
                else
                    state.Value = value
                    closeMenu()
                end

                renderValue()
                safeCallback(config.Callback, state.Value)
            end)
        end
    end

    function object:Open()
        openMenu()
        return self
    end

    function object:Close()
        closeMenu()
        return self
    end

    function object:Toggle()
        if state.Open then closeMenu() else openMenu() end
        return self
    end

    function object:Set(value, fireCallback)
        state.Value = value
        renderValue()
        if fireCallback ~= false then
            safeCallback(config.Callback, state.Value)
        end
        return self
    end

    function object:Get()
        return state.Value
    end

    function object:Refresh(newValues, keepValue)
        state.Values = newValues or {}
        if not keepValue then
            state.Value = multi and {} or nil
        end
        rebuild()
        renderValue()
        return self
    end

    selector.MouseButton1Click:Connect(function()
        if state.Locked then return end
        object:Toggle()
    end)

    attachLockAPI(object, state, selector)
    rebuild()
    renderValue()

    return object
end

