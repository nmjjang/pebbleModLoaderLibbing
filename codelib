        bar.Position = UDim2.fromOffset(24, 12)
        bar.Size = UDim2.new(1, -24, 0, 5)
        bar.Text = ""
        bar.AutoButtonColor = false
        bar.ZIndex = 42
        bar.Parent = channel
        round(bar, 99)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = theme.Accent
        fill.BorderSizePixel = 0
        fill.Size = UDim2.new(defaultValue, 0, 1, 0)
        fill.ZIndex = 43
        fill.Parent = bar
        round(fill, 99)

        local knob = Instance.new("Frame")
        knob.BackgroundColor3 = theme.Text
        knob.BorderSizePixel = 0
        knob.AnchorPoint = Vector2.new(0.5, 0.5)
        knob.Position = UDim2.new(defaultValue, 0, 0.5, 0)
        knob.Size = UDim2.fromOffset(9, 9)
        knob.ZIndex = 44
        knob.Parent = bar
        round(knob, 99)

        return { Bar = bar, Fill = fill, Knob = knob }
    end

    local hue = createChannel("H", h)
    local sat = createChannel("S", s)
    local val = createChannel("V", v)

    local object = {
        __type = "Colorpicker",
        UIElements = { Row = row, Title = title, Swatch = swatch, Popup = popup },
    }

    local function syncColor(fireCallback)
        state.Value = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = state.Value
        preview.BackgroundColor3 = state.Value

        hue.Fill.Size = UDim2.new(h, 0, 1, 0)
        hue.Knob.Position = UDim2.new(h, 0, 0.5, 0)
        sat.Fill.Size = UDim2.new(s, 0, 1, 0)
        sat.Knob.Position = UDim2.new(s, 0, 0.5, 0)
        val.Fill.Size = UDim2.new(v, 0, 1, 0)
        val.Knob.Position = UDim2.new(v, 0, 0.5, 0)

        if fireCallback ~= false then
            safeCallback(config.Callback, state.Value)
        end
    end

    local function bindBar(barObj, setter)
        local dragging = false

        local function update(x)
            local ratio = clamp((x - barObj.Bar.AbsolutePosition.X) / math.max(1, barObj.Bar.AbsoluteSize.X), 0, 1)
            setter(ratio)
            syncColor(true)
        end

        barObj.Bar.InputBegan:Connect(function(input)
            if state.Locked then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input.Position.X)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not dragging or state.Locked then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                update(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    bindBar(hue, function(x) h = x end)
    bindBar(sat, function(x) s = x end)
    bindBar(val, function(x) v = x end)

    function object:Set(color, fireCallback)
        if typeof(color) ~= "Color3" then return self end
        h, s, v = Color3.toHSV(color)
        syncColor(fireCallback)
        return self
    end

    function object:Get()
        return state.Value
    end

    function object:Open()
        if state.Locked then return self end
        state.Open = true
        popup.Visible = true
        return self
    end

    function object:Close()
        state.Open = false
        popup.Visible = false
        return self
    end

    swatch.MouseButton1Click:Connect(function()
        if state.Locked then return end
        if state.Open then object:Close() else object:Open() end
    end)

    attachLockAPI(object, state, swatch)
    syncColor(false)
    return object
end

