local function attachLockAPI(object, state, visual)
    state.Locked = state.Locked or false

    function object:Lock()
        state.Locked = true
        if visual then
            visual.Active = false
            visual.AutoButtonColor = false
            visual.BackgroundTransparency = math.min(1, (visual.BackgroundTransparency or 0) + 0.1)
        end
        return self
    end

    function object:Unlock()
        state.Locked = false
        if visual then
            visual.Active = true
        end
        return self
    end

    function object:IsLocked()
        return state.Locked
    end
end

local function makeRow(section, config, height)
    local theme = section.Window.Theme

    local row = Instance.new("Frame")
    row.Name = config.Title or config.Name or "Element"
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, height or 30)
    row.LayoutOrder = section:_nextOrder()
    row.Parent = section.Content

    local iconOffset = 0
    if config.Icon then
        local icon = createIcon(row, config.Icon, config.IconSize or 13, config.IconColor or theme.MutedText)
        if icon then
            icon.AnchorPoint = Vector2.new(0, 0.5)
            icon.Position = UDim2.new(0, 0, 0.5, 0)
            iconOffset = (config.IconSize or 13) + 7
        end
    end

    local title = makeText(row, {
        Text = config.Title or config.Name or "Element",
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Position = UDim2.fromOffset(iconOffset, 0),
        Size = UDim2.new(1, -(iconOffset + (config.RightReserve or 70)), 1, 0),
    })

    return row, title
end

