function Window:_setActiveTab(tab)
    if not tab or self.ActiveTab == tab then
        return
    end

    for _, t in ipairs(self.Tabs) do
        local selected = t == tab
        t.Container.Visible = selected
        t.ButtonLabel.TextColor3 = selected and self.Theme.Text or self.Theme.MutedText

        if t.ButtonIcon then
            t.ButtonIcon.ImageColor3 = selected and self.Theme.Text or self.Theme.MutedText
        end

        if t.Accent then
            t.Accent.Visible = selected
        end
    end

    self.ActiveTab = tab
    if self.Config.TitleFollowsTab == true then
        self.TitleLabel.Text = tab.Title or self.Config.Title
    else
        self.TitleLabel.Text = self.Config.Title or "Movement Wave V3"
    end
    safeCallback(self.Config.OnTabChange, tab)
end

