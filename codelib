    local titleLabel = makeText(topbar, {
        Text = config.Title or "Movement Wave V3",
        TextColor3 = config.TitleColor or Color3.fromRGB(36, 36, 36),
        TextSize = config.TitleSize or 14,
        Font = theme.Font,
        Position = UDim2.fromOffset(0, 7),
        Size = UDim2.new(1, -42, 0, 25),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.AnchorPoint = Vector2.new(1, 0)
    closeButton.Position = UDim2.new(1, -10, 0, 10)
    closeButton.Size = UDim2.fromOffset(22, 22)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = ""
    closeButton.AutoButtonColor = false
    closeButton.ZIndex = 50
    closeButton.Parent = main

    local closeIcon = createIcon(closeButton, "x", 14, theme.MutedText, 51)
    if closeIcon then
        closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        closeIcon.Position = UDim2.fromScale(0.5, 0.5)
    end

    local contentHost = Instance.new("Frame")
    contentHost.Name = "ContentHost"
    contentHost.BackgroundTransparency = 1
    contentHost.Position = UDim2.fromOffset(sidebarWidth + 10, topHeight)
    contentHost.Size = UDim2.new(1, -(sidebarWidth + 15), 1, -topHeight)
    contentHost.Parent = main

    local notificationHolder = Instance.new("Frame")
    notificationHolder.Name = "NotificationHolder"
    notificationHolder.BackgroundTransparency = 1
    notificationHolder.AnchorPoint = Vector2.new(1, 0)
    notificationHolder.Position = UDim2.new(1, -18, 0, 18)
    notificationHolder.Size = UDim2.fromOffset(config.NotificationWidth or 280, 400)
    notificationHolder.ZIndex = 200
    notificationHolder.Parent = screen
    local notificationLayout = list(notificationHolder, 8)

    local window = setmetatable({
        __type = "Window",
        Config = config,
        Theme = theme,
        ScreenGui = screen,
        Main = main,
        Sidebar = sidebar,
        SidebarList = sidebarList,
        SidebarLayout = sidebarLayout,
        Topbar = topbar,
        TitleLabel = titleLabel,
        CloseButton = closeButton,
        CloseIcon = closeIcon,
        ContentHost = contentHost,
        NotificationHolder = notificationHolder,
        Tabs = {},
        Notifications = {},
        ActiveTab = nil,
        SidebarOrder = 0,
        Visible = true,
        Destroyed = false,
    }, Window)

    closeButton.MouseEnter:Connect(function()
        if closeIcon then
            closeIcon.ImageColor3 = theme.Text
        end
    end)

    closeButton.MouseLeave:Connect(function()
        if closeIcon then
            closeIcon.ImageColor3 = theme.MutedText
        end
    end)

    closeButton.MouseButton1Click:Connect(function()
        window:Close()
    end)

    -- RightShift / custom visibility key
    local toggleKey = config.ToggleKey or Enum.KeyCode.RightShift
    local inputConnection
    inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if window.Destroyed then
            inputConnection:Disconnect()
            return
        end

        if gameProcessed then return end
        if input.KeyCode == toggleKey then
            window:ToggleVisibility()
        end
    end)

    -- Dragging
    if config.Draggable ~= false then
        local dragging = false
        local dragStart
        local startPosition
        local dragInput

        local function update(input)
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end

        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPosition = main.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        topbar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                update(input)
            end
        end)
    end

    return window
end

