function Section:Button(config)
    config = config or {}
    local theme = self.Window.Theme

    local button = Instance.new("TextButton")
    button.Name = config.Title or "Button"
    button.BackgroundColor3 = config.Color or theme.Accent
    button.BorderSizePixel = 0
    button.Size = UDim2.new(1, 0, 0, config.Height or 25)
    button.LayoutOrder = self:_nextOrder()
    button.Text = ""
    button.AutoButtonColor = false
    button.Parent = self.Content
    round(button, config.Corner or 4)

    local iconOffset = 0
    if config.Icon then
        local icon = createIcon(button, config.Icon, config.IconSize or 13, config.IconColor or theme.AccentText, 3)
        if icon then
            icon.AnchorPoint = Vector2.new(0, 0.5)
            icon.Position = UDim2.new(0, 8, 0.5, 0)
            iconOffset = (config.IconSize or 13) + 8
        end
    end

    local label = makeText(button, {
        Text = config.Title or "Button",
        TextColor3 = config.TextColor or theme.AccentText,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Position = UDim2.fromOffset(8 + iconOffset, 0),
        Size = UDim2.new(1, -(16 + iconOffset), 1, 0),
        TextXAlignment = config.TextXAlignment or (config.Icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center),
        ZIndex = 3,
    })

    local state = { Locked = config.Locked or false }
    local object = {
        __type = "Button",
        UIElements = { Button = button, Label = label },
    }

    button.MouseEnter:Connect(function()
        if not state.Locked then
            tween(button, 0.08, { BackgroundColor3 = config.HoverColor or theme.AccentHover })
        end
    end)

    button.MouseLeave:Connect(function()
        tween(button, 0.08, { BackgroundColor3 = config.Color or theme.Accent })
    end)

    button.MouseButton1Click:Connect(function()
        if state.Locked then
            return
        end
        safeCallback(config.Callback)
    end)

    attachLockAPI(object, state, button)

    function object:SetText(text)
        label.Text = tostring(text)
        return self
    end

    return object
end

function Section:Checkbox(config)
    config = config or {}
    local theme = self.Window.Theme

    --========================================================
    -- CONFIG / KEYBIND NORMALIZATION
    --========================================================

    -- Keybind behavior:
    -- nil / true     -> show "=" picker with no initial bind
    -- false          -> hide the keybind picker completely
    -- Enum.KeyCode.X -> show picker with X already selected
    -- "F"            -> show picker with F already selected
    -- table          -> advanced configuration
    local keyConfig = config.Keybind

    if keyConfig == nil or keyConfig == true then
        keyConfig = {}
    elseif typeof(keyConfig) == "EnumItem" or type(keyConfig) == "string" then
        keyConfig = {
            Value = keyConfig,
        }
    end

    local hasKeybind = keyConfig ~= false
    local hasValueText = config.ValueText ~= nil

    local boxSize = config.BoxSize or 14
    local keyWidth = hasKeybind and ((type(keyConfig) == "table" and keyConfig.Width) or config.KeybindWidth or 34) or 0
    local keyGap = config.KeybindGap or 7
    local boxRightPadding = config.BoxRightPadding or 0

    -- Reserve enough horizontal room so the title never covers the "=" picker.
    local reserve = boxSize + boxRightPadding + 10

    if hasKeybind then
        reserve += keyWidth + keyGap
    end

    if hasValueText then
        reserve += (config.ValueWidth or 48) + 6
    end

    config.RightReserve = config.RightReserve or reserve

    local row, title = makeRow(self, config, config.Height or 30)

    --========================================================
    -- CHECKBOX
    --========================================================

    local box = Instance.new("TextButton")
    box.Name = "Checkbox"
    box.AnchorPoint = Vector2.new(1, 0.5)
    box.Position = UDim2.new(1, -boxRightPadding, 0.5, 0)
    box.Size = UDim2.fromOffset(boxSize, boxSize)
    box.BackgroundColor3 = config.BoxColor or theme.Section
    box.BorderSizePixel = 0
    box.Text = ""
    box.AutoButtonColor = false
    box.Active = true
    box.ZIndex = config.BoxZIndex or 5
    box.Parent = row

    round(box, config.Corner or 4)

    -- Visible inactive border, matching the reference screenshot.
    local boxStroke = Instance.new("UIStroke")
    boxStroke.Name = "CheckboxBorder"
    boxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    boxStroke.LineJoinMode = Enum.LineJoinMode.Round
    boxStroke.Thickness = config.BorderThickness or 1
    boxStroke.Color = config.BorderColor or theme.Border
    boxStroke.Transparency = config.BorderTransparency == nil and 0 or config.BorderTransparency
    boxStroke.Parent = box

    local state = {
        Value = config.Default == true,
        Locked = config.Locked or false,
        CheckboxIcon = config.CheckboxIcon,
    }

    -- Compatibility with the older name.
    if state.CheckboxIcon == nil and config.CheckIcon ~= nil then
        state.CheckboxIcon = config.CheckIcon
    end

    local checkIcon

    local function rebuildCheckboxIcon()
        if checkIcon then
            checkIcon:Destroy()
            checkIcon = nil
        end

        -- nil / false / "" = intentionally no icon.
        if state.CheckboxIcon == nil
            or state.CheckboxIcon == false
            or state.CheckboxIcon == ""
        then
            return
        end

        checkIcon = createIcon(
            box,
            tostring(state.CheckboxIcon),
            config.CheckboxIconSize or math.max(8, boxSize - 4),
            config.CheckboxIconColor or config.CheckColor or theme.AccentText,
            box.ZIndex + 1
        )

        if checkIcon then
            checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
            checkIcon.Position = UDim2.fromScale(0.5, 0.5)
        end
    end

    rebuildCheckboxIcon()

    local object = {
        __type = "Checkbox",

        UIElements = {
            Row = row,
            Title = title,
            Box = box,
            Border = boxStroke,
            Check = checkIcon,
        },
    }

    local function renderCheckbox(animated)
        local activeColor = config.ActiveColor or theme.Accent
        local inactiveColor = config.BoxColor or theme.Section

        local activeBorderColor =
            config.ActiveBorderColor
            or config.ActiveColor
            or theme.Accent

        local inactiveBorderColor =
            config.BorderColor
            or theme.Border

        local activeBorderTransparency =
            config.ActiveBorderTransparency == nil
            and 0
            or config.ActiveBorderTransparency

        local inactiveBorderTransparency =
            config.BorderTransparency == nil
            and 0
            or config.BorderTransparency

        if animated then
            tween(box, config.AnimationTime or 0.08, {
                BackgroundColor3 = state.Value and activeColor or inactiveColor,
            })

            tween(boxStroke, config.AnimationTime or 0.08, {
                Color = state.Value and activeBorderColor or inactiveBorderColor,
                Transparency = state.Value and activeBorderTransparency or inactiveBorderTransparency,
            })
        else
            box.BackgroundColor3 =
                state.Value and activeColor or inactiveColor

            boxStroke.Color =
                state.Value and activeBorderColor or inactiveBorderColor

            boxStroke.Transparency =
                state.Value and activeBorderTransparency or inactiveBorderTransparency
        end

        if checkIcon then
            checkIcon.Visible = state.Value
        end
    end

    function object:Set(value, fireCallback)
        state.Value = value == true
        renderCheckbox(true)

        if fireCallback ~= false then
            safeCallback(config.Callback, state.Value)
        end

        return self
    end

    function object:Get()
        return state.Value
    end

    function object:Toggle(fireCallback)
        return self:Set(not state.Value, fireCallback ~= false)
    end

    function object:SetCheckboxIcon(iconName)
        state.CheckboxIcon = iconName
        rebuildCheckboxIcon()

        object.UIElements.Check = checkIcon
        renderCheckbox(false)

        return self
    end

    function object:GetCheckboxIcon()
        return state.CheckboxIcon
    end

    box.MouseButton1Click:Connect(function()
        if state.Locked then
            return
        end

        object:Set(not state.Value, true)
    end)

    --========================================================
    -- RIGHT-SIDE LAYOUT
    --========================================================

    -- Pixel distance measured from the right edge.
    local rightCursor = boxRightPadding + boxSize + keyGap

    --========================================================
    -- KEYBIND PICKER
    --========================================================

    if hasKeybind then
        keyConfig = keyConfig or {}

        -- IMPORTANT:
        -- This is a real TextButton, not a label pretending to be clickable.
        -- Giving it a higher ZIndex also prevents the row/title from swallowing
        -- the click.
        local display = Instance.new("TextButton")

        display.Name = "CheckboxKeybind"
        display.AnchorPoint = Vector2.new(1, 0.5)
        display.Position = UDim2.new(1, -rightCursor, 0.5, 0)
        display.Size = UDim2.fromOffset(keyWidth, keyConfig.Height or 22)

        display.BackgroundTransparency = 1
        display.BorderSizePixel = 0

        display.Text = keyConfig.EmptyText or keyConfig.Display or "="
        display.TextColor3 = keyConfig.TextColor or theme.DimText
        display.TextSize = keyConfig.TextSize or 11
        display.Font = keyConfig.Font or theme.Font

        display.TextXAlignment =
            keyConfig.TextXAlignment
            or Enum.TextXAlignment.Right

        display.TextYAlignment = Enum.TextYAlignment.Center
        display.AutoButtonColor = false
        display.Active = true
        display.Selectable = true
        display.ZIndex = keyConfig.ZIndex or 8
        display.Parent = row

        rightCursor += keyWidth + 6

        local initialKey =
            keyConfig.Value
            or keyConfig.Default

        local keyState = {
            Value = initialKey,
            Picking = false,
            PreviousValue = nil,
            Locked = keyConfig.Locked == true,
            Blacklist = keyConfig.Blacklist or {},
        }

        local keyObject = {
            __type = "Keybind",

            UIElements = {
                Display = display,
                Row = row,
            },
        }

        local function normalizeKey(value)
            if typeof(value) == "EnumItem" then
                return value
            end

            if type(value) == "string" then
                return Enum.KeyCode[value]
            end

            return nil
        end

        keyState.Value = normalizeKey(keyState.Value)

        local function keyName(value)
            if typeof(value) == "EnumItem" then
                return value.Name
            end

            return keyConfig.EmptyText
                or keyConfig.Display
                or "="
        end

        local function isBlacklisted(key)
            for _, blocked in ipairs(keyState.Blacklist) do
                local normalized = normalizeKey(blocked)

                if normalized and normalized == key then
                    return true
                end
            end

            return false
        end

        local function renderKey()
            if keyState.Picking then
                display.Text = keyConfig.PickingText or "..."
                display.TextColor3 =
                    keyConfig.PickingColor
                    or theme.Accent
            elseif keyState.Value then
                display.Text = keyName(keyState.Value)
                display.TextColor3 =
                    keyConfig.BoundColor
                    or keyConfig.TextColor
                    or theme.MutedText
            else
                -- "=" means: no keybind assigned.
                display.Text =
                    keyConfig.EmptyText
                    or keyConfig.Display
                    or "="

                display.TextColor3 =
                    keyConfig.TextColor
                    or theme.DimText
            end
        end

        local function setPicking(value)
            keyState.Picking = value == true
            renderKey()
        end

        function keyObject:Set(value, fireCallback)
            keyState.Value = normalizeKey(value)
            keyState.Picking = false
            renderKey()

            if fireCallback ~= false then
                safeCallback(
                    keyConfig.Callback,
                    keyState.Value
                )
            end

            return self
        end

        function keyObject:Get()
            return keyState.Value
        end

        function keyObject:Clear(fireCallback)
            keyState.Value = nil
            keyState.Picking = false
            renderKey()

            if fireCallback ~= false then
                safeCallback(
                    keyConfig.Callback,
                    nil
                )
            end

            return self
        end

        function keyObject:Pick()
            if state.Locked or keyState.Locked then
                return self
            end

            keyState.PreviousValue =
                keyState.Value

            setPicking(true)

            safeCallback(
                keyConfig.OnPicking,
                true
            )

            return self
        end

        function keyObject:CancelPick()
            keyState.Value =
                keyState.PreviousValue

            setPicking(false)

            safeCallback(
                keyConfig.OnPicking,
                false
            )

            return self
        end

        function keyObject:Lock()
            keyState.Locked = true
            display.Active = false
            display.TextTransparency = 0.45
            return self
        end

        function keyObject:Unlock()
            keyState.Locked = false
            display.Active = true
            display.TextTransparency = 0
            return self
        end

        -- Small hover cue so it is obvious "=" is interactive.
        display.MouseEnter:Connect(function()
            if not state.Locked and not keyState.Locked and not keyState.Picking then
                tween(display, 0.08, {
                    TextColor3 = keyConfig.HoverColor or theme.Text,
                })
            end
        end)

        display.MouseLeave:Connect(function()
            renderKey()
        end)

        display.MouseButton1Click:Connect(function()
            keyObject:Pick()
        end)

        local keyConnection

        keyConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not row.Parent then
                if keyConnection then
                    keyConnection:Disconnect()
                end
                return
            end

            local key = input.KeyCode

            if key == Enum.KeyCode.Unknown then
                return
            end

            -- PICKING MODE:
            -- the next keyboard key becomes the keybind.
            if keyState.Picking then
                if key == Enum.KeyCode.Escape then
                    keyObject:CancelPick()
                    return
                end

                -- Backspace/Delete = remove the bind and return to "=".
                if key == Enum.KeyCode.Backspace
                    or key == Enum.KeyCode.Delete
                then
                    keyObject:Clear(true)

                    safeCallback(
                        keyConfig.OnPicking,
                        false
                    )

                    return
                end

                if isBlacklisted(key) then
                    return
                end

                keyState.Value = key
                keyState.Picking = false
                renderKey()

                safeCallback(
                    keyConfig.Callback,
                    key
                )

                safeCallback(
                    keyConfig.OnPicking,
                    false
                )

                return
            end

            -- NORMAL MODE:
            -- pressing the assigned key toggles this checkbox.
            if gameProcessed
                or state.Locked
                or keyState.Locked
            then
                return
            end

            if keyState.Value
                and key == keyState.Value
            then
                object:Set(
                    not state.Value,
                    true
                )

                safeCallback(
                    keyConfig.OnTriggered,
                    state.Value,
                    key
                )
            end
        end)

        object.Keybind = keyObject
        object.UIElements.Keybind = display

        function object:SetKeybind(value, fireCallback)
            keyObject:Set(value, fireCallback)
            return self
        end

        function object:GetKeybind()
            return keyObject:Get()
        end

        function object:ClearKeybind(fireCallback)
            keyObject:Clear(fireCallback)
            return self
        end

        function object:PickKeybind()
            keyObject:Pick()
            return self
        end

        renderKey()
    end

    --========================================================
    -- OPTIONAL VALUE TEXT
    --========================================================

    if hasValueText then
        local valueWidth =
            config.ValueWidth or 48

        local valueLabel = makeText(row, {
            Text = tostring(config.ValueText),

            TextColor3 =
                config.ValueTextColor
                or theme.DimText,

            TextSize =
                config.ValueTextSize
                or 11,

            Font = theme.Font,

            AnchorPoint =
                Vector2.new(1, 0.5),

            Position =
                UDim2.new(
                    1,
                    -rightCursor,
                    0.5,
                    0
                ),

            Size =
                UDim2.fromOffset(
                    valueWidth,
                    20
                ),

            TextXAlignment =
                Enum.TextXAlignment.Right,

            ZIndex = 4,
        })

        rightCursor += valueWidth + 6

        object.UIElements.ValueText =
            valueLabel

        function object:SetValueText(value)
            valueLabel.Text =
                tostring(value)

            return self
        end
    end

    attachLockAPI(
        object,
        state,
        box
    )

    renderCheckbox(false)

    return object
end

