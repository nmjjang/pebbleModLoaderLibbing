local Section = {}
Section.__index = Section

function Section:_nextOrder()
    self.Order += 1
    return self.Order
end

function Section:_recalculateHeight()
    task.defer(function()
        if not self.Frame.Parent then
            return
        end
        local contentHeight = self.Layout.AbsoluteContentSize.Y
        self.Frame.Size = UDim2.new(1, 0, 0, self.HeaderHeight + self.PaddingBottom + contentHeight)
    end)
end

function Section:Divider(config)
    config = config or {}

    local holder = Instance.new("Frame")
    holder.Name = "Divider"
    holder.BackgroundTransparency = 1
    holder.Size = UDim2.new(1, 0, 0, config.Height or 12)
    holder.LayoutOrder = self:_nextOrder()
    holder.Parent = self.Content

    local line = Instance.new("Frame")
    line.BorderSizePixel = 0
    line.BackgroundColor3 = config.Color or self.Window.Theme.Border
    line.BackgroundTransparency = config.Transparency or 0.35
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.Position = UDim2.new(0, 0, 0.5, 0)
    line.Size = UDim2.new(1, 0, 0, config.Thickness or 1)
    line.Parent = holder

    local object = { __type = "Divider", UI = holder }
    setmetatable(object, { __index = object })
    return object
end

