        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    local ok = pcall(function() screen.Parent = CoreGui end)
    if not ok then screen.Parent = PlayerGui end
    self.ScreenGui = screen

    -- Main
    local main = New("Frame", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = config.Position or Defaults.Position,
        Size = size,
        BackgroundColor3 = self.Theme.BackgroundTop,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = screen,
    })
    Corner(main, corner)
    self.Main = main

    local mainGrad = New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, self.Theme.BackgroundTop),
            ColorSequenceKeypoint.new(1, self.Theme.BackgroundBottom),
        }),
        Rotation = 90,
        Parent = main,
    })
    self.MainGradient = mainGrad

    -- Sidebar
    local sidebar = New("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = self.Theme.Sidebar,
        BorderSizePixel = 0,
        Size = UDim2.new(0, sidebarWidth, 1, 0),
        Parent = main,
    })
    Corner(sidebar, corner)

    -- Máscara para não vazar cantos do sidebar
    New("Frame", {
        Name = "SidebarRightMask",
        BackgroundColor3 = self.Theme.Sidebar,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -corner, 0, 0),
        Size = UDim2.new(0, corner, 1, 0),
        ZIndex = sidebar.ZIndex,
        Parent = sidebar,
    })

    New("Frame", {
        Name = "Divider",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = self.Theme.SidebarDivider,
        BorderSizePixel = 0,
        Parent = sidebar,
    })

    local sidebarList = New("Frame", {
        Name = "SidebarList",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(25, 31),
        Size = UDim2.new(1, -25, 1, -40),
        Parent = sidebar,
    })
    List(sidebarList, 0)
    self.SidebarList = sidebarList

    -- Topbar
    local topbar = New("Frame", {
        Name = "Topbar",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(sidebarWidth + 10, 0),
        Size = UDim2.new(1, -(sidebarWidth + 10), 0, topHeight),
        Parent = main,
    })
    self.Topbar = topbar

    local titleLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = self.Title,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = self.Theme.FontMedium,
        Position = UDim2.fromOffset(0, 7),
        Size = UDim2.new(1, -90, 0, 25),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = topbar,
    })
    self.TitleLabel = titleLabel

    -- Close button
    local closeBtn = New("TextButton", {
        Name = "CloseButton",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 10),
        Size = UDim2.fromOffset(22, 22),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 50,
        Parent = main,
    })

    local closeIcon = CreateIcon("x", 14, self.Theme.MutedText, 51)
    closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    closeIcon.Position = UDim2.fromScale(0.5, 0.5)
    closeIcon.Parent = closeBtn

    closeBtn.MouseEnter:Connect(function()
        Tween(closeIcon, 0.14, { ImageColor3 = self.Theme.Text })
    end)
    closeBtn.MouseLeave:Connect(function()
        Tween(closeIcon, 0.14, { ImageColor3 = self.Theme.MutedText })
    end)
    closeBtn.MouseButton1Click:Connect(function()
        Tween(main, 0.18, {
            Size = UDim2.new(main.Size.X.Scale, main.Size.X.Offset - 18,
                main.Size.Y.Scale, main.Size.Y.Offset - 18),
        })
        task.delay(0.18, function() self:Close() end)
    end)

    -- Content host
    local contentHost = New("Frame", {
        Name = "ContentHost",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(sidebarWidth + 10, topHeight),
        Size = UDim2.new(1, -(sidebarWidth + 15), 1, -topHeight),
        Parent = main,
    })
    self.ContentHost = contentHost

    -- Notification holder
    local notifHolder = New("Frame", {
        Name = "NotificationHolder",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.fromOffset(2, 2),
        Size = UDim2.fromOffset(520, 400),
        ZIndex = 200,
        Parent = screen,
    })
    List(notifHolder, 4)
    self.NotificationHolder = notifHolder

    -- Toggle key
    local toggleKey = config.ToggleKey or Defaults.ToggleKey
    local inputConn
    inputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if self.Destroyed then inputConn:Disconnect() return end
        if gp then return end
        if input.KeyCode == toggleKey then
            self:ToggleVisibility()
        end
    end)

    -- Drag
    if config.Draggable ~= false then
        local dragging, dragStart, startPos, dragInput

        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        topbar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    return self
end

print("[HybridUI] Loaded v" .. Hybrid.Version)
return Hybrid
