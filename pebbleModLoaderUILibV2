local function CreateIcon(name, size, color, zIndex)
    local icon = New("ImageLabel", {
        Name = "Icon_" .. tostring(name),
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(size or 14, size or 14),
        Image = GetIcon(name),
        ImageColor3 = color or DefaultTheme.Icon,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = zIndex or 2,
    })
