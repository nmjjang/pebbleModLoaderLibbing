function Window:_ScriptStatus(text, danger)
    self._scriptStatusText = tostring(text or "")
    self._scriptStatusDanger = danger == true
    if self.ScriptEditorElements then
        local label = self.ScriptEditorElements.Status
        label.Text = self._scriptStatusText
        label.TextColor3 = danger and self.Theme.Danger or self.Theme.MutedText
    end
end

function Window:GetScripts()
    local records = {}
    for _, record in ipairs(self.CustomScripts or {}) do
        table.insert(records, { Id = record.Id, Name = record.Name, Source = record.Source })
    end
    return records
end

function Window:GetScript(idOrName)
    if type(idOrName) == "table" then
        return idOrName.Window == self and self._scriptsById[idOrName.Id] or nil
    end
    if type(idOrName) ~= "string" then return nil end
    if self._scriptsById[idOrName] then return self._scriptsById[idOrName] end
    local name = idOrName:lower()
    if name:sub(-4) ~= ".lua" then name = name .. ".lua" end
    for _, record in ipairs(self.CustomScripts) do
        if record.Name:lower() == name then return record end
    end
    return nil
end

function Window:ExportScripts()
    return HttpService:JSONEncode({ Version = 1, Scripts = self:GetScripts(),
        ActiveScriptId = self.ActiveScript and self.ActiveScript.Id or nil })
end

function Window:SaveScripts()
    if not self.CustomScripts then return false, "Explorer indisponível." end
    local snapshot = self:GetScripts()
    local ok, result
    if self._scriptStorageBlocked then
        local message = "Os scripts salvos não puderam ser carregados. As alterações ficam nesta janela."
        self:_ScriptStatus(message, true)
        return false, message
    elseif not self._scriptsDirty then
        return true
    elseif type(self.Config.SaveScripts) == "function" then
        ok, result = pcall(self.Config.SaveScripts, snapshot, self)
    elseif self._scriptStorageFile and type(readfile) == "function" and type(writefile) == "function" then
        ok, result = pcall(function() writefile(self._scriptStorageFile, self:ExportScripts()) end)
    else
        ok = true
    end
    if not ok or result == false then
        self:_ScriptStatus("Não foi possível salvar. O código continua no editor.", true)
        return false, tostring(result)
    end
    self._scriptsDirty = false
    for _, record in ipairs(self.CustomScripts) do record.Dirty = false end
    self:_RenderScriptRows()
    self:_ScriptStatus(self._hasScriptStorage and "Salvo" or "Salvo nesta janela")
    safeCallback(self.Config.OnScriptsChanged, snapshot, self)
    return true
end

function Window:_ScriptsChanged()
    self._scriptsDirty = true
    self._scriptSaveRevision = (self._scriptSaveRevision or 0) + 1
    self:_RenderScriptRows()
    if self._importingScripts or self._loadingScripts then return end
    local revision = self._scriptSaveRevision
    self:_ScriptStatus("Salvando...")
    task.delay(0.45, function()
        if not self.Destroyed and self._scriptSaveRevision == revision then self:SaveScripts() end
    end)
end

function Window:CreateScript(config)
    if self.Destroyed or not self.ScriptExplorer then return nil, "Explorer indisponível." end
    config = type(config) == "string" and { Name = config } or (config or {})
    if type(config) ~= "table" then return nil, "Configuração inválida." end
    if #self.CustomScripts >= (self.Config.MaxCustomScripts or 100) then return nil, "O explorer está cheio." end
    local name, err = ScriptName(self, config.Name or config.Title)
    if not name then return nil, err end
    local source = config.Source
    if source == nil then source = self.Config.DefaultScriptSource or '-- Seu script começa aqui.\n\nprint("Hello, world!")\n' end
    if type(source) ~= "string" then return nil, "O código precisa ser texto." end
    source = NormalizeSource(source)
    if #source > (self.Config.MaxScriptBytes or 60000) then return nil, "Este script é grande demais para o editor." end
    self._scriptCounter = self._scriptCounter + 1
    local id = "script_" .. tostring(self._scriptCounter)
    if self._importingScripts and type(config.Id) == "string" and #config.Id <= 128
        and config.Id:match("^[%w_-]+$") and not self._scriptsById[config.Id] then
        id = config.Id
    end
    while self._scriptsById[id] do
        self._scriptCounter = self._scriptCounter + 1
        id = "script_" .. tostring(self._scriptCounter)
    end
    local record = { __type = "CustomScript", Id = id, Name = name, Source = source, Window = self, Dirty = true }
    function record:Get() return self.Source end
    function record:Set(text) return self.Window:SetScriptSource(self.Id, text) end
    function record:Open() return self.Window:OpenScript(self.Id) end
    function record:Rename(newName) return self.Window:RenameScript(self.Id, newName) end
    function record:Delete() return self.Window:DeleteScript(self.Id) end
    function record:Run() return self.Window:RunScript(self.Id) end
    table.insert(self.CustomScripts, record)
    self._scriptsById[id] = record
    self:_CreateScriptRow(record)
    self:_ScriptsChanged()
    if config.Open ~= false then self:OpenScript(id) end
    return record
end

function Window:RenameScript(idOrName, newName)
    local record = self:GetScript(idOrName)
    if not record then return nil, "Script não encontrado." end
    local name, err = ScriptName(self, newName, record.Id)
    if not name then return nil, err end
    record.Name = name
    if record.UIElements then record.UIElements.Label.Text = name end
    if self.ActiveScript == record then self.ScriptEditorElements.Title.Text = name end
    record.Dirty = true
    self:_ScriptsChanged()
    return record
end

function Window:SetScriptSource(idOrName, source)
    local record = self:GetScript(idOrName)
    if not record then return nil, "Script não encontrado." end
    if type(source) ~= "string" then return nil, "O código precisa ser texto." end
    source = NormalizeSource(source)
    if #source > (self.Config.MaxScriptBytes or 60000) then return nil, "Este script é grande demais para o editor." end
    if source == record.Source then return record end
    record.Source, record.Dirty = source, true
    if self.ActiveScript == record then
        self._settingScriptText = true
        self.ScriptEditorElements.Input.Text = source
        self._settingScriptText = false
        self:_RenderScriptEditor()
    end
    self:_ScriptsChanged()
    return record
end

function Window:DeleteScript(idOrName)
    local record = self:GetScript(idOrName)
    if not record then return false, "Script não encontrado." end
    local replacement
    for i, item in ipairs(self.CustomScripts) do
        if item == record then
            table.remove(self.CustomScripts, i)
            replacement = self.CustomScripts[i] or self.CustomScripts[i - 1]
            break
        end
    end
    self._scriptsById[record.Id] = nil
    if record.UIElements then record.UIElements.Row:Destroy() end
    if self.ActiveScript == record then
        self:CloseScriptEditor()
        if replacement then self:OpenScript(replacement) end
    end
    self:_ScriptsChanged()
    return true
end

function Window:ImportScripts(payload, replaceExisting)
    if self.Destroyed or not self.ScriptExplorer then return false, "Explorer indisponível." end
    if type(payload) == "string" then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(payload) end)
        if not ok then return false, "Arquivo de scripts inválido." end
        payload = decoded
    end
    if type(payload) ~= "table" then return false, "Arquivo de scripts inválido." end
    if payload.Version ~= nil and payload.Version ~= 1 then return false, "Versão de scripts incompatível." end
    local records = payload.Scripts or payload
    if type(records) ~= "table" then return false, "Lista de scripts inválida." end
    for key in pairs(records) do
        if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #records then
            return false, "Lista de scripts inválida."
        end
    end
    local existing = replaceExisting and 0 or #self.CustomScripts
    if #records + existing > (self.Config.MaxCustomScripts or 100) then return false, "Há scripts demais neste arquivo." end
    local names, prepared = {}, {}
    if not replaceExisting then for _, record in ipairs(self.CustomScripts) do names[record.Name:lower()] = true end end
    -- Validate the whole import before touching the existing scripts.
    for _, item in ipairs(records) do
        if type(item) ~= "table" or type(item.Source) ~= "string" then return false, "Um script do arquivo é inválido." end
        local name, err = ScriptName(self, item.Name, nil, names)
        if not name then return false, err end
        local source = NormalizeSource(item.Source)
        if #source > (self.Config.MaxScriptBytes or 60000) then return false, "Um script do arquivo é grande demais." end
        names[name:lower()] = true
        table.insert(prepared, { Id = item.Id, Name = name, Source = source, Open = false })
    end
    self._importingScripts = true
    if replaceExisting then
        self:CloseScriptEditor()
        for _, record in ipairs(self.CustomScripts) do if record.UIElements then record.UIElements.Row:Destroy() end end
        self.CustomScripts, self._scriptsById = {}, {}
    end
    for _, item in ipairs(prepared) do self:CreateScript(item) end
    self._importingScripts = false
    self:_ScriptsChanged()
    return true
end

function Window:_LeaveScriptEditor()
    if not self.ActiveScript then return end
    if self.ScriptEditorElements.Input:IsFocused() then self.ScriptEditorElements.Input:ReleaseFocus() end
    self.ActiveScript = nil
    self.ScriptEditor.Visible = false
    self.ContentHost.Visible = true
    self:_RenderScriptRows()
end

function Window:CloseScriptEditor()
    if not self.ActiveScript then return self end
    if self._scriptsDirty then self:SaveScripts() end
    if self.ActiveTab then self:_setActiveTab(self.ActiveTab) else self:_LeaveScriptEditor() end
    return self
end

function Window:OpenScript(idOrName)
    local record = self:GetScript(idOrName)
    if not record or self.Destroyed then return nil, "Script não encontrado." end
    if self.ActiveDropdown then self.ActiveDropdown:Close() end
    if self.ActiveColorpicker then self.ActiveColorpicker:Close() end
    if self.ScriptEditorElements.Input:IsFocused() then self.ScriptEditorElements.Input:ReleaseFocus() end
    self._scriptsCollapsed = false
    self.ScriptExplorerElements.List.Visible = true
    self.ScriptExplorerElements.Arrow.Rotation = 0
    self.ActiveScript = record
    self.ContentHost.Visible = false
    self.ScriptEditor.Visible = true
    self._settingScriptText = true
    self.ScriptEditorElements.Input.Text = record.Source
    self._settingScriptText = false
    self.ScriptEditorElements.Title.Text = record.Name
    self.ScriptEditorElements.Scroll.CanvasPosition = Vector2.new(0, 0)
    for _, tab in ipairs(self.Tabs) do
        tab.Button.BackgroundTransparency = 1
        tab.ButtonLabel.TextColor3 = self.Theme.SubText
        if tab.ButtonIcon then tab.ButtonIcon.ImageColor3 = self.Theme.Icon end
        if tab.Accent then tab.Accent.BackgroundTransparency = 1 end
    end
    self:_RenderScriptEditor()
    self:_RenderScriptRows()
    self:_ScriptStatus(record.Dirty and "Alterações pendentes" or (self._hasScriptStorage and "Salvo" or "Salvo nesta janela"))
    task.defer(function()
        if not self.Destroyed and self.ActiveScript == record and self.Visible then
            self.ScriptEditorElements.Input:CaptureFocus()
            self.ScriptEditorElements.Input.CursorPosition = #record.Source + 1
        end
    end)
    safeCallback(self.Config.OnScriptOpened, record, self)
    return record
end

function Window:RunScript(idOrName)
    local record = self:GetScript(idOrName or self.ActiveScript)
    if not record then return false, "Script não encontrado." end
    if self.Config.AllowScriptExecution == false then return false, "Execução desativada." end
    local runner = self.Config.OnRunScript
    if type(runner) ~= "function" then
        if type(loadstring) ~= "function" then
            self:_ScriptStatus("Este ambiente não permite executar scripts.", true)
            return false, "Use OnRunScript para integrar a execução neste ambiente."
        end
        local ok, compiled, err = pcall(loadstring, record.Source, "@" .. record.Name)
        if not ok or not compiled then
            self:_ScriptStatus(tostring(err or compiled), true)
            return false, err or compiled
        end
        runner = function() return compiled() end
    end
    local source, name = record.Source, record.Name
    self:_ScriptStatus("Executando " .. name .. "...")
    task.spawn(function()
        local ok, err = pcall(runner, source, record, self)
        if not self.Destroyed and self.ActiveScript == record then
            self:_ScriptStatus(ok and ("Concluído: " .. name) or tostring(err), not ok)
        end
        if not ok then safeCallback(self.Config.OnScriptError, err, record, self) end
    end)
    return true
end

function Window:_UpdateScriptLayout()
