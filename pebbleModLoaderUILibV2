    function Window:_AutoConnectNewBlueprintNode(record, newNode, pendingEndpoint)
        if not record or not newNode or not pendingEndpoint then return false end
        local def = definition(newNode)
        if not def then return false end
        local wantInputs = pendingEndpoint.Direction == "out"
        local ports = def[wantInputs and "Inputs" or "Outputs"] or {}
        for _, p in ipairs(ports) do
            local sourceNode, sourcePort, targetNode, targetPort
            if pendingEndpoint.Direction == "out" then
                if compatible(pendingEndpoint.Port.Type, p.Type) then
                    sourceNode, sourcePort, targetNode, targetPort = pendingEndpoint.Node, pendingEndpoint.Port.Name, newNode.Id, p.Name
                end
            else
                if compatible(p.Type, pendingEndpoint.Port.Type) then
                    sourceNode, sourcePort, targetNode, targetPort = newNode.Id, p.Name, pendingEndpoint.Node, pendingEndpoint.Port.Name
                end
            end
            if sourceNode then
                local ok = self:ConnectBlueprint(record, sourceNode, sourcePort, targetNode, targetPort)
                return ok == true or ok ~= false
            end
        end
        return false
    end
