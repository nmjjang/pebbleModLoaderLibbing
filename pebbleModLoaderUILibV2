function Window:_ScriptStatus(text, danger)
    self._scriptStatusText = tostring(text or "")
    self._scriptStatusDanger = danger == true
    if self.ScriptEditorElements then
        local label = self.ScriptEditorElements.Status
        label.Text = self._scriptStatusText
        label.TextColor3 = danger and self.Theme.Danger or self.Theme.MutedText
    end
end

function Window:GetScripts()
    local records = {}
    for _, record in ipairs(self.CustomScripts or {}) do
        table.insert(records, { Id = record.Id, Name = record.Name, Source = record.Source })
    end
    return records
end

function Window:GetScript(idOrName)
    if type(idOrName) == "table" then
        return idOrName.Window == self and self._scriptsById[idOrName.Id] or nil
    end
    if type(idOrName) ~= "string" then return nil end
    if self._scriptsById[idOrName] then return self._scriptsById[idOrName] end
    local name = idOrName:lower()
    if name:sub(-4) ~= ".lua" then name = name .. ".lua" end
    for _, record in ipairs(self.CustomScripts) do
        if record.Name:lower() == name then return record end
    end
    return nil
end

function Window:ExportScripts()
    return HttpService:JSONEncode({ Version = 1, Scripts = self:GetScripts(),
        ActiveScriptId = self.ActiveScript and self.ActiveScript.Id or nil })
end

function Window:SaveScripts()
    if not self.CustomScripts then return false, "Explorer unavailable." end
    local snapshot = self:GetScripts()
    local ok, result
    if self._scriptStorageBlocked then
        local message = "Saved scripts could not be loaded. Changes will remain in this window."
        self:_ScriptStatus(message, true)
        return false, message
    elseif not self._scriptsDirty then
        return true
    elseif type(self.Config.SaveScripts) == "function" then
        ok, result = pcall(self.Config.SaveScripts, snapshot, self)
    elseif self._scriptStorageFile and type(readfile) == "function" and type(writefile) == "function" then
        ok, result = pcall(function() writefile(self._scriptStorageFile, self:ExportScripts()) end)
    else
        ok = true
    end
    if not ok or result == false then
        self:_ScriptStatus("Could not save. Your code is still in the editor.", true)
        return false, tostring(result)
    end
    self._scriptsDirty = false
    for _, record in ipairs(self.CustomScripts) do record.Dirty = false end
    self:_RenderScriptRows()
    self:_ScriptStatus(self._hasScriptStorage and "Saved" or "Saved in this window")
    safeCallback(self.Config.OnScriptsChanged, snapshot, self)
    return true
end

function Window:_ScriptsChanged()
    self._scriptsDirty = true
    self._scriptSaveRevision = (self._scriptSaveRevision or 0) + 1
    self:_RenderScriptRows()
    if self._importingScripts or self._loadingScripts then return end
    local revision = self._scriptSaveRevision
    self:_ScriptStatus("Saving...")
    task.delay(0.45, function()
        if not self.Destroyed and self._scriptSaveRevision == revision then self:SaveScripts() end
    end)
end

function Window:CreateScript(config)
    if self.Destroyed or not self.ScriptExplorer then return nil, "Explorer unavailable." end
    config = type(config) == "string" and { Name = config } or (config or {})
    if type(config) ~= "table" then return nil, "Invalid configuration." end
    if #self.CustomScripts >= (self.Config.MaxCustomScripts or 100) then return nil, "The explorer is full." end
    local name, err = ScriptName(self, config.Name or config.Title)
    if not name then return nil, err end
    local source = config.Source
    if source == nil then source = self.Config.DefaultScriptSource or '-- Your script starts here.\n\nprint("Hello, world!")\n' end
    if type(source) ~= "string" then return nil, "The code must be a string." end
    source = NormalizeSource(source)
    if #source > (self.Config.MaxScriptBytes or 60000) then return nil, "This script is too large for the editor." end
    self._scriptCounter = self._scriptCounter + 1
    local id = "script_" .. tostring(self._scriptCounter)
    if self._importingScripts and type(config.Id) == "string" and #config.Id <= 128
        and config.Id:match("^[%w_-]+$") and not self._scriptsById[config.Id] then
        id = config.Id
    end
    while self._scriptsById[id] do
        self._scriptCounter = self._scriptCounter + 1
        id = "script_" .. tostring(self._scriptCounter)
    end
    local record = { __type = "CustomScript", Id = id, Name = name, Source = source, Window = self, Dirty = true }
    function record:Get() return self.Source end
    function record:Set(text) return self.Window:SetScriptSource(self.Id, text) end
    function record:Open() return self.Window:OpenScript(self.Id) end
    function record:Rename(newName) return self.Window:RenameScript(self.Id, newName) end
    function record:Delete() return self.Window:DeleteScript(self.Id) end
    function record:Run() return self.Window:RunScript(self.Id) end
    table.insert(self.CustomScripts, record)
    self._scriptsById[id] = record
    self:_CreateScriptRow(record)
    self:_ScriptsChanged()
    if config.Open ~= false then self:OpenScript(id) end
    return record
end

function Window:RenameScript(idOrName, newName)
    local record = self:GetScript(idOrName)
    if not record then return nil, "Script not found." end
    local name, err = ScriptName(self, newName, record.Id)
    if not name then return nil, err end
    record.Name = name
    if record.UIElements then record.UIElements.Label.Text = name end
    if self.ActiveScript == record then self.ScriptEditorElements.Title.Text = name end
    record.Dirty = true
    self:_ScriptsChanged()
    return record
end

function Window:SetScriptSource(idOrName, source)
    local record = self:GetScript(idOrName)
    if not record then return nil, "Script not found." end
    if type(source) ~= "string" then return nil, "The code must be a string." end
    source = NormalizeSource(source)
    if #source > (self.Config.MaxScriptBytes or 60000) then return nil, "This script is too large for the editor." end
    if source == record.Source then return record end
    record.Source, record.Dirty = source, true
    if self.ActiveScript == record then
        self._settingScriptText = true
        self.ScriptEditorElements.Input.Text = source
        self._settingScriptText = false
        self:_RenderScriptEditor()
    end
    self:_ScriptsChanged()
    return record
end

function Window:DeleteScript(idOrName)
    local record = self:GetScript(idOrName)
    if not record then return false, "Script not found." end
    local replacement
    for i, item in ipairs(self.CustomScripts) do
        if item == record then
            table.remove(self.CustomScripts, i)
            replacement = self.CustomScripts[i] or self.CustomScripts[i - 1]
            break
        end
    end
    self._scriptsById[record.Id] = nil
    if record.UIElements then record.UIElements.Row:Destroy() end
    if self.ActiveScript == record then
        self:CloseScriptEditor()
        if replacement then self:OpenScript(replacement) end
    end
    self:_ScriptsChanged()
    return true
end

function Window:ImportScripts(payload, replaceExisting)
    if self.Destroyed or not self.ScriptExplorer then return false, "Explorer unavailable." end
    if type(payload) == "string" then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(payload) end)
        if not ok then return false, "Invalid scripts file." end
        payload = decoded
    end
    if type(payload) ~= "table" then return false, "Invalid scripts file." end
    if payload.Version ~= nil and payload.Version ~= 1 then return false, "Incompatible scripts version." end
    local records = payload.Scripts or payload
    if type(records) ~= "table" then return false, "Invalid scripts list." end
    for key in pairs(records) do
        if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #records then
            return false, "Invalid scripts list."
        end
    end
    local existing = replaceExisting and 0 or #self.CustomScripts
    if #records + existing > (self.Config.MaxCustomScripts or 100) then return false, "This file contains too many scripts." end
    local names, prepared = {}, {}
    if not replaceExisting then for _, record in ipairs(self.CustomScripts) do names[record.Name:lower()] = true end end
    -- Validate the whole import before touching the existing scripts.
    for _, item in ipairs(records) do
        if type(item) ~= "table" or type(item.Source) ~= "string" then return false, "A script in the file is invalid." end
        local name, err = ScriptName(self, item.Name, nil, names)
        if not name then return false, err end
        local source = NormalizeSource(item.Source)
        if #source > (self.Config.MaxScriptBytes or 60000) then return false, "A script in the file is too large." end
        names[name:lower()] = true
        table.insert(prepared, { Id = item.Id, Name = name, Source = source, Open = false })
    end
    self._importingScripts = true
    if replaceExisting then
        self:CloseScriptEditor()
        for _, record in ipairs(self.CustomScripts) do if record.UIElements then record.UIElements.Row:Destroy() end end
        self.CustomScripts, self._scriptsById = {}, {}
    end
    for _, item in ipairs(prepared) do self:CreateScript(item) end
    self._importingScripts = false
    self:_ScriptsChanged()
    return true
end

function Window:_LeaveScriptEditor()
    if not self.ActiveScript then return end
    self:_CloseScriptAutocomplete()
    if self.ScriptEditorElements.Input:IsFocused() then self.ScriptEditorElements.Input:ReleaseFocus() end
    self.ActiveScript = nil
    self.ScriptEditor.Visible = false
    self.ContentHost.Visible = true
    self:_RenderScriptRows()
end

function Window:CloseScriptEditor()
    if not self.ActiveScript then return self end
    if self._scriptsDirty then self:SaveScripts() end
    if self.ActiveTab then self:_setActiveTab(self.ActiveTab) else self:_LeaveScriptEditor() end
    return self
end

function Window:OpenScript(idOrName)
    if self.ActiveBlueprint then self:_LeaveBlueprintEditor() end
    self:_CloseCreationMenu()
    local record = self:GetScript(idOrName)
    if not record or self.Destroyed then return nil, "Script not found." end
    if self.ActiveDropdown then self.ActiveDropdown:Close() end
    if self.ActiveColorpicker then self.ActiveColorpicker:Close() end
    if self.ScriptEditorElements.Input:IsFocused() then self.ScriptEditorElements.Input:ReleaseFocus() end
    self._scriptsCollapsed = false
    self.ScriptExplorerElements.List.Visible = true
    self.ScriptExplorerElements.Arrow.Rotation = 0
    self.ActiveScript = record
    self.ContentHost.Visible = false
    self.ScriptEditor.Visible = true
    self._settingScriptText = true
    self.ScriptEditorElements.Input.Text = record.Source
    self._settingScriptText = false
    self.ScriptEditorElements.Title.Text = record.Name
    self.ScriptEditorElements.Scroll.CanvasPosition = Vector2.new(0, 0)
    for _, tab in ipairs(self.Tabs) do
        tab.Button.BackgroundTransparency = 1
        tab.ButtonLabel.TextColor3 = self.Theme.SubText
        if tab.ButtonIcon then tab.ButtonIcon.ImageColor3 = self.Theme.Icon end
        if tab.Accent then tab.Accent.BackgroundTransparency = 1 end
    end
    self:_RenderScriptEditor()
    self:_RenderScriptRows()
    self:_ScriptStatus(record.Dirty and "Unsaved changes" or (self._hasScriptStorage and "Saved" or "Saved in this window"))
    task.defer(function()
        if not self.Destroyed and self.ActiveScript == record and self.Visible then
            self.ScriptEditorElements.Input:CaptureFocus()
            self.ScriptEditorElements.Input.CursorPosition = #record.Source + 1
        end
    end)
    safeCallback(self.Config.OnScriptOpened, record, self)
    return record
end

function Window:RunScript(idOrName)
    local record = self:GetScript(idOrName or self.ActiveScript)
    if not record then return false, "Script not found." end
    if self.Config.AllowScriptExecution == false then return false, "Script execution disabled." end
    local runner = self.Config.OnRunScript
    if type(runner) ~= "function" then
        if type(loadstring) ~= "function" then
            self:_ScriptStatus("This environment does not support script execution.", true)
            self:Notify({ Content = "Text execution unavailable on this client. Configure OnRunScript. Blueprints use native execution.", Icon = "triangle-alert", Duration = 6 })
            return false, "Use OnRunScript to integrate script execution in this environment."
        end
        local ok, compiled, err = pcall(loadstring, record.Source, "@" .. record.Name)
        if not ok or not compiled then
            self:_ScriptStatus(tostring(err or compiled), true)
            self:Notify({ Content = "Script error: " .. tostring(err or compiled), Icon = "triangle-alert", IconColor = self.Theme.Danger, Duration = 6 })
            return false, err or compiled
        end
        runner = function() return compiled() end
    end
    local source, name = record.Source, record.Name
    self:_ScriptStatus("Running " .. name .. "...")
    task.spawn(function()
        local ok, err = pcall(runner, source, record, self)
        if not self.Destroyed and self.ActiveScript == record then
            self:_ScriptStatus(ok and ("Completed: " .. name) or tostring(err), not ok)
        end
        if not self.Destroyed then
            self:Notify({ Content = ok and ("Script executed: " .. name) or ("Script error: " .. tostring(err)), Icon = ok and "check" or "triangle-alert", IconColor = ok and self.Theme.Success or self.Theme.Danger, Duration = ok and 3 or 6 })
        end
        if not ok then safeCallback(self.Config.OnScriptError, err, record, self) end
    end)
    return true
end

function Window:_UpdateScriptLayout()
    if not self.ScriptExplorer or self.Destroyed then return end
    local desired = self.Config.ScriptExplorerWidth or 192
    local available = self.Main.AbsoluteSize.X - self.SidebarWidth - 336
    local width = math.floor(clamp(available, math.min(148, desired), desired))
    self._scriptRightInset = width + 12
    self.ScriptExplorer.Size = UDim2.new(0, width, 1, -16)
    self.ScriptExplorer.Position = UDim2.new(1, -8, 0, 8)
    local side, top = self.SidebarWidth, self.TopbarHeight
    self.Topbar.Position = UDim2.fromOffset(side + 12, 6)
    self.Topbar.Size = UDim2.new(1, -(side + 24 + self._scriptRightInset), 0, top)
    self.ContentHost.Position = UDim2.fromOffset(side + 12, top + 10)
    self.ContentHost.Size = UDim2.new(1, -(side + 24 + self._scriptRightInset), 1, -(top + 22))
    self.ScriptEditor.Position = self.ContentHost.Position
    self.ScriptEditor.Size = self.ContentHost.Size
    self.CloseButton.Position = UDim2.new(1, -(12 + self._scriptRightInset), 0, 13)
    if self._PositionGlobalSearch then self._PositionGlobalSearch() end
    if self.BlueprintEditor then
        self.BlueprintEditor.Position = self.ContentHost.Position
        self.BlueprintEditor.Size = self.ContentHost.Size
        self:_LayoutBlueprintExplorer()
    end
end

function Window:_CreateScriptRow(record)
    local row = New("TextButton", {
        Name = record.Id, Text = "", AutoButtonColor = false, BorderSizePixel = 0,
        BackgroundColor3 = self.Theme.SurfaceHover, BackgroundTransparency = 1,
        Size = UDim2.new(1, -4, 0, 29), LayoutOrder = #self.CustomScripts,
        ZIndex = 12, Parent = self.ScriptExplorerElements.List,
    })
    Corner(row, self.Theme.ControlRadius)
    local icon = CreateIcon("file-code", 14, self.Theme.Icon, 14)
    icon.Position = UDim2.fromOffset(19, 7)
    icon.Parent = row
    local marker = New("Frame", {
        Name = "Selected", BackgroundColor3 = self.Theme.Accent, BorderSizePixel = 0,
        Position = UDim2.fromOffset(7, 9), Size = UDim2.fromOffset(2, 11), Visible = false,
        ZIndex = 14, Parent = row,
    })
    Corner(marker, 2)
    local label = New("TextLabel", {
        BackgroundTransparency = 1, Text = record.Name, Font = self.Theme.FontMedium,
        TextColor3 = self.Theme.SubText, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(40, 0),
        Size = UDim2.new(1, -54, 1, 0), ZIndex = 14, Parent = row,
    })
    local dirty = New("Frame", {
        Name = "Unsaved", BackgroundColor3 = self.Theme.Accent, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.fromOffset(4, 4), Visible = false, ZIndex = 14, Parent = row,
    })
    Corner(dirty, 99)
    BindTheme(self, label, "Font", "FontMedium")
    BindTheme(self, marker, "BackgroundColor3", "Accent")
    BindTheme(self, dirty, "BackgroundColor3", "Accent")
    record.UIElements = { Row = row, Label = label, Icon = icon, Marker = marker, Dirty = dirty }
    row.MouseEnter:Connect(function()
        if self.ActiveScript ~= record then HoverTween(row, 0.15, { BackgroundTransparency = 0.5 }) end
    end)
    row.MouseLeave:Connect(function()
        if self.ActiveScript ~= record then HoverTween(row, 0.18, { BackgroundTransparency = 1 }) end
    end)
    row.MouseButton1Click:Connect(function() self:OpenScript(record) end)
end

function Window:_RenderScriptRows()
    if not self.ScriptExplorerElements then return end
    for i, record in ipairs(self.CustomScripts) do
        local ui, selected = record.UIElements, self.ActiveScript == record
        if ui then
            ui.Row.LayoutOrder = i
            ui.Row.BackgroundColor3 = self.Theme.SurfaceHover
            ui.Row.BackgroundTransparency = selected and 0 or 1
            ui.Label.Text = record.Name
            ui.Label.TextColor3 = selected and self.Theme.Text or self.Theme.SubText
            ui.Icon.ImageColor3 = selected and self.Theme.IconSelected or self.Theme.Icon
            ui.Marker.Visible = selected
            ui.Dirty.Visible = record.Dirty == true
        end
    end
    local count = #self.CustomScripts
    self.ScriptExplorerElements.Count.Text = tostring(count) .. (count == 1 and " script" or " scripts")
    self.ScriptExplorerElements.Empty.Visible = count == 0 and not self._scriptsCollapsed
    self.ScriptExplorerElements.Storage.Text = self._hasScriptStorage
        and (type(self.Config.SaveScripts) == "function" and "Saved" or "Local") or "Memory"
    if self.BlueprintExplorerUI then self:_LayoutBlueprintExplorer() end
end

function Window:_EditorMeasure(text)
    return TextService:GetTextSize(text, 13, Enum.Font.Code, Vector2.new(100000, 100000)).X
end

function Window:_RenderScriptEditor()
    local ui = self.ScriptEditorElements
    if not ui or not self.ActiveScript then return end
    local source, lines, numbers, maxWidth, start = self.ActiveScript.Source, {}, {}, 0, 1
    for line in (source .. "\n"):gmatch("(.-)\n") do
        table.insert(lines, { Text = line, Start = start })
        table.insert(numbers, tostring(#lines))
        start = start + #line + 1
        maxWidth = math.max(maxWidth, self:_EditorMeasure(line))
    end
    self._editorLines = lines
    local width = math.max(ui.Scroll.AbsoluteSize.X, maxWidth + 36, 120)
    local height = math.max(ui.Scroll.AbsoluteSize.Y, #lines * 20 + 28, 60)
    self._editorCanvasWidth, self._editorCanvasHeight = width, height
    ui.Scroll.CanvasSize = UDim2.fromOffset(width, height)
    ui.Input.Size = UDim2.fromOffset(width - 20, height - 20)
    ui.Highlight.Size = ui.Input.Size
    ui.Numbers.Text = table.concat(numbers, "\n")
    ui.Numbers.Size = UDim2.new(1, -12, 0, height)
    local highlighted = HighlightLua(source, self.Theme)
    self._editorHasHighlight = highlighted ~= nil
    ui.Highlight.Text = highlighted or ""
    ui.Input.TextTransparency = highlighted and 1 or 0
    ui.Highlight.TextColor3 = self.Theme.Text
    ui.Input.TextColor3 = self.Theme.Text
    ui.Caret.BackgroundColor3 = self.Theme.Accent
    ui.ActiveLine.BackgroundColor3 = self.Theme.SurfaceHover
    ui.LineCount.Text = "Lua · " .. tostring(#lines) .. (#lines == 1 and " line" or " lines")
    self:_UpdateEditorCursor(false)
end

function Window:_EditorLineAt(bytePosition)
    local lines = self._editorLines or { { Start = 1, Text = "" } }
    local low, high = 1, #lines
    while low < high do
        local middle = math.floor((low + high + 1) / 2)
        if lines[middle].Start <= bytePosition then low = middle else high = middle - 1 end
    end
    return low, lines[low]
end


