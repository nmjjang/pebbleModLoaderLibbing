function Window:Notify(config)
    config = config or {}
    local theme = self.Theme
    local message = tostring(config.Content or config.Text or config.Title or "Notification")
    local textSize = config.TextSize or 12

    local bounds = TextService:GetTextSize(message, textSize, theme.Font,
        Vector2.new(config.MaxWidth or 500, 1000))

    local width = math.clamp(bounds.X + 14, 70, config.MaxWidth or 500)
    local height = math.max(23, bounds.Y + 8)

    local holder = New("Frame", {
        Name = "Notification",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(width, height),
        LayoutOrder = #self.Notifications + 1,
        ClipsDescendants = false,
        ZIndex = 201,
        Parent = self.NotificationHolder,
    })

    local card = New("Frame", {
        Name = "Card",
        Position = UDim2.fromOffset(-(width + 14), 0),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = config.BackgroundColor or theme.Popup,
        BackgroundTransparency = config.BackgroundTransparency or 0.08,
        BorderSizePixel = 0,
        ZIndex = 202,
        Parent = holder,
    })
    Corner(card, config.Corner or 6)
    local border = Stroke(card, config.BorderColor or theme.Border, 1, 0)

    local label = New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(7, 0),
        Size = UDim2.new(1, -14, 1, 0),
        Font = theme.Font,
        Text = message,
        TextColor3 = config.TextColor or theme.Text,
        TextSize = textSize,
        TextWrapped = config.TextWrapped or false,
        TextXAlignment = config.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 203,
        Parent = card,
    })

    local obj = { __type = "Notification", UI = holder, Card = card, Label = label, Closed = false }

    function obj:Close()
        if self.Closed then return end
        self.Closed = true
        Tween(card, 0.12, {
            Position = UDim2.fromOffset(-(width + 14), 0),
            BackgroundTransparency = 1,
        })
        Tween(label, 0.12, { TextTransparency = 1 })
        Tween(border, 0.12, { Transparency = 1 })
        task.delay(0.15, function() if holder then holder:Destroy() end end)
    end

    table.insert(self.Notifications, obj)
    task.defer(function()
        Tween(card, 0.12, { Position = UDim2.fromOffset(0, 0) })
    end)

    if config.Duration ~= false then
        task.delay(config.Duration or 2.5, function()
            if not obj.Closed then obj:Close() end
        end)
    end
    return obj
end

