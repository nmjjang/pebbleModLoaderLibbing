-- ============ ANIMATION HELPERS ============

local EASE_OUT    = Enum.EasingStyle.Quint
local EASE_SOFT   = Enum.EasingStyle.Quart
local EASE_SETTLE = Enum.EasingStyle.Quart

local function Tween(obj, duration, props, style, direction)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration or 0.28,
            style or EASE_OUT,
            direction or Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function HoverTween(obj, duration, props)
    return Tween(obj, duration or 0.22, props, EASE_SOFT, Enum.EasingDirection.Out)
end

local function SettleTween(obj, props)
    return Tween(obj, 0.32, props, EASE_SETTLE, Enum.EasingDirection.Out)
end

-- ============ SUBTLE MOTION HELPERS ============
-- Centralized micro-interactions used across the whole library.
local function EnsureScale(obj)
    local scale = obj:FindFirstChildOfClass("UIScale")
    if not scale then
        scale = New("UIScale", { Scale = 1, Parent = obj })
    end
    return scale
end

local function PopIn(obj, delayTime)
    local scale = EnsureScale(obj)
    scale.Scale = 0.992
    task.delay(delayTime or 0, function()
        if not obj or not obj.Parent then return end
        Tween(scale, 0.22, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
    end)
end

local function HoverScale(obj, overScale)
    local scale = EnsureScale(obj)
    Tween(scale, 0.18, { Scale = overScale or 1.003 }, EASE_SOFT, Enum.EasingDirection.Out)
end

local function RestScale(obj)
    local scale = EnsureScale(obj)
    Tween(scale, 0.22, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
end

local function PressScale(obj)
    local scale = EnsureScale(obj)
    Tween(scale, 0.09, { Scale = 0.99 }, EASE_SOFT, Enum.EasingDirection.Out)
end

local function ReleaseScale(obj)
    local scale = EnsureScale(obj)
    Tween(scale, 0.18, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
end

local function Ripple(button, inputPosition, color)
    if not button or not button.Parent then return end
    button.ClipsDescendants = true
    local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
    local pos = inputPosition
    local x = button.AbsoluteSize.X / 2
    local y = button.AbsoluteSize.Y / 2
    if pos then
        x = pos.X - button.AbsolutePosition.X
        y = pos.Y - button.AbsolutePosition.Y
    end

    local ripple = New("Frame", {
        Name = "Ripple",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = color or Color3.new(1, 1, 1),
        BackgroundTransparency = 0.72,
        BorderSizePixel = 0,
        ZIndex = button.ZIndex + 10,
        Parent = button,
    })
    Corner(ripple, 999)
    Tween(ripple, 0.36, {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
    }, EASE_SOFT, Enum.EasingDirection.Out)
    task.delay(0.4, function()
        if ripple then ripple:Destroy() end
    end)
end

local function FineStroke(parent, color, transparency)
    return Stroke(parent, color, 1, transparency == nil and 0.2 or transparency)
end

