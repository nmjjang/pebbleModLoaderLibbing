        PaddingBottom = config.PaddingBottom or 8,
        Order = 0,
    }, Section)

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        section:_recalculateHeight()
    end)

    section:_recalculateHeight()
    PopIn(frame, math.min(0.03 * frame.LayoutOrder, 0.18))
    table.insert(self.Sections, section)
    return section
