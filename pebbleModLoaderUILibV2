        task.wait(0.12)
        local stepTime = math.min(0.075, 0.62 / math.max(#glyphs, 1))
        for _, glyph in ipairs(glyphs) do
            if not cover.Parent then return end
            Tween(glyph, 0.25, { TextTransparency = 0 }, EASE_SOFT)
            task.wait(stepTime)
        end
        task.wait(0.14)
        if not cover.Parent then return end
        Tween(track, 0.28, { BackgroundTransparency = 0 }, EASE_SOFT)
        task.wait(0.12)
        local progress = Tween(fill, duration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Sine)
        progress.Completed:Wait()
        if not cover.Parent then return end
        task.wait(0.12)
        -- O conteudo principal so pode ser renderizado a partir daqui.
        local mainScale = EnsureScale(main)
        mainScale.Scale = 0.985
        main.Visible = true
        Tween(mainScale, 0.65, { Scale = 1 }, EASE_SOFT)
        local fade = Tween(cover, 0.58, { GroupTransparency = 1 }, EASE_SOFT)
        fade.Completed:Wait()
        if cover.Parent then cover:Destroy() end
        if window.LoadingOverlay == cover then window.LoadingOverlay = nil end
        safeCallback(config.OnLoaded, window)
    end)
end

function PebbleUI:CreateWindow(config)
