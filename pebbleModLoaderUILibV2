function Window:_CloseScriptAutocomplete()
    local ui = self.ScriptEditorElements
    if ui and ui.Completion then ui.Completion.Visible = false end
    self._scriptCompletionItems = nil
    self._scriptCompletionIndex = nil
end

function Window:_RefreshScriptAutocomplete()
    local ui, record = self.ScriptEditorElements, self.ActiveScript
    if not ui or not ui.Completion or not record or not ui.Input:IsFocused() or not self.ScriptEditor.Visible then
        self:_CloseScriptAutocomplete(); return
    end
    local source, cursor = record.Source, ui.Input.CursorPosition
    if cursor < 1 or cursor > #source + 1 then self:_CloseScriptAutocomplete(); return end
    if ui.Input.SelectionStart > 0 and ui.Input.SelectionStart ~= cursor then self:_CloseScriptAutocomplete(); return end
    local before = source:sub(1, cursor - 1)
    local prefix = before:match("([%a_][%w_]*)$")
    if not prefix or #prefix < 1 then self:_CloseScriptAutocomplete(); return end
    local startsAt = cursor - #prefix
    local marker = before:sub(startsAt - 1, startsAt - 1)
    local serviceMode = before:match("GetService%s*%(%s*\"[%w_]*$") ~= nil or before:match("GetService%s*%(%s*'[%w_]*$") ~= nil
    local candidates = serviceMode and SCRIPT_SERVICES or (marker == "." or marker == ":") and SCRIPT_MEMBER_WORDS or SCRIPT_COMPLETION_WORDS
    local seen, matches = {}, {}
    local lowerPrefix = prefix:lower()
    local function add(word)
        if word ~= prefix and #word > #prefix and word:sub(1,#prefix):lower() == lowerPrefix and not seen[word] then
            seen[word] = true
            table.insert(matches, word)
        end
    end
    for _, word in ipairs(candidates) do add(word) end
    if not serviceMode and marker ~= "." and marker ~= ":" then
        local scanned = 0
        for word in source:gmatch("[%a_][%w_]*") do
            add(word)
            scanned = scanned + 1
            if scanned > 3500 then break end
        end
    end
    table.sort(matches, function(a,b) return a:lower() < b:lower() end)
    while #matches > 8 do table.remove(matches) end
    if #matches == 0 then self:_CloseScriptAutocomplete(); return end
    local lineIdx, line = self:_EditorLineAt(cursor)
    local beforeWord = line.Text:sub(1, startsAt - line.Start)
    local x = ui.Scroll.AbsolutePosition.X + 10 + self:_EditorMeasure(beforeWord) - ui.Scroll.CanvasPosition.X
    local y = ui.Scroll.AbsolutePosition.Y + 12 + lineIdx * 20 - ui.Scroll.CanvasPosition.Y
    local parentPos, parentSize = self.ScriptEditor.AbsolutePosition, self.ScriptEditor.AbsoluteSize
    local width, height = 242, #matches * 25 + 8
    x = math.clamp(x - parentPos.X, 48, math.max(48,parentSize.X - width - 6))
    y = y - parentPos.Y
    if y + height > parentSize.Y - 27 then y = math.max(40, y - height - 24) end
    ui.Completion.Position = UDim2.fromOffset(x,y)
    ui.Completion.Size = UDim2.fromOffset(width,height)
    self._scriptCompletionItems = matches
    self._scriptCompletionStart = startsAt
    self._scriptCompletionCursor = cursor
    local previousWord = self._scriptCompletionItems and self._scriptCompletionItems[self._scriptCompletionIndex or 1]
    local chosen = 1
    if previousWord then
        for i, suggestion in ipairs(matches) do
            if suggestion == previousWord then chosen = i; break end
        end
    end
    self._scriptCompletionIndex = chosen
    for i, row in ipairs(ui.CompletionRows) do
        local word = matches[i]
        row.Button.Visible = word ~= nil
        if word then
            row.Label.Text = word
            row.Button.BackgroundTransparency = i == chosen and 0.15 or 1
        end
    end
    ui.Completion.Visible = true
end

function Window:_ChooseScriptAutocomplete(index)
    local ui, record = self.ScriptEditorElements, self.ActiveScript
    local choices = self._scriptCompletionItems
    if not ui or not record or not choices then return false end
    local word = choices[index or self._scriptCompletionIndex or 1]
    if not word then return false end
    local cursor = ui.Input.CursorPosition
    local start = self._scriptCompletionStart
    if not start or cursor ~= self._scriptCompletionCursor then self:_CloseScriptAutocomplete(); return false end
    local source = record.Source
    local newSource = source:sub(1,start-1) .. word .. source:sub(cursor)
    if #newSource > (self.Config.MaxScriptBytes or 60000) then return false end
    self:_CloseScriptAutocomplete()
    self._scriptCompletionRefreshLocked = true
    self._settingScriptText = true
    ui.Input.Text = newSource
    self._settingScriptText = false
    record.Source, record.Dirty = newSource, true
    self:_RenderScriptEditor()
    self:_ScriptsChanged()
    safeCallback(self.Config.OnScriptChanged,record,self)
    ui.Input:CaptureFocus()
    ui.Input.CursorPosition = start + #word
    ui.Input.SelectionStart = -1
    self:_UpdateEditorCursor(true)
    self._scriptCompletionRefreshLocked = false
    return true
end

function Window:_MoveScriptAutocomplete(step)
    local ui = self.ScriptEditorElements
    local items = self._scriptCompletionItems
    if not ui or not items then return end
    self._scriptCompletionIndex = ((self._scriptCompletionIndex or 1) - 1 + step) % #items + 1
    for i,row in ipairs(ui.CompletionRows) do
        row.Button.BackgroundTransparency = i == self._scriptCompletionIndex and 0.15 or 1
    end
end

function Window:_UpdateEditorCursor(reveal)
    local ui = self.ScriptEditorElements
    if not ui or not self.ActiveScript or self._settingScriptText then return end
    local source = self.ActiveScript.Source
    local position = clamp(ui.Input.CursorPosition > 0 and ui.Input.CursorPosition or 1, 1, #source + 1)
    local lineIndex, line = self:_EditorLineAt(position)
    local prefix = line.Text:sub(1, position - line.Start)
    local x, y = 10 + self:_EditorMeasure(prefix), 10 + (lineIndex - 1) * 20
    local focused = ui.Input:IsFocused() and self.Visible and self.ScriptEditor.Visible
    self._scriptCaretTimestamp = os.clock()
    ui.Caret.Position = UDim2.fromOffset(x, y + 1)
    ui.Caret.Visible = focused and self._editorHasHighlight
    ui.ActiveLine.Position = UDim2.fromOffset(0, y)
    ui.ActiveLine.Size = UDim2.fromOffset(self._editorCanvasWidth or 120, 20)
    ui.Numbers.Position = UDim2.fromOffset(0, 10 - ui.Scroll.CanvasPosition.Y)
    local length = utf8.len(prefix) or #prefix
    ui.Cursor.Text = "Ln " .. tostring(lineIndex) .. ", Col " .. tostring(length + 1)

    local selection = ui.Input.SelectionStart
    local used = 0
    if focused and self._editorHasHighlight and selection and selection > 0 and selection ~= position then
        local first, last = math.min(position, selection), math.max(position, selection)
        local firstLine = self:_EditorLineAt(first)
        local lastLine = self:_EditorLineAt(math.max(first, last - 1))
        local visibleFirst = math.max(1, math.floor(ui.Scroll.CanvasPosition.Y / 20) - 1)
        local visibleLast = math.min(#self._editorLines, visibleFirst + math.ceil(ui.Scroll.AbsoluteSize.Y / 20) + 4)
        for index = math.max(firstLine, visibleFirst), math.min(lastLine, visibleLast) do
            local selectedLine = self._editorLines[index]
            local startByte = clamp(first - selectedLine.Start, 0, #selectedLine.Text)
            local endByte = clamp(last - selectedLine.Start, 0, #selectedLine.Text)
            local startX = self:_EditorMeasure(selectedLine.Text:sub(1, startByte))
            local endX = self:_EditorMeasure(selectedLine.Text:sub(1, endByte))
            if last > selectedLine.Start + #selectedLine.Text then endX = endX + self:_EditorMeasure(" ") end
            used = used + 1
            local rect = self._scriptSelectionRects[used]
            if not rect then
                rect = New("Frame", { Name = "Selection", BorderSizePixel = 0,
                    BackgroundTransparency = 0.55, ZIndex = 23, Parent = ui.Scroll })
                self._scriptSelectionRects[used] = rect
            end
            rect.BackgroundColor3 = self.Theme.SyntaxSelection
            rect.Position = UDim2.fromOffset(10 + startX, 10 + (index - 1) * 20)
            rect.Size = UDim2.fromOffset(math.max(2, endX - startX), 20)
            rect.Visible = true
        end
    end
    for i = used + 1, #self._scriptSelectionRects do self._scriptSelectionRects[i].Visible = false end
    if reveal and focused then
        local canvas, viewport = ui.Scroll.CanvasPosition, ui.Scroll.AbsoluteSize
        local newX, newY = canvas.X, canvas.Y
        if x < canvas.X + 10 then newX = math.max(0, x - 10)
        elseif x + 12 > canvas.X + viewport.X then newX = x + 24 - viewport.X end
        if y < canvas.Y + 5 then newY = math.max(0, y - 5)
        elseif y + 24 > canvas.Y + viewport.Y then newY = y + 32 - viewport.Y end
        newX = clamp(newX, 0, math.max(0, self._editorCanvasWidth - viewport.X))
        newY = clamp(newY, 0, math.max(0, self._editorCanvasHeight - viewport.Y))
        if newX ~= canvas.X or newY ~= canvas.Y then ui.Scroll.CanvasPosition = Vector2.new(newX, newY) end
    end
    if self._scriptCompletionRefreshLocked ~= true then self:_RefreshScriptAutocomplete() end
end

function Window:_HandleScriptTextChanged()
    if self._settingScriptText or not self.ActiveScript then return end
    local ui, record = self.ScriptEditorElements, self.ActiveScript
    local source, oldSource = NormalizeSource(ui.Input.Text), record.Source
    if source == oldSource then return end
    if #source > (self.Config.MaxScriptBytes or 60000) then
        self._settingScriptText = true
        ui.Input.Text = oldSource
        self._settingScriptText = false
        self:_ScriptStatus("This script reached the editor size limit.", true)
        return
    end
    local correctedPosition
    if self.Config.ScriptAutoIndent ~= false and #source == #oldSource + 1 then
        local prefix = 0
        while prefix < #oldSource and source:sub(prefix + 1, prefix + 1) == oldSource:sub(prefix + 1, prefix + 1) do prefix = prefix + 1 end
        if source:sub(prefix + 1, prefix + 1) == "\n" and source:sub(prefix + 2) == oldSource:sub(prefix + 1) then
            local previousLine = source:sub(1, prefix):match("([^\n]*)$") or ""
            local indent = previousLine:match("^[ \t]*") or ""
            local statement = previousLine:gsub("%-%-.*$", ""):match("^%s*(.-)%s*$")
            if statement:match("%f[%w]then$") or statement:match("%f[%w]do$")
                or statement:match("%f[%w]repeat$") or statement:match("function[^(]*%b()$")
                or statement:match("{$") then indent = indent .. "    " end
            if #indent > 0 and #source + #indent <= (self.Config.MaxScriptBytes or 60000) then
                source = source:sub(1, prefix + 1) .. indent .. source:sub(prefix + 2)
                correctedPosition = prefix + 2 + #indent
            end
        end
    end
    record.Source, record.Dirty = source, true
    if source ~= ui.Input.Text then
        self._settingScriptText = true
        ui.Input.Text = source
        self._settingScriptText = false
    end
    self:_RenderScriptEditor()
    self:_ScriptsChanged()
    if correctedPosition then
        task.defer(function()
            if not self.Destroyed and self.ActiveScript == record then
                ui.Input.CursorPosition = correctedPosition
                ui.Input.SelectionStart = -1
                self:_UpdateEditorCursor(true)
            end
        end)
    end
    safeCallback(self.Config.OnScriptChanged, record, self)
end

function Window:InsertScriptText(text)
    if not self.ActiveScript or type(text) ~= "string" then return false end
    local ui, source = self.ScriptEditorElements, self.ActiveScript.Source
    local cursor = ui.Input.CursorPosition > 0 and ui.Input.CursorPosition or (#source + 1)
    local selection = ui.Input.SelectionStart > 0 and ui.Input.SelectionStart or cursor
    local first, last = math.min(cursor, selection), math.max(cursor, selection)
    local result = source:sub(1, first - 1) .. text .. source:sub(last)
    local record, err = self:SetScriptSource(self.ActiveScript, result)
    if not record then self:_ScriptStatus(err, true); return false end
    ui.Input:CaptureFocus()
    ui.Input.SelectionStart = -1
    ui.Input.CursorPosition = first + #text
