    local foundItems = {}
    local selectedIndex = 1
    local searchClosing = false
    local function clearResults()
        for _, child in ipairs(searchResults:GetChildren()) do
            if child:IsA("GuiButton") then child:Destroy() end
        end
        foundItems = {}
        searchResults.Visible = false
    end
    local function visitItem(item)
        if not item then return end
        searchClosing = true
        clearResults()
        searchInput.Text = ""
        searchInput:ReleaseFocus()
        searchClosing = false
        self:_setActiveTab(item.Tab)
        if item.Section then
            local scroll = item.Section.Side == "Right" and item.Tab.RightScroll or item.Tab.LeftScroll
            task.defer(function()
                if self.Destroyed or not scroll.Parent or not item.Target.Parent then return end
                local top = item.Target.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y
                local target = math.max(0, top - 12)
                local limit = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)
                Tween(scroll, 0.28, { CanvasPosition = Vector2.new(0, math.min(target, limit)) })
                local original = item.Target.BackgroundTransparency
                if item.Target:IsA("GuiObject") then
                    item.Target.BackgroundTransparency = math.min(original, 0.55)
                    task.delay(0.7, function()
                        if item.Target.Parent then Tween(item.Target, 0.3, {BackgroundTransparency = original}) end
                    end)
                end
            end)
        end
    end
    local function rebuildSearch()
        clearResults()
        if searchClosing then return end
        local query = string.lower((searchInput.Text or ""):match("^%s*(.-)%s*$"))
        if query == "" then return end
        for _, tab in ipairs(self.Tabs) do
            local tabTitle = tostring(tab.Title or "Tab")
            local tabMatch = string.find(string.lower(tabTitle), query, 1, true) ~= nil
            if tabMatch then
                table.insert(foundItems, { Tab = tab, Target = tab.Button, Label = tabTitle, Path = "TAB" })
            end
            for _, section in ipairs(tab.Sections) do
                local secTitle = section.Title and section.Title.Text or section.Frame.Name
                local secMatch = string.find(string.lower(secTitle), query, 1, true) ~= nil
                if secMatch then
                    table.insert(foundItems, { Tab = tab, Section = section, Target = section.Frame,
                        Label = secTitle, Path = tabTitle .. "  /  SECTION" })
                end
                for _, row in ipairs(section.Content:GetChildren()) do
                    if row:IsA("GuiObject") and row.LayoutOrder > 0 and row.Name ~= "Space" and row.Name ~= "Divider" then
                        local label = row.Name
                        if string.find(string.lower(label), query, 1, true) then
                            table.insert(foundItems, { Tab = tab, Section = section, Target = row,
                                Label = label, Path = tabTitle .. "  /  " .. secTitle })
                        end
                    end
                end
            end
        end
        if #foundItems == 0 then
            searchResults.Visible = false
            return
        end
        -- Bound the popup and avoid creating hundreds of UI instances for broad searches.
        while #foundItems > 40 do table.remove(foundItems) end
        selectedIndex = 1
        searchResults.Size = UDim2.fromOffset(292, math.min(310, #foundItems * 43 + 10))
        searchResults.CanvasPosition = Vector2.new(0, 0)
        searchResults.Visible = true
        for i, item in ipairs(foundItems) do
            local result = New("TextButton", {
                Name = "SearchResult", Text = "", AutoButtonColor = false,
                BackgroundColor3 = self.Theme.SurfaceHover,
                BackgroundTransparency = i == selectedIndex and 0.1 or 1,
                Size = UDim2.new(1, -3, 0, 41), LayoutOrder = i,
                BorderSizePixel = 0, ZIndex = 71, Parent = searchResults,
            })
            Corner(result, 4)
            local heading = New("TextLabel", {
                BackgroundTransparency = 1, Text = item.Label, Font = self.Theme.FontMedium,
                TextColor3 = self.Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.fromOffset(9, 3), Size = UDim2.new(1, -18, 0, 18),
                ZIndex = 72, Parent = result,
            })
            local path = New("TextLabel", {
                BackgroundTransparency = 1, Text = item.Path, Font = self.Theme.Font,
                TextColor3 = self.Theme.SubText, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.fromOffset(9, 21), Size = UDim2.new(1, -18, 0, 15),
                ZIndex = 72, Parent = result,
            })
            item.Button = result
            BindTheme(self, heading, "TextColor3", "Text")
            BindTheme(self, path, "TextColor3", "SubText")
            result.MouseButton1Click:Connect(function() visitItem(item) end)
            result.MouseEnter:Connect(function()
                selectedIndex = i
                for j, entry in ipairs(foundItems) do
                    if entry.Button and entry.Button.Parent then entry.Button.BackgroundTransparency = j == i and 0.1 or 1 end
                end
            end)
        end
    end
    searchInput:GetPropertyChangedSignal("Text"):Connect(rebuildSearch)
    searchInput.Focused:Connect(rebuildSearch)
    searchInput.FocusLost:Connect(function()
        task.delay(0.16, function()
            if searchInput.Parent and not searchInput:IsFocused() then clearResults() end
        end)
    end)
    UserInputService.InputBegan:Connect(function(input)
        if self.Destroyed or not searchResults.Visible or not searchInput:IsFocused() then return end
        if input.KeyCode == Enum.KeyCode.Down or input.KeyCode == Enum.KeyCode.Up then
            local delta = input.KeyCode == Enum.KeyCode.Down and 1 or -1
            selectedIndex = (selectedIndex - 1 + delta) % #foundItems + 1
            for i, item in ipairs(foundItems) do
                if item.Button and item.Button.Parent then item.Button.BackgroundTransparency = i == selectedIndex and 0.1 or 1 end
            end
            searchResults.CanvasPosition = Vector2.new(0, math.max(0, (selectedIndex - 6) * 43))
        elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
            visitItem(foundItems[selectedIndex])
        elseif input.KeyCode == Enum.KeyCode.Escape then
            clearResults()
            searchInput:ReleaseFocus()
        end
    end)
    -- Keep search next to Close even when the script explorer changes the right inset.
    local function positionSearch()
        if not closeBtn.Parent then return end
        local inset = self._scriptRightInset or 0
        searchBar.Position = UDim2.new(1, -(44 + inset), 0, 13)
        searchResults.Position = UDim2.new(1, -(44 + inset), 0, 41)
        local available = closeBtn.AbsolutePosition.X - (topbar.AbsolutePosition.X + 110)
        searchBar.Size = UDim2.fromOffset(math.max(100, math.min(searchWidth, available)), 24)
    end
    self._PositionGlobalSearch = positionSearch
    main:GetPropertyChangedSignal("AbsoluteSize"):Connect(positionSearch)
    task.defer(positionSearch)

    local contentHost = New("Frame", {
        Name = "ContentHost",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(sidebarWidth + 12, topHeight + 10),
        Size = UDim2.new(1, -(sidebarWidth + 24), 1, -(topHeight + 22)),
        Parent = main,
    })
    self.ContentHost = contentHost

    -- The profile card follows the same auto-fit rules as tabs, so long display names stay readable.
    self:_fitSidebarText(displayName, 12, self.Theme.FontDisplay or self.Theme.FontBold, true, 12)

    local notifHolder = New("Frame", {
        Name = "NotificationHolder",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(520, 400),
        ZIndex = 200,
        Parent = screen,
    })
    List(notifHolder, 4)
    self.NotificationHolder = notifHolder

    -- Soft launch animation for the entire window.
    main.BackgroundTransparency = math.min(1, self.BackgroundTransparency + 0.18)
    local mainScale = EnsureScale(main)
    mainScale.Scale = 0.99
    task.defer(function()
        Tween(main, 0.28, { BackgroundTransparency = self.BackgroundTransparency }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(mainScale, 0.28, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
    end)

    local toggleKey = config.ToggleKey or Defaults.ToggleKey
    local inputConn
    inputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if self.Destroyed then inputConn:Disconnect() return end
        if gp then return end
        if input.KeyCode == toggleKey then
            self:ToggleVisibility()
        end
    end)

    table.insert(self._scriptConnections, inputConn)
    if config.Draggable ~= false then
        local dragging, dragStart, startPos, dragInput

        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        topbar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        local windowDragConnection = UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
        table.insert(self._scriptConnections, windowDragConnection)
    end
    self:_CreateScriptExplorer()
    self:_CreateCustomBlueprints()
    screen.Destroying:Connect(function()
        self:_DisposeBlueprints()
        self:_DisposeScripts()
        self.Destroyed = true
    end)
    return self
end

print("[PebbleUI] Loaded v" .. PebbleUI.Version)
return PebbleUI
