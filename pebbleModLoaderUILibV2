        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        LayoutOrder = self:_nextOrder(),
        Parent = self.Content,
    })
    Corner(holder, config.Corner or theme.ControlRadius)
    Padding(holder, 10, 10, 8, 8)

    local code = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Code or config.Text or 'print("Hello")',
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 11,
        Font = Enum.Font.Code,
        TextWrapped = config.Wrap == true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = holder,
    })
    local border = FineStroke(holder, theme.Border, 0.3)
    BindTheme(self.Window, border, "Color", "Border")
    BindTheme(self.Window, holder, "BackgroundColor3", "CodeBackground", config.BackgroundColor)
    BindTheme(self.Window, code, "TextColor3", "Text", config.TextColor)
