function Window:Notify(config)
    config = config or {}
    local theme = self.Theme
    local message = tostring(config.Content or config.Text or config.Title or "Notification")
    local textSize = config.TextSize or 12

    local bounds = TextService:GetTextSize(message, textSize, theme.Font, Vector2.new(config.MaxWidth or 420, 1000))
    local width = math.clamp(bounds.X + 44, 150, config.MaxWidth or 420)
    local height = math.max(42, bounds.Y + 18)

    local holder = New("Frame", {
        Name = "Notification", BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.fromOffset(width, height), LayoutOrder = #self.Notifications + 1,
        ClipsDescendants = false, ZIndex = 201, Parent = self.NotificationHolder,
    })

    local card = New("Frame", {
        Name = "Card", Position = UDim2.fromOffset(-(width + 18), 0), Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = config.BackgroundColor or theme.Paper,
        BackgroundTransparency = config.BackgroundTransparency or 0, BorderSizePixel = 0, ZIndex = 202, Parent = holder,
    })
    Corner(card, config.Corner or 13)
    local border = CuteStroke(card, config.BorderColor or theme.Border, 0.12)

    local badge = New("Frame", {
        BackgroundColor3 = config.AccentColor or theme.SkySoft, BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 9), Size = UDim2.fromOffset(24, 24), ZIndex = 203, Parent = card,
    })
    Corner(badge, 8)
    local sparkle = CreateIcon(config.Icon or "sparkles", 13, config.IconColor or theme.Accent, 204)
    sparkle.AnchorPoint = Vector2.new(0.5,0.5); sparkle.Position = UDim2.fromScale(0.5,0.5); sparkle.Parent = badge

    local label = New("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -48, 1, 0),
        Font = theme.FontMedium, Text = message, TextColor3 = config.TextColor or theme.Text, TextSize = textSize,
        TextWrapped = config.TextWrapped ~= false, TextXAlignment = config.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 203, Parent = card,
    })

    local obj = { __type = "Notification", UI = holder, Card = card, Label = label, Closed = false }
    function obj:Close()
        if self.Closed then return end
        self.Closed = true
        Tween(card, 0.24, { Position = UDim2.fromOffset(-(width + 18), 0), BackgroundTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        Tween(label, 0.2, { TextTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        Tween(border, 0.2, { Transparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        task.delay(0.28, function() if holder then holder:Destroy() end end)
    end

    table.insert(self.Notifications, obj)
    task.defer(function()
        Tween(card, 0.3, { Position = UDim2.fromOffset(0, 0) }, EASE_BOUNCE, Enum.EasingDirection.Out)
        PopIn(badge, 0.06)
    end)

    if config.Duration ~= false then
        task.delay(config.Duration or 3, function() if not obj.Closed then obj:Close() end end)
    end
    return obj
end

function Window:Dialog(config)
    config = config or {}
    local theme = self.Theme

    local overlay = New("TextButton", {
        Name = "DialogOverlay",
        BackgroundColor3 = theme.Overlay,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 100,
        Parent = self.ScreenGui,
    })

    local dialog = New("Frame", {
        BackgroundColor3 = config.BackgroundColor or theme.Popup,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = config.Size or UDim2.fromOffset(330, 170),
        ZIndex = 101,
        Parent = overlay,
    })
    Corner(dialog, config.Corner or 18)
    CuteStroke(dialog, theme.Border, 0.12)
    Padding(dialog, 14, 14, 14, 14)

    local content = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 102,
        Parent = dialog,
    })
    List(content, 8)

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Dialog",
        TextColor3 = theme.Text,
        TextSize = 15,
        Font = theme.FontDisplay or theme.FontBold,
        Size = UDim2.new(1, 0, 0, 22),
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102,
        Parent = content,
    })

    local body = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Content or "",
        TextColor3 = theme.SubText,
        TextSize = 11,
        Font = theme.Font,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        ZIndex = 102,
        Parent = content,
    })

    local buttons = New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
        ZIndex = 102,
        Parent = content,
    })
    local bl = List(buttons, 8, Enum.FillDirection.Horizontal)
    bl.HorizontalAlignment = Enum.HorizontalAlignment.Right

    local obj = { __type = "Dialog", UIElements = { Overlay = overlay, Dialog = dialog }, Closed = false }

    function obj:Close()
        if self.Closed then return end
        self.Closed = true
        Tween(overlay, 0.22, { BackgroundTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        Tween(dialog, 0.24, {
            Size = UDim2.fromOffset((config.Size or UDim2.fromOffset(330, 170)).X.Offset - 30,
                                     (config.Size or UDim2.fromOffset(330, 170)).Y.Offset - 20),
            BackgroundTransparency = 1,
        }, EASE_SOFT, Enum.EasingDirection.In)
        task.delay(0.26, function() overlay:Destroy() end)
    end

    for _, bcfg in ipairs(config.Buttons or { { Title = "Close", Callback = function() end } }) do
        local b = New("TextButton", {
            Text = bcfg.Title or "Button",
            TextColor3 = bcfg.TextColor or theme.AccentText,
            TextSize = 11,
            Font = theme.FontMedium,
            BackgroundColor3 = bcfg.Color or theme.Accent,
            BackgroundTransparency = 0,
            Size = UDim2.fromOffset(bcfg.Width or 88, 26),
            TextXAlignment = Enum.TextXAlignment.Center,
            AutoButtonColor = false,
            ZIndex = 103,
            Parent = buttons,
        })
        Corner(b, 10)

        b.MouseEnter:Connect(function()
            HoverTween(b, 0.22, { BackgroundColor3 = theme.AccentHover })
        end)
        b.MouseLeave:Connect(function()
            HoverTween(b, 0.26, { BackgroundColor3 = bcfg.Color or theme.Accent })
        end)

        b.MouseButton1Click:Connect(function()
            safeCallback(bcfg.Callback, obj)
            if bcfg.Close ~= false then obj:Close() end
        end)
    end

    if config.CloseOnOverlay then
        overlay.MouseButton1Click:Connect(function() obj:Close() end)
    end

    task.defer(function()
        Tween(overlay, 0.25, {
            BackgroundTransparency = config.OverlayTransparency or 0.35
        }, EASE_SOFT, Enum.EasingDirection.Out)
        local baseSize = config.Size or UDim2.fromOffset(330, 170)
        dialog.Size = UDim2.fromOffset(baseSize.X.Offset - 30, baseSize.Y.Offset - 20)
        dialog.BackgroundTransparency = 0.3
        SpringTween(dialog, { Size = baseSize, BackgroundTransparency = 0 })
    end)

    return obj
end

