        if type(self.Config.LoadBlueprints)=="function" then
            local ok,result=pcall(self.Config.LoadBlueprints,self); if ok then payload=result else err=result end
        elseif self._blueprintStorageFile and type(readfile)=="function" then
            local existsOk,exists=true,true
            if type(isfile)=="function" then existsOk,exists=pcall(isfile,self._blueprintStorageFile) end
            if not existsOk then err=exists elseif exists then local ok,result=pcall(readfile,self._blueprintStorageFile); if ok then payload=result else err=result end end
        end
        if payload==nil and err==nil and self.Config.Blueprints then payload={ Version=1,Blueprints=self.Config.Blueprints } end
        if payload~=nil then local ok,result=self:ImportBlueprints(payload,true); if not ok then err=result end end
        if err then self._blueprintStorageBlocked=true; self._hasBlueprintStorage=false; self:_BlueprintNotice("Could not load blueprints: " .. tostring(err),true) end
        self._blueprintsDirty=false; self._blueprintSaveRevision=(self._blueprintSaveRevision or 0)+1
        for _,r in ipairs(self.CustomBlueprints) do r.Dirty=false end
        self:_RenderBlueprintRows()
    end
    function Window:_DisposeBlueprints()
        if self._blueprintDisposed then return end; self._blueprintDisposed=true
        if self._blueprintsDirty then self:SaveBlueprints() end
        self:_CloseCreationMenu()
        for _,r in ipairs(self.CustomBlueprints or {}) do self:StopBlueprint(r,true) end
        for _,connection in ipairs(self._blueprintConnections or {}) do connection:Disconnect() end
        self._blueprintConnections={}
    end
