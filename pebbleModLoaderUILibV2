function Section:Button(config)
    config = config or {}
    local theme = self.Window.Theme
    local h = RowHeight(config, 28)

    local btn = New("TextButton", {
        Name = config.Title or "Button",
        BackgroundColor3 = config.Color or theme.Accent,
        BorderSizePixel = 0,
        Size = config.Size or UDim2.new(1, 0, 0, h),
        LayoutOrder = self:_nextOrder(),
        Text = "",
        AutoButtonColor = false,
        ZIndex = config.ZIndex or 5,
        Parent = self.Content,
    })
    Corner(btn, config.Corner or 6)

    local iconOffset = 0
    if config.Icon then
        local icon = CreateIcon(config.Icon, config.IconSize or 13,
            config.IconColor or theme.AccentText, btn.ZIndex + 1)
        icon.AnchorPoint = Vector2.new(0, 0.5)
        icon.Position = UDim2.new(0, 10, 0.5, 0)
        icon.Parent = btn
        iconOffset = (config.IconSize or 13) + 8
    end

    local label = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Button",
        TextColor3 = config.TextColor or theme.AccentText,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.FontMedium,
        Position = UDim2.fromOffset(10 + iconOffset, 0),
        Size = UDim2.new(1, -(20 + iconOffset), 1, 0),
        TextXAlignment = config.TextXAlignment or (config.Icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center),
        ZIndex = btn.ZIndex + 2,
        Parent = btn,
    })

    local state = { Locked = config.Locked or false }
    local obj = { __type = "Button", UIElements = { Button = btn, Label = label } }

    btn.MouseEnter:Connect(function()
        if not state.Locked then
            Tween(btn, 0.08, { BackgroundColor3 = config.HoverColor or theme.AccentHover })
        end
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.08, { BackgroundColor3 = config.Color or theme.Accent })
    end)
    btn.MouseButton1Click:Connect(function()
        if state.Locked then return end
        safeCallback(config.Callback)
    end)

    AttachLockAPI(obj, config, function()
        local locked = obj.Locked
        label.TextColor3 = locked and theme.MutedText or (config.TextColor or theme.AccentText)
        btn.BackgroundTransparency = locked and 0.4 or 0
    end)

    function obj:SetText(t) label.Text = tostring(t); return self end
    return obj
end

--============================================================
-- Checkbox (com keybind "=" integrado)
--============================================================

function Section:Checkbox(config)
    config = config or {}
    local theme = self.Window.Theme

    -- Normalizar keybind
    local keyConfig = config.Keybind
    if keyConfig == nil or keyConfig == true then
        keyConfig = {}
    elseif typeof(keyConfig) == "EnumItem" or type(keyConfig) == "string" then
        keyConfig = { Value = keyConfig }
    end

    local hasKeybind = keyConfig ~= false
    local hasValueText = config.ValueText ~= nil

    local boxSize = config.BoxSize or 14
    local keyWidth = hasKeybind and ((type(keyConfig) == "table" and keyConfig.Width) or config.KeybindWidth or 34) or 0
    local keyGap = config.KeybindGap or 7
    local boxRightPadding = config.BoxRightPadding or 0

    local reserve = boxSize + boxRightPadding + 10
    if hasKeybind then reserve += keyWidth + keyGap end
    if hasValueText then reserve += (config.ValueWidth or 48) + 6 end

    config.RightReserve = config.RightReserve or reserve

    local row, title = MakeRow(self, config, config.Height or 30)

    -- Checkbox box
    local box = New("TextButton", {
        Name = "Checkbox",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -boxRightPadding, 0.5, 0),
        Size = UDim2.fromOffset(boxSize, boxSize),
        BackgroundColor3 = config.BoxColor or theme.Surface,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = config.BoxZIndex or 5,
        Parent = row,
    })
    Corner(box, config.Corner or 4)

    local boxStroke = Stroke(box,
        config.BorderColor or theme.CheckboxBorder,
        config.BorderThickness or 1.25,
        config.BorderTransparency == nil and 0 or config.BorderTransparency)

    local state = {
        Value = config.Default == true,
        Locked = config.Locked or false,
        CheckboxIcon = config.CheckboxIcon or config.CheckIcon,
    }

    local checkIcon

    local function rebuildCheckIcon()
        if checkIcon then checkIcon:Destroy(); checkIcon = nil end
        if state.CheckboxIcon == nil or state.CheckboxIcon == false or state.CheckboxIcon == "" then return end
        checkIcon = CreateIcon(state.CheckboxIcon,
            config.CheckboxIconSize or math.max(8, boxSize - 4),
            config.CheckboxIconColor or config.CheckColor or theme.AccentText,
            box.ZIndex + 1)
        checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        checkIcon.Position = UDim2.fromScale(0.5, 0.5)
        checkIcon.Parent = box
    end
    rebuildCheckIcon()

    local obj = {
        __type = "Checkbox",
        UIElements = { Row = row, Title = title, Box = box, Border = boxStroke, Check = checkIcon },
    }

    local function render(animated)
        local activeColor = config.ActiveColor or theme.Accent
        local inactiveColor = config.BoxColor or theme.Surface
        local activeBorderColor = config.ActiveBorderColor or activeColor
        local inactiveBorderColor = config.BorderColor or theme.CheckboxBorder

        if animated then
            Tween(box, 0.08, { BackgroundColor3 = state.Value and activeColor or inactiveColor })
            Tween(boxStroke, 0.08, { Color = state.Value and activeBorderColor or inactiveBorderColor })
        else
            box.BackgroundColor3 = state.Value and activeColor or inactiveColor
            boxStroke.Color = state.Value and activeBorderColor or inactiveBorderColor
        end
        if checkIcon then checkIcon.Visible = state.Value end
    end

    function obj:Set(v, fireCallback)
        state.Value = v == true
        render(true)
        if fireCallback ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end
    function obj:Toggle(fire) return self:Set(not state.Value, fire ~= false) end

    box.MouseButton1Click:Connect(function()
        if state.Locked then return end
        obj:Set(not state.Value, true)
    end)

    -- Right-side cursor (pixel distance from right edge)
    local rightCursor = boxRightPadding + boxSize + keyGap

    --========== KEYBIND ==========
    if hasKeybind then
        keyConfig = keyConfig or {}

        local display = New("TextButton", {
            Name = "CheckboxKeybind",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -rightCursor, 0.5, 0),
            Size = UDim2.fromOffset(keyWidth, keyConfig.Height or 22),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = keyConfig.EmptyText or keyConfig.Display or "=",
            TextColor3 = keyConfig.TextColor or theme.DimText,
            TextSize = keyConfig.TextSize or 11,
            Font = keyConfig.Font or theme.Font,
            TextXAlignment = keyConfig.TextXAlignment or Enum.TextXAlignment.Right,
            TextYAlignment = Enum.TextYAlignment.Center,
            AutoButtonColor = false,
            Active = true,
            Selectable = true,
            ZIndex = keyConfig.ZIndex or 8,
            Parent = row,
        })

        rightCursor += keyWidth + 6

        local initialKey = keyConfig.Value or keyConfig.Default
        local keyState = {
            Value = initialKey,
            Picking = false,
            PreviousValue = nil,
            Locked = keyConfig.Locked == true,
            Blacklist = keyConfig.Blacklist or {},
        }

        local keyObj = { __type = "Keybind", UIElements = { Display = display, Row = row } }

        local function normalizeKey(v)
            if typeof(v) == "EnumItem" then return v end
            if type(v) == "string" then return Enum.KeyCode[v] end
            return nil
        end

        keyState.Value = normalizeKey(keyState.Value)

        local function keyName(v)
            if typeof(v) == "EnumItem" then return v.Name end
            return keyConfig.EmptyText or keyConfig.Display or "="
        end

        local function renderKey()
            if keyState.Picking then
                display.Text = keyConfig.PickingText or "..."
                display.TextColor3 = keyConfig.PickingColor or theme.Accent
            elseif keyState.Value then
                display.Text = keyName(keyState.Value)
                display.TextColor3 = keyConfig.BoundColor or keyConfig.TextColor or theme.SubText
            else
                display.Text = keyConfig.EmptyText or keyConfig.Display or "="
                display.TextColor3 = keyConfig.TextColor or theme.DimText
            end
        end

        function keyObj:Set(v, fire)
            keyState.Value = normalizeKey(v)
            keyState.Picking = false
            renderKey()
            if fire ~= false then safeCallback(keyConfig.Callback, keyState.Value) end
            return self
        end
        function keyObj:Get() return keyState.Value end
        function keyObj:Clear(fire)
            keyState.Value = nil
            keyState.Picking = false
            renderKey()
            if fire ~= false then safeCallback(keyConfig.Callback, nil) end
            return self
        end
        function keyObj:Pick()
            if state.Locked or keyState.Locked then return self end
            keyState.PreviousValue = keyState.Value
            keyState.Picking = true
            renderKey()
            safeCallback(keyConfig.OnPicking, true)
            return self
        end

        display.MouseEnter:Connect(function()
            if not state.Locked and not keyState.Locked and not keyState.Picking then
                Tween(display, 0.08, { TextColor3 = keyConfig.HoverColor or theme.Text })
            end
        end)
        display.MouseLeave:Connect(renderKey)
        display.MouseButton1Click:Connect(function() keyObj:Pick() end)

        local keyConn
        keyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not row.Parent then
                if keyConn then keyConn:Disconnect() end
                return
            end
            local key = input.KeyCode
            if key == Enum.KeyCode.Unknown then return end

            if keyState.Picking then
                if key == Enum.KeyCode.Escape then
                    keyState.Value = keyState.PreviousValue
                    keyState.Picking = false
                    renderKey()
                    safeCallback(keyConfig.OnPicking, false)
                    return
                end
                if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                    keyObj:Clear(true)
                    safeCallback(keyConfig.OnPicking, false)
                    return
                end
                local blocked = false
                for _, b in ipairs(keyState.Blacklist) do
                    if normalizeKey(b) == key then blocked = true break end
                end
                if blocked then return end

                keyState.Value = key
                keyState.Picking = false
                renderKey()
                safeCallback(keyConfig.Callback, key)
                safeCallback(keyConfig.OnPicking, false)
                return
            end

            if gameProcessed or state.Locked or keyState.Locked then return end

            if keyState.Value and key == keyState.Value then
                obj:Set(not state.Value, true)
                safeCallback(keyConfig.OnTriggered, state.Value, key)
            end
        end)

        obj.Keybind = keyObj
        obj.UIElements.Keybind = display

        function obj:SetKeybind(v, fire) keyObj:Set(v, fire); return self end
        function obj:GetKeybind() return keyObj:Get() end
        function obj:ClearKeybind(fire) keyObj:Clear(fire); return self end

        renderKey()
    end

    --========== VALUE TEXT ==========
    if hasValueText then
        local valueWidth = config.ValueWidth or 48
        local valueLabel = New("TextLabel", {
            BackgroundTransparency = 1,
            Text = tostring(config.ValueText),
            TextColor3 = config.ValueTextColor or theme.DimText,
            TextSize = config.ValueTextSize or 11,
            Font = theme.Font,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -rightCursor, 0.5, 0),
            Size = UDim2.fromOffset(valueWidth, 20),
            TextXAlignment = Enum.TextXAlignment.Right,
            ZIndex = 4,
            Parent = row,
        })
        rightCursor += valueWidth + 6
        obj.UIElements.ValueText = valueLabel
        function obj:SetValueText(v) valueLabel.Text = tostring(v); return self end
    end

    AttachLockAPI(obj, state, box)
    render(false)
    return obj
end

