function Section:Keybind(config)
    config = config or {}
    local theme = self.Window.Theme
    config.RightReserve = config.RightReserve or 70

    local row, title = MakeRow(self, config, config.Height or 30)

    local display = New("TextButton", {
        BackgroundColor3 = theme.Surface2,
        BackgroundTransparency = 0,
        Text = config.Display or config.Text or "=",
        TextColor3 = config.KeyTextColor or theme.DimText,
        TextSize = config.KeyTextSize or 11,
        Font = theme.Font,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -24, 0.5, 0),
        Size = UDim2.fromOffset(config.DisplayWidth or 45, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
        AutoButtonColor = false,
        ZIndex = 8,
        Parent = row,
    })
    Corner(display, 8)
    CuteStroke(display, theme.Border, 0.35)

    local state = {
        Value = config.Value or config.Default or nil,
        Locked = config.Locked or false,
        Picking = false,
        Blacklist = config.Blacklist or { Enum.KeyCode.Escape },
    }

    local obj = { __type = "Keybind", UIElements = { Row = row, Title = title, Display = display } }

    local function render()
        if state.Picking then
            display.Text = "..."
            display.TextColor3 = theme.Accent
        else
            display.Text = typeof(state.Value) == "EnumItem" and state.Value.Name or (config.Display or "=")
            display.TextColor3 = config.KeyTextColor or theme.DimText
        end
    end

    function obj:Set(v, fire)
        state.Value = v
        render()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    display.MouseButton1Click:Connect(function()
        if state.Locked then return end
        state.Picking = true
        render()
    end)

    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gp)
        if not row.Parent then conn:Disconnect() return end
        if not state.Picking or gp then return end
        local key = input.KeyCode
        if key == Enum.KeyCode.Unknown then return end
        state.Picking = false
        state.Value = key
        render()
        safeCallback(config.Callback, key)
    end)

    AttachLockAPI(obj, state, display)
    render()
    return obj
end

