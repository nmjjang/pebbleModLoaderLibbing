    end)

    local contentHost = New("Frame", {
        Name = "ContentHost",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(sidebarWidth + 12, topHeight + 10),
        Size = UDim2.new(1, -(sidebarWidth + 24), 1, -(topHeight + 22)),
        Parent = main,
    })
    self.ContentHost = contentHost

    -- The profile card follows the same auto-fit rules as tabs, so long display names stay readable.
    self:_fitSidebarText(displayName, 12, self.Theme.FontDisplay or self.Theme.FontBold, true, 12)

    local notifHolder = New("Frame", {
        Name = "NotificationHolder",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(520, 400),
        ZIndex = 200,
        Parent = screen,
    })
    List(notifHolder, 4)
    self.NotificationHolder = notifHolder

    -- Soft launch animation for the entire window.
    main.BackgroundTransparency = math.min(1, self.BackgroundTransparency + 0.18)
    local mainScale = EnsureScale(main)
    mainScale.Scale = 0.99
    task.defer(function()
        Tween(main, 0.28, { BackgroundTransparency = self.BackgroundTransparency }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(mainScale, 0.28, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
    end)

    local toggleKey = config.ToggleKey or Defaults.ToggleKey
    local inputConn
    inputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if self.Destroyed then inputConn:Disconnect() return end
        if gp then return end
        if input.KeyCode == toggleKey then
            self:ToggleVisibility()
        end
    end)

    if config.Draggable ~= false then
        local dragging, dragStart, startPos, dragInput

        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        topbar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input == dragInput then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
    end
    self:_CreateScriptExplorer()
    screen.Destroying:Connect(function()
        self:_DisposeScripts()
        self.Destroyed = true
    end)
    return self
end

print("[PebbleUI] Loaded v" .. PebbleUI.Version)
return PebbleUI
