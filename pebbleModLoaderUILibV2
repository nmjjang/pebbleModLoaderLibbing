        if kind == "Exec" then return true end
        if kind == "BrickColor" then
            local value = BrickColor.new(tonumber(text) or text)
            assert(tonumber(text) or value.Name:lower() == text:lower(), "Invalid BrickColor: " .. text)
            return value
        end
        if kind == "boolean" then
            if text == "true" then return true end
            if text == "false" then return false end
            error("Use true or false.", 0)
        end
        if kind == "number" then
            local n = tonumber(text)
            assert(n and n == n and math.abs(n) < math.huge, "Invalid number: " .. text)
            return n
        end
        if kind:match("^Enum%.") then
            local enumName = kind:sub(6)
            local itemName = text:match("([%w_]+)$")
            local enum = Enum[enumName]
            assert(enum and itemName and enum[itemName], "Invalid Enum: " .. kind .. "." .. tostring(itemName))
            return enum[itemName]
