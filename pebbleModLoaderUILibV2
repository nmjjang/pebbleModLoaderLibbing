function Section:_nextOrder()
    self.Order += 1
    return self.Order
end

function Section:_recalculateHeight()
    task.defer(function()
        if not self.Frame.Parent then return end
        local contentH = self.Layout.AbsoluteContentSize.Y
        local target = self.HeaderHeight + self.PaddingBottom + contentH
        Tween(self.Frame, 0.25, {
            Size = UDim2.new(1, 0, 0, target)
        }, EASE_SOFT, Enum.EasingDirection.Out)
    end)
end

