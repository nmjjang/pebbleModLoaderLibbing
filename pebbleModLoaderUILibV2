function Window:Notify(config)
    config = config or {}
    local theme = self.Theme
    local message = tostring(config.Content or config.Text or config.Title or "Notification")
    local textSize = config.TextSize or 12

    local bounds = TextService:GetTextSize(message, textSize, theme.Font, Vector2.new(config.MaxWidth or 420, 1000))
    local width = math.clamp(bounds.X + 44, 150, config.MaxWidth or 420)
    local height = math.max(42, bounds.Y + 18)

    local holder = New("Frame", {
        Name = "Notification", BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.fromOffset(width, height), LayoutOrder = #self.Notifications + 1,
        ClipsDescendants = false, ZIndex = 201, Parent = self.NotificationHolder,
    })

    local card = New("Frame", {
        Name = "Card", Position = UDim2.fromOffset(-(width + 18), 0), Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = config.BackgroundColor or theme.Paper,
        BackgroundTransparency = config.BackgroundTransparency or 0, BorderSizePixel = 0, ZIndex = 202, Parent = holder,
    })
    Corner(card, config.Corner or theme.PopupRadius)
    local border = FineStroke(card, config.BorderColor or theme.Border, 0.12)

    local badge = New("Frame", {
        BackgroundColor3 = config.AccentColor or theme.SkySoft, BorderSizePixel = 0,
        Position = UDim2.fromOffset(8, 9), Size = UDim2.fromOffset(24, 24), ZIndex = 203, Parent = card,
    })
    Corner(badge, theme.ControlRadius)
    local sparkle = CreateIcon(config.Icon or "sparkles", 13, config.IconColor or theme.Accent, 204)
    sparkle.AnchorPoint = Vector2.new(0.5,0.5); sparkle.Position = UDim2.fromScale(0.5,0.5); sparkle.Parent = badge

    local label = New("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -48, 1, 0),
        Font = theme.FontMedium, Text = message, TextColor3 = config.TextColor or theme.Text, TextSize = textSize,
        TextWrapped = config.TextWrapped ~= false, TextXAlignment = config.TextXAlignment or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 203, Parent = card,
    })

    BindTheme(self, card, "BackgroundColor3", "Paper", config.BackgroundColor)
    BindTheme(self, border, "Color", "Border", config.BorderColor)
    BindTheme(self, badge, "BackgroundColor3", "SkySoft", config.AccentColor)
    BindTheme(self, sparkle, "ImageColor3", "Accent", config.IconColor)
    BindTheme(self, label, "TextColor3", "Text", config.TextColor)
    BindTheme(self, label, "Font", "FontMedium")
    local obj = { __type = "Notification", UI = holder, Card = card, Label = label, Closed = false }
    function obj:Close()
        if self.Closed then return end
        self.Closed = true
        Tween(card, 0.24, { Position = UDim2.fromOffset(-(width + 18), 0), BackgroundTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        Tween(label, 0.2, { TextTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        Tween(border, 0.2, { Transparency = 1 }, EASE_SOFT, Enum.EasingDirection.In)
        task.delay(0.28, function() if holder then holder:Destroy() end end)
    end

    table.insert(self.Notifications, obj)
    task.defer(function()
        Tween(card, 0.3, { Position = UDim2.fromOffset(0, 0) }, EASE_SETTLE, Enum.EasingDirection.Out)
        PopIn(badge, 0.06)
    end)

    if config.Duration ~= false then
        task.delay(config.Duration or 3, function() if not obj.Closed then obj:Close() end end)
    end
    return obj
end

