    function Window:_DrawBlueprintWires()
        local r,ui = self.ActiveBlueprint,self.BlueprintUI; if not r or not ui then return end
        local pool = self._bpWirePool or {}; self._bpWirePool = pool
        local used = 0
        local function segment(a,b,color,transparency)
            local delta = b-a; local length = delta.Magnitude
            if length < 0.01 then return end
            used = used+1
            local line = pool[used]
            if not line then
                line = New("Frame", { AnchorPoint = Vector2.new(0.5,0.5), BorderSizePixel = 0, ZIndex = 23, Parent = ui.WireLayer })
                pool[used] = line
            end
            local middle = (a+b)/2
            line.Visible = true; line.Position = UDim2.fromOffset(middle.X,middle.Y); line.Size = UDim2.fromOffset(length+1,3)
            line.Rotation = math.deg(math.atan2(delta.Y,delta.X)); line.BackgroundColor3 = color; line.BackgroundTransparency = transparency or 0.1
        end
        local function point(endpoint)
            if not endpoint or not endpoint.Button.Parent then return nil end
            local p = endpoint.Button.AbsolutePosition+endpoint.Button.AbsoluteSize/2
            if not inside(endpoint.Scroll,p) then return nil end
            return p-ui.Board.AbsolutePosition
        end
        local function curve(a,b,color,transparency)
            if not a or not b then return end
            local offset = math.max(55,math.abs(b.X-a.X)*0.45)
            local c1,c2 = a+Vector2.new(offset,0),b-Vector2.new(offset,0)
            local previous = a
            for i=1,36 do
                local t=i/36; local u=1-t
                local p=a*(u*u*u)+c1*(3*u*u*t)+c2*(3*u*t*t)+b*(t*t*t)
                segment(previous,p,color,transparency); previous=p
            end
        end
        local endpoints = {}
        for _,e in ipairs(self._bpEndpoints or {}) do endpoints[e.Node .. ":" .. e.Direction .. ":" .. e.Port.Name] = e end
        for _,link in ipairs(r.Links) do
            local a = endpoints[link.From .. ":out:" .. link.Output]
            local b = endpoints[link.To .. ":in:" .. link.Input]
            local node = nodeById(r,link.From)
            local color = node and definition(node).Color or self.Theme.SubText
            curve(point(a),point(b),color,(r.Invalid and (r.Invalid[link.From] or r.Invalid[link.To])) and 0.75 or 0.12)
        end
        if self._bpPending then
            local p = point(self._bpPending)
            local mouse = pointer()-ui.Board.AbsolutePosition
            if self._bpPending.Direction == "out" then curve(p,mouse,self.Theme.Accent,0.25) else curve(mouse,p,self.Theme.Accent,0.25) end
        end
        for i=used+1,#pool do pool[i].Visible = false end
        -- Grid follows pan and zoom, with a fixed count of reusable line frames.
        local grid = self._bpGridPool or {}; self._bpGridPool=grid
        local spacing = math.max(16,32*r.View.Zoom)
        local size=ui.Board.AbsoluteSize; local index=0
        local function gridLine(x,y,width,height)
            index=index+1; local line=grid[index]
            if not line then line=New("Frame",{ BorderSizePixel=0,BackgroundTransparency=0.82,ZIndex=21,Parent=ui.Grid }); grid[index]=line end
            line.BackgroundColor3=self.Theme.Border; line.Position=UDim2.fromOffset(x,y); line.Size=UDim2.fromOffset(width,height); line.Visible=true
        end
        for x=r.View.X%spacing,size.X,spacing do gridLine(x,0,1,size.Y) end
        for y=r.View.Y%spacing,size.Y,spacing do gridLine(0,y,size.X,1) end
        for i=index+1,#grid do grid[i].Visible=false end
        self._bpWireDirty=false
    end
