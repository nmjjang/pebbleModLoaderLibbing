function PebbleUI:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, Window)

    self.Config = config
    self.Theme = merge(DefaultTheme, config.Theme or {})
    if config.SelectColor then self.Theme.Accent = config.SelectColor end

    self.Title = config.Title or Defaults.Title
    self.Tabs = {}
    self.Notifications = {}
    self.ActiveTab = nil
    self.ActiveDropdown = nil
    self.ActiveColorpicker = nil
    self.SidebarOrder = 0
    self.Visible = true
    self.Destroyed = false
    self._themeBindings = {}

    local bgTransparency = config.BackgroundTransparency
    if bgTransparency == nil then bgTransparency = Defaults.BackgroundTransparency end
    self.BackgroundTransparency = clamp01(bgTransparency)

    local size = config.Size or Defaults.Size
    local sidebarWidth = config.SidebarWidth or Defaults.SidebarWidth
    local topHeight = config.TopbarHeight or Defaults.TopbarHeight
