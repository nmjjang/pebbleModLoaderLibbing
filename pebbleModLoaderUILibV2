function Section:Slider(config)
    config = config or {}
    local window = self.Window
    local theme = window.Theme

    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100
    if min > max then min, max = max, min end

    local step = tonumber(config.Step) or tonumber(config.Increment) or 1
    if step <= 0 then step = 1 end

    local function snap(v)
        v = clamp(tonumber(v) or min, min, max)
        local s = math.floor(((v - min) / step) + 0.5)
        return clamp(min + (s * step), min, max)
    end

    local default = snap(tonumber(config.Default or config.Value) or min)

    local holder = New("Frame", {
        Name = config.Title or "Slider",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, config.Height or 32),
        LayoutOrder = self:_nextOrder(),
        Parent = self.Content,
    })

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Slider",
        TextColor3 = config.TextColor or theme.SubText,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Size = UDim2.new(1, -70, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local valueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = config.ValueColor or theme.Text,
        TextSize = config.ValueTextSize or 11,
        Font = config.Font or theme.Font,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(67, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = holder,
    })

    -- A generous hit area keeps the thin visual rail easy to drag.
    local track = New("TextButton", {
        Name = "SliderHitArea",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 18),
        Size = UDim2.new(1, 0, 0, 14),
        Text = "",
        AutoButtonColor = false,
        Parent = holder,
    })
    local rail = New("Frame", {
        Name = "Rail",
        BackgroundColor3 = config.TrackColor or theme.SliderTrack,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0, config.TrackHeight or 3),
        Parent = track,
    })
    Corner(rail, 2)

    local fill = New("Frame", {
        BackgroundColor3 = config.FillColor or theme.SliderFill,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = rail,
    })
    Corner(fill, 99)

    local knob = New("Frame", {
        BackgroundColor3 = config.KnobColor or theme.SliderKnob,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(config.KnobSize or 6, config.KnobSize or 6),
        Parent = rail,
    })
    Corner(knob, 99)
    knob.Visible = config.ShowKnob ~= false
    BindTheme(window, rail, "BackgroundColor3", "SliderTrack", config.TrackColor)
    BindTheme(window, fill, "BackgroundColor3", "SliderFill", config.FillColor)
    BindTheme(window, knob, "BackgroundColor3", "SliderKnob", config.KnobColor)
    BindTheme(window, valueLabel, "TextColor3", "Text", config.ValueColor)
    BindTheme(window, title, "Font", "Font", config.Font)
    BindTheme(window, valueLabel, "Font", "Font", config.Font)

    local state = {
        Value = default,
        Locked = config.Locked or false,
        Dragging = false,
    }

    local obj = {
        __type = "Slider",
        UIElements = { Holder = holder, Title = title, Track = track, Rail = rail, Fill = fill, Knob = knob, Value = valueLabel },
    }

    local function format(v)
        if config.Format then
            local ok, r = pcall(config.Format, v)
            if ok and r ~= nil then return tostring(r) end
        end
        if step < 1 then return string.format("%.2f", v) end
        return tostring(v)
    end

    local lastText = ""
    local function render()
        local range = max - min
        local ratio = range == 0 and 0 or clamp((state.Value - min) / range, 0, 1)
        Tween(fill, 0.18, { Size = UDim2.new(ratio, 0, 1, 0) }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(knob, 0.18, { Position = UDim2.new(ratio, 0, 0.5, 0) }, EASE_SOFT, Enum.EasingDirection.Out)

        local newText = (config.Prefix or "") .. format(state.Value) .. (config.Suffix or "")
        if newText ~= lastText then
            lastText = newText
            valueLabel.Text = newText
        end
    end

    function obj:Set(v, fire)
        state.Value = snap(tonumber(v) or state.Value)
        render()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    local function updateFromX(x)
        local width = math.max(1, track.AbsoluteSize.X)
        local ratio = clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        obj:Set(min + ((max - min) * ratio), true)
    end

    track.MouseEnter:Connect(function()
        Tween(knob, 0.22, {
            Size = UDim2.fromOffset((config.KnobSize or 6) + 3, (config.KnobSize or 6) + 3)
        }, EASE_OUT, Enum.EasingDirection.Out)
    end)
    track.MouseLeave:Connect(function()
        if not state.Dragging then
            Tween(knob, 0.28, {
                Size = UDim2.fromOffset(config.KnobSize or 6, config.KnobSize or 6)
            }, EASE_OUT, Enum.EasingDirection.Out)
        end
    end)

    track.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            state.Dragging = true
            Tween(knob, 0.2, {
                Size = UDim2.fromOffset((config.KnobSize or 6) + 4, (config.KnobSize or 6) + 4)
            }, EASE_OUT, Enum.EasingDirection.Out)
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not state.Dragging or state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if state.Dragging then
                state.Dragging = false
                Tween(knob, 0.28, {
                    Size = UDim2.fromOffset(config.KnobSize or 6, config.KnobSize or 6)
                }, EASE_OUT, Enum.EasingDirection.Out)
            end
        end
    end)

    local function renderLocked()
        if state.Locked then state.Dragging = false end
        title.TextColor3 = state.Locked and theme.MutedText or (config.TextColor or theme.SubText)
        valueLabel.TextColor3 = state.Locked and theme.MutedText or (config.ValueColor or theme.Text)
        fill.BackgroundTransparency = state.Locked and 0.55 or 0
        knob.BackgroundTransparency = state.Locked and 0.55 or 0
    end
    AttachLockAPI(obj, state, renderLocked)
    WatchTheme(window, holder, renderLocked)
    render()
    return obj
end

