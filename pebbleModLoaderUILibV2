            Transparency = self.Theme.ScrollbarTransparency })
    end)
    local connection = UserInputService.InputBegan:Connect(function(input)
        if self.Destroyed then return end
        if self._scriptModal then
            if input.KeyCode == Enum.KeyCode.Escape then self._scriptModal:Close() end
            return
        end
        local ui = self.ScriptEditorElements
        if not self.Visible or not self.ActiveScript or not ui.Input:IsFocused() then return end
        if input.KeyCode == Enum.KeyCode.Tab then
            self:InsertScriptText("    ")
        elseif (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            or UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta) or UserInputService:IsKeyDown(Enum.KeyCode.RightMeta))
            and input.KeyCode == Enum.KeyCode.S then
            self:SaveScripts()
        end
    end)
    table.insert(self._scriptConnections, connection)
    local caretConnection = RunService.RenderStepped:Connect(function()
        local ui = self.ScriptEditorElements
        if self.Destroyed or not self.Visible or not self.ActiveScript or not ui.Input:IsFocused() then
            ui.Caret.Visible = false
            return
        end
        ui.Caret.Visible = self._editorHasHighlight
            and ((os.clock() - (self._scriptCaretTimestamp or 0)) % 1.1 < 0.65)
    end)
    table.insert(self._scriptConnections, caretConnection)
    self:_LoadCustomScripts()
end

function Window:_DisposeScripts()
    if self._scriptDisposed then return end
    self._scriptDisposed = true
    if self._scriptsDirty then self:SaveScripts() end
    if self._scriptModal then self._scriptModal:Close() end
    for _, connection in ipairs(self._scriptConnections or {}) do connection:Disconnect() end
    self._scriptConnections = {}
end


