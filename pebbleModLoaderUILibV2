--============================================================
-- Row helper (Wind-style compact)
--============================================================

local function RowHeight(config, base)
    if config.Size then return nil end
    if config.Height then return config.Height end
    if config.Desc or config.Description then
        return math.max(base or 30, 46)
    end
    return base or 30
end

local function MakeRow(section, config, height)
    local theme = section.Window.Theme
    local row = New("Frame", {
        Name = config.Title or config.Name or "Row",
        BackgroundTransparency = 1,
        Size = config.Size or UDim2.new(1, 0, 0, height or 30),
        LayoutOrder = section:_nextOrder(),
        ZIndex = config.ZIndex or 2,
    })
    row.Parent = section.Content

    local iconOffset = 0
    if config.Icon then
        local icon = CreateIcon(config.Icon, config.IconSize or 13,
            config.IconColor or theme.MutedText, row.ZIndex + 1)
        icon.AnchorPoint = Vector2.new(0, 0.5)
        icon.Position = UDim2.new(0, 0, 0.5, 0)
        icon.Parent = row
        iconOffset = (config.IconSize or 13) + 7
    end

    local hasDesc = (config.Desc or config.Description) ~= nil

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or config.Name or "Element",
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Position = UDim2.fromOffset(iconOffset, 0),
        Size = UDim2.new(1, -(iconOffset + (config.RightReserve or 70)),
            hasDesc and 0 or 1, hasDesc and 18 or 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = row.ZIndex + 1,
    })
    title.Parent = row

    local desc
    if hasDesc then
        desc = New("TextLabel", {
            BackgroundTransparency = 1,
            Text = tostring(config.Desc or config.Description),
            TextColor3 = config.DescColor or theme.SubText,
            TextSize = config.DescSize or 10,
            Font = theme.Font,
            Position = UDim2.fromOffset(iconOffset, 20),
            Size = UDim2.new(1, -(iconOffset + (config.RightReserve or 70)), 1, -20),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = row.ZIndex + 1,
        })
        desc.Parent = row
    end

    return row, title, desc
end

--============================================================
-- Lock API
--============================================================

local function AttachLockAPI(element, config, render)
    element.Locked = config.Locked == true

    function element:Lock()
        element.Locked = true
        if render then render() end
        return element
    end

    function element:Unlock()
        element.Locked = false
        if render then render() end
        return element
    end

    function element:IsLocked() return element.Locked end
    return element
end

