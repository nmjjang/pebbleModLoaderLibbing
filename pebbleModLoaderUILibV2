    end
    if #utf > 32 then
        utf = { table.unpack(utf, 1, 32) }
    end
    local font = theme.FontDisplay or Enum.Font.GothamBold
    for index, char in ipairs(utf) do
        local measured = TextService:GetTextSize(char, 23, font, Vector2.new(100, 40))
