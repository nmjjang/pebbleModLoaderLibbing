function Section:Dropdown(config)
    config = config or {}
    local window = self.Window
    local theme = window.Theme

    local values = config.Values or {}
    local multi = config.Multi == true
    local current = config.Value or config.Default
    if multi and type(current) ~= "table" then current = {} end

    local holder = New("Frame", {
        Name = config.Title or "Dropdown",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, config.Height or 56),
        LayoutOrder = self:_nextOrder(),
        Parent = self.Content,
    })

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Dropdown",
        TextColor3 = theme.Text,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.Font,
        Size = UDim2.new(1, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local selector = New("TextButton", {
        Name = "Selector",
        BackgroundColor3 = config.BackgroundColor or theme.Input,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Position = UDim2.fromOffset(0, 25),
        Size = UDim2.new(1, 0, 0, config.BoxHeight or 26),
        ZIndex = 5,
        Parent = holder,
    })
    Corner(selector, config.Corner or 10)
    local selectorStroke = CuteStroke(selector, theme.Border, 0.25)

    local valueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = config.ValueColor or theme.SubText,
        TextSize = config.ValueTextSize or 11,
        Font = theme.Font,
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -34, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = selector.ZIndex + 1,
        Parent = selector,
    })

    local chev = CreateIcon("chevron-down", 14, theme.MutedText, selector.ZIndex + 2)
    chev.AnchorPoint = Vector2.new(1, 0.5)
    chev.Position = UDim2.new(1, -8, 0.5, 0)
    chev.Parent = selector

    local menu = New("Frame", {
        Name = "DropdownMenu",
        BackgroundColor3 = config.MenuColor or theme.Popup,
        BorderSizePixel = 0,
        Visible = false,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(0, 0),
        ZIndex = 5000,
        ClipsDescendants = true,
        Parent = window.ScreenGui,
    })
    Corner(menu, config.MenuCorner or 12)
    CuteStroke(menu, theme.Border, 0.18)

    local scroll = New("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = menu.ZIndex + 1,
        Parent = menu,
    })
    StyleScrollBar(scroll, { Thickness = 2, Transparency = 0.5 })
    Padding(scroll, 5, 5, 5, 5)
    List(scroll, 4)

    selector.MouseEnter:Connect(function()
        Tween(selectorStroke, 0.18, { Color = theme.Accent, Transparency = 0.12 }, EASE_SOFT, Enum.EasingDirection.Out)
        HoverScale(selector, 1.006)
    end)
    selector.MouseLeave:Connect(function()
        Tween(selectorStroke, 0.22, { Color = theme.Border, Transparency = 0.25 }, EASE_SOFT, Enum.EasingDirection.Out)
        RestScale(selector)
    end)

    local state = {
        Value = current,
        Values = values,
        Open = false,
        Locked = config.Locked or false,
    }

    local obj = {
        __type = "Dropdown",
        UIElements = { Holder = holder, Title = title, Selector = selector, Value = valueLabel, Menu = menu, Scroll = scroll },
    }

    local followConn = nil

    local function valueToText()
        if multi then
            if #state.Value == 0 then return config.Placeholder or "Select..." end
            local parts = {}
            for _, v in ipairs(state.Value) do table.insert(parts, tostring(v)) end
            return table.concat(parts, ", ")
        end
        if state.Value == nil then return config.Placeholder or "Select..." end
        return tostring(state.Value)
    end

    local function renderValue() valueLabel.Text = valueToText() end

    local function getMenuHeight()
        local c = math.min(#state.Values, config.MaxVisible or 6)
        if c <= 0 then return 10 end
        return c * (config.ItemHeight or 28) + math.max(0, c - 1) * 4 + 10
    end

    local function updateMenuPosition()
        if not state.Open or not selector.Parent or not menu.Parent then return end
        local sp = selector.AbsolutePosition
        local ss = selector.AbsoluteSize
        local screenSize = window.ScreenGui.AbsoluteSize
        local gap = config.MenuGap or 6
        local targetH = getMenuHeight()
        local w = ss.X

        local x = sp.X
        local belowY = sp.Y + ss.Y + gap
        local aboveY = sp.Y - targetH - gap
        local y = belowY

        if belowY + targetH > screenSize.Y and aboveY >= 0 then y = aboveY end
        if x + w > screenSize.X then x = math.max(0, screenSize.X - w) end
        x = math.max(0, x)

        menu.Position = UDim2.fromOffset(x, y)
        menu.Size = UDim2.fromOffset(w, menu.Size.Y.Offset)
    end

    local function stopFollowing()
        if followConn then followConn:Disconnect(); followConn = nil end
    end

    local function closeMenu(instant)
        if not state.Open and not menu.Visible then return end
        state.Open = false
        stopFollowing()
        if window.ActiveDropdown == obj then window.ActiveDropdown = nil end

        Tween(chev, 0.28, { Rotation = 0 }, EASE_SOFT, Enum.EasingDirection.Out)

        if instant then
            menu.Size = UDim2.fromOffset(menu.Size.X.Offset, 0)
            menu.Visible = false
            return
        end

        Tween(menu, 0.22, { Size = UDim2.fromOffset(menu.Size.X.Offset, 0) }, EASE_SOFT, Enum.EasingDirection.Out)
        task.delay(0.24, function()
            if not state.Open and menu.Parent then menu.Visible = false end
        end)
    end

    local function openMenu()
        if state.Locked or state.Open then return end
        if window.ActiveDropdown and window.ActiveDropdown ~= obj then
            window.ActiveDropdown:Close()
        end
        window.ActiveDropdown = obj
        state.Open = true
        menu.Visible = true

        Tween(chev, 0.28, { Rotation = 180 }, EASE_SOFT, Enum.EasingDirection.Out)

        local targetH = getMenuHeight()
        local w = selector.AbsoluteSize.X
        menu.Size = UDim2.fromOffset(w, 0)
        updateMenuPosition()
        Tween(menu, 0.26, { Size = UDim2.fromOffset(w, targetH) }, EASE_SOFT, Enum.EasingDirection.Out)

        stopFollowing()
        followConn = RunService.RenderStepped:Connect(function()
            if not state.Open or not selector.Parent or not menu.Parent
                or not window.Visible or not holder.Visible then
                closeMenu(true)
                return
            end
            updateMenuPosition()
        end)
    end

    local function clearMenu()
        for _, c in ipairs(scroll:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
                c:Destroy()
            end
        end
    end

    local function rebuild()
        clearMenu()
        for i, value in ipairs(state.Values) do
            local text = type(value) == "table" and (value.Title or value.Name or tostring(i)) or tostring(value)
            local item = New("TextButton", {
                Text = text,
                TextColor3 = theme.Text,
                TextSize = config.ItemTextSize or 11,
                Font = theme.Font,
                BackgroundColor3 = config.ItemColor or theme.Surface2,
                BackgroundTransparency = 0,
                Size = UDim2.new(1, 0, 0, config.ItemHeight or 28),
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                LayoutOrder = i,
                ZIndex = menu.ZIndex + 2,
                Parent = scroll,
            })
            Corner(item, config.ItemCorner or 8)
            Padding(item, 8, 8, 0, 0)

            item.MouseEnter:Connect(function()
                HoverTween(item, 0.22, { BackgroundColor3 = config.ItemHoverColor or theme.SurfaceHover })
            end)
            item.MouseLeave:Connect(function()
                HoverTween(item, 0.26, { BackgroundColor3 = config.ItemColor or theme.Surface2 })
            end)

            item.MouseButton1Click:Connect(function()
                if state.Locked then return end
                if multi then
                    local found, idx
                    for j, e in ipairs(state.Value) do
                        if e == value then found = true; idx = j; break end
                    end
                    if found then table.remove(state.Value, idx)
                    else table.insert(state.Value, value) end
                else
                    state.Value = value
                    closeMenu(false)
                end
                renderValue()
                safeCallback(config.Callback, state.Value)
            end)
        end
        if state.Open then
            updateMenuPosition()
            Tween(menu, 0.24, { Size = UDim2.fromOffset(selector.AbsoluteSize.X, getMenuHeight()) }, EASE_SOFT, Enum.EasingDirection.Out)
        end
    end

    function obj:Open() openMenu(); return self end
    function obj:Close() closeMenu(false); return self end
    function obj:Toggle()
        if state.Open then closeMenu(false) else openMenu() end
        return self
    end
    function obj:Set(v, fire)
        state.Value = v
        renderValue()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end
    function obj:Refresh(newValues, keep)
        state.Values = newValues or {}
        if not keep then state.Value = multi and {} or nil end
        rebuild()
        renderValue()
        return self
    end

    selector.MouseButton1Click:Connect(function()
        if state.Locked then return end
        obj:Toggle()
    end)

    holder.Destroying:Connect(function()
        stopFollowing()
        if window.ActiveDropdown == obj then window.ActiveDropdown = nil end
        if menu then menu:Destroy() end
    end)

    AttachLockAPI(obj, state, selector)
    rebuild()
    renderValue()
    return obj
end

