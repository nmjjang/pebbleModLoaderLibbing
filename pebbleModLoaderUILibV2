    -- Returning Pass when the popup is hidden leaves normal text editing untouched.
    local completionActionName = "PebbleUIAutocomplete_" .. tostring(self)
    local function completionAction(_, state, key)
        if not self.ActiveScript or not self.Visible or not editor.Visible or not input:IsFocused()
            or not ui.Completion.Visible or not self._scriptCompletionItems then
            return Enum.ContextActionResult.Pass
        end
        local code = key.KeyCode
        local handled = code == Enum.KeyCode.Down or code == Enum.KeyCode.Up
            or code == Enum.KeyCode.Tab or code == Enum.KeyCode.Return
            or code == Enum.KeyCode.KeypadEnter or code == Enum.KeyCode.Escape
        if not handled then return Enum.ContextActionResult.Pass end
        if state == Enum.UserInputState.Begin then
            if code == Enum.KeyCode.Down then
                self:_MoveScriptAutocomplete(1)
            elseif code == Enum.KeyCode.Up then
                self:_MoveScriptAutocomplete(-1)
            elseif code == Enum.KeyCode.Escape then
                self:_CloseScriptAutocomplete()
            else
                self:_ChooseScriptAutocomplete()
            end
        end
        return Enum.ContextActionResult.Sink
    end
    ContextActionService:BindActionAtPriority(completionActionName, completionAction, false, 3100,
        Enum.KeyCode.Down, Enum.KeyCode.Up, Enum.KeyCode.Tab,
        Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.Escape)
    table.insert(self._scriptConnections, { Disconnect = function()
        ContextActionService:UnbindAction(completionActionName)
    end })
    WatchTheme(self, editor, function()
        self:_RenderScriptEditor()
        self:_ScriptStatus(self._scriptStatusText, self._scriptStatusDanger)
        StyleScrollBar(scroll, { Thickness = 3, Color = self.Theme.Scrollbar, Transparency = self.Theme.ScrollbarTransparency })
    end)
end

function Window:_LoadCustomScripts()
    local payload, ok, err
    self._scriptStorageFile = self.Config.ScriptStorageFile
    if self._scriptStorageFile == nil then
        local identity = tostring(self.Config.Name or self.Title):gsub("[^%w_-]", "_"):sub(1, 64)
        self._scriptStorageFile = "PebbleUI_" .. identity .. "_scripts.json"
    end
    if self._scriptStorageFile == false or type(self._scriptStorageFile) ~= "string" then self._scriptStorageFile = nil end
    self._hasScriptStorage = type(self.Config.SaveScripts) == "function"
        or (self._scriptStorageFile ~= nil and type(readfile) == "function" and type(writefile) == "function")
    if type(self.Config.LoadScripts) == "function" then
        ok, payload = pcall(self.Config.LoadScripts, self)
        if not ok then err = payload end
    elseif self._scriptStorageFile and type(readfile) == "function" then
        local exists = true
        if type(isfile) == "function" then
            local checkOk, found = pcall(isfile, self._scriptStorageFile)
            exists = checkOk and found
            if not checkOk then err = found end
        end
        if exists then
            ok, payload = pcall(readfile, self._scriptStorageFile)
            -- Without isfile, a missing file is a normal first launch.
            if not ok and type(isfile) == "function" then err = payload end
        end
    end
    if payload == nil and err == nil and type(self.Config.Scripts) == "table" then
        ok, payload = true, { Version = 1, Scripts = self.Config.Scripts }
    end
    if ok and payload ~= nil then
        self._loadingScripts = true
        local imported, importError = self:ImportScripts(payload, true)
        self._loadingScripts = false
        if not imported then err = importError end
    end
    if err then
        self._scriptStorageBlocked = true
        self._hasScriptStorage = false
        self:Notify({ Content = "Could not load saved scripts. The explorer will use this window's memory.", Duration = 6 })
    end
    self._scriptsDirty = false
    self._scriptSaveRevision = (self._scriptSaveRevision or 0) + 1
    for _, record in ipairs(self.CustomScripts) do record.Dirty = false end
    self:_RenderScriptRows()
end

