        TextSize = config.TextSize or 12,
        Font = theme.FontMedium,
        Position = UDim2.fromOffset(icon and 34 or 13, 0),
        Size = UDim2.new(1, -(icon and 40 or 20), 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = button,
    })

    local accent = New("Frame", {
        Name = "Accent",
        BackgroundColor3 = config.AccentColor or theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(4, 18),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0),
        Parent = button,
    })
    Corner(accent, 99)

    local container = New("Frame", {
        Name = title .. "_Container",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        Parent = self.ContentHost,
    })

    local leftWidth = self.Config.LeftColumnWidth or Defaults.LeftColumnWidth
    local gap = self.Config.ColumnGap or Defaults.ColumnGap

    local leftScroll = StyleScrollBar(New("ScrollingFrame", {
        Name = "LeftScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ElasticBehavior = Enum.ElasticBehavior.Never,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(0, leftWidth, 1, 0),
        Parent = container,
    }), {
        Thickness = self.Theme.ScrollbarThickness or 4,
        Color = self.Theme.Scrollbar,
        Transparency = self.Theme.ScrollbarTransparency or 0.48,
        Inset = Enum.ScrollBarInset.ScrollBar,
    })

    local leftContainer = New("Frame", {
        Name = "LeftContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = leftScroll,
    })
    local leftLayout = List(leftContainer, self.Config.SectionGap or Defaults.SectionGap)

    local rightScroll = StyleScrollBar(New("ScrollingFrame", {
        Name = "RightScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ElasticBehavior = Enum.ElasticBehavior.Never,
        Position = UDim2.fromOffset(leftWidth + gap, 0),
        Size = UDim2.new(1, -(leftWidth + gap), 1, 0),
        Parent = container,
    }), {
        Thickness = self.Theme.ScrollbarThickness or 4,
        Color = self.Theme.Scrollbar,
        Transparency = self.Theme.ScrollbarTransparency or 0.48,
        Inset = Enum.ScrollBarInset.ScrollBar,
    })

    local rightContainer = New("Frame", {
        Name = "RightContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = rightScroll,
    })
    local rightLayout = List(rightContainer, self.Config.SectionGap or Defaults.SectionGap)

    local tab = setmetatable({
        __type = "Tab",
        Window = self,
        Title = title,
        Icon = config.Icon,
        Button = button,
        ButtonLabel = label,
        ButtonIcon = icon,
        Accent = accent,
        Container = container,
        LeftScroll = leftScroll,
        RightScroll = rightScroll,
        LeftContainer = leftContainer,
        RightContainer = rightContainer,
        LeftLayout = leftLayout,
        RightLayout = rightLayout,
        Sections = {},
        SectionOrders = { Left = 0, Right = 0 },
    }, Tab)

    table.insert(self.Tabs, tab)

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            Tween(button, 0.2, { BackgroundTransparency = 0.5 }, EASE_SOFT, Enum.EasingDirection.Out)
            HoverTween(label, 0.2, { TextColor3 = theme.Accent })
            if icon then HoverTween(icon, 0.2, { ImageColor3 = theme.Accent }) end
            HoverScale(button, 1.015)
        end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            Tween(button, 0.24, { BackgroundTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
            HoverTween(label, 0.24, { TextColor3 = theme.SubText })
            if icon then HoverTween(icon, 0.24, { ImageColor3 = theme.Icon }) end
            RestScale(button)
        end
    end)
    button.MouseButton1Down:Connect(function() PressScale(button) end)
    button.MouseButton1Up:Connect(function() ReleaseScale(button) end)
    button.MouseButton1Click:Connect(function() self:_setActiveTab(tab) end)

    if not self.ActiveTab then self:_setActiveTab(tab) end
    return tab
end

function Window:SetTheme(themePatch)
    self.Theme = merge(self.Theme, themePatch or {})
    self:_RefreshTheme()
    return self
end

function Window:SetSelectColor(color)
    if typeof(color) == "Color3" then
        return self:SetTheme({ Accent = color })
    end
    return self
end

function Window:SetBackgroundTransparency(value)
    value = clamp01(value)
    self.BackgroundTransparency = value
    if self.Main then
        Tween(self.Main, 0.3, { BackgroundTransparency = value }, EASE_SOFT, Enum.EasingDirection.Out)
    end
    return self
end

function Window:GetBackgroundTransparency()
    return self.BackgroundTransparency or 0
end

function Window:ToggleVisibility()
    self.Visible = not self.Visible
    if self.Visible then
        self.Main.Visible = true
        self.Main.Size = UDim2.new(
            self.Main.Size.X.Scale, self.Main.Size.X.Offset - 20,
            self.Main.Size.Y.Scale, self.Main.Size.Y.Offset - 20
        )
        SpringTween(self.Main, { Size = self.Config.Size or Defaults.Size })
    else
        Tween(self.Main, 0.18, {
            Size = UDim2.new(
                self.Main.Size.X.Scale, self.Main.Size.X.Offset - 20,
                self.Main.Size.Y.Scale, self.Main.Size.Y.Offset - 20
            )
        }, EASE_SOFT, Enum.EasingDirection.In)
        task.delay(0.18, function()
            if not self.Visible then self.Main.Visible = false end
        end)
        if self.ActiveColorpicker then self.ActiveColorpicker:Close() end
        if self.ActiveDropdown then self.ActiveDropdown:Close() end
    end
    return self.Visible
end

function Window:Close()
    self.Destroyed = true
    if self.ActiveDropdown then self.ActiveDropdown:Close(); self.ActiveDropdown = nil end
    if self.ActiveColorpicker then self.ActiveColorpicker:Close(); self.ActiveColorpicker = nil end
    if self.ScreenGui then self.ScreenGui:Destroy() end
end

function Window:Destroy() self:Close() end

