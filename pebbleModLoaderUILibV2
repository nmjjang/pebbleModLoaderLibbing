function Section:Button(config)
    config = config or {}
    local theme = self.Window.Theme
    local h = RowHeight(config, 34)

    local btn = New("TextButton", {
        Name = config.Title or "Button",
        BackgroundColor3 = config.Color or theme.Accent,
        BorderSizePixel = 0,
        Size = config.Size or UDim2.new(1, 0, 0, h),
        LayoutOrder = self:_nextOrder(),
        Text = "",
        AutoButtonColor = false,
        ZIndex = config.ZIndex or 5,
        Parent = self.Content,
    })
    Corner(btn, config.Corner or 11)
    CuteStroke(btn, config.BorderColor or theme.AccentHover, 0.45)

    local iconOffset = 0
    if config.Icon then
        local icon = CreateIcon(config.Icon, config.IconSize or 14,
            config.IconColor or theme.AccentText, btn.ZIndex + 1)
        icon.AnchorPoint = Vector2.new(0, 0.5)
        icon.Position = UDim2.new(0, 12, 0.5, 0)
        icon.Parent = btn
        iconOffset = (config.IconSize or 14) + 9
    end

    local label = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Button",
        TextColor3 = config.TextColor or theme.AccentText,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.FontMedium,
        Position = UDim2.fromOffset(12 + iconOffset, 0),
        Size = UDim2.new(1, -(24 + iconOffset), 1, 0),
        TextXAlignment = config.TextXAlignment or (config.Icon and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center),
        ZIndex = btn.ZIndex + 2,
        Parent = btn,
    })

    local state = { Locked = config.Locked or false }
    local obj = { __type = "Button", UIElements = { Button = btn, Label = label } }

    btn.MouseEnter:Connect(function()
        if state.Locked then return end
        HoverTween(btn, 0.18, { BackgroundColor3 = config.HoverColor or theme.AccentHover })
        HoverScale(btn, 1.012)
    end)
    btn.MouseLeave:Connect(function()
        HoverTween(btn, 0.24, { BackgroundColor3 = config.Color or theme.Accent })
        RestScale(btn)
    end)

    btn.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            PressScale(btn)
            Ripple(btn, input.Position, theme.AccentText)
        end
    end)
    btn.InputEnded:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ReleaseScale(btn)
        end
    end)
    btn.MouseButton1Click:Connect(function()
        if state.Locked then return end
        safeCallback(config.Callback)
    end)

    AttachLockAPI(obj, config, function()
        local locked = obj.Locked
        state.Locked = locked
        label.TextColor3 = locked and theme.MutedText or (config.TextColor or theme.AccentText)
        btn.BackgroundTransparency = locked and 0.45 or 0
    end)

    function obj:SetText(t) label.Text = tostring(t); return self end
    PopIn(btn, 0.02)
    return obj
end

