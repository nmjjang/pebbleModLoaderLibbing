function Section:Slider(config)
    config = config or {}
    local theme = self.Window.Theme

    local min = tonumber(config.Min) or 0
    local max = tonumber(config.Max) or 100
    if min > max then min, max = max, min end

    local step = tonumber(config.Step) or tonumber(config.Increment) or 1
    if step <= 0 then step = 1 end

    local function snap(v)
        v = clamp(tonumber(v) or min, min, max)
        local s = math.floor(((v - min) / step) + 0.5)
        return clamp(min + (s * step), min, max)
    end

    local default = snap(tonumber(config.Default or config.Value) or min)

    local holder = New("Frame", {
        Name = config.Title or "Slider",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, config.Height or 46),
        LayoutOrder = self:_nextOrder(),
        Parent = self.Content,
    })

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Slider",
        TextColor3 = theme.Text,
        TextSize = config.TextSize or 12,
        Font = theme.Font,
        Size = UDim2.new(1, -70, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local valueLabel = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = config.ValueColor or theme.SubText,
        TextSize = config.ValueTextSize or 11,
        Font = theme.Font,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(67, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = holder,
    })

    local track = New("TextButton", {
        BackgroundColor3 = config.TrackColor or theme.Surface2,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 31),
        Size = UDim2.new(1, 0, 0, config.TrackHeight or 6),
        Text = "",
        AutoButtonColor = false,
        Parent = holder,
    })
    Corner(track, 99)

    local fill = New("Frame", {
        BackgroundColor3 = config.FillColor or theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = track,
    })
    Corner(fill, 99)

    local knob = New("Frame", {
        BackgroundColor3 = config.KnobColor or theme.Paper,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(config.KnobSize or 14, config.KnobSize or 14),
        Parent = track,
    })
    Corner(knob, 99)
    CuteStroke(knob, theme.Accent, 0.1)

    local state = {
        Value = default,
        Locked = config.Locked or false,
        Dragging = false,
    }

    local obj = {
        __type = "Slider",
        UIElements = { Holder = holder, Title = title, Track = track, Fill = fill, Knob = knob, Value = valueLabel },
    }

    local function format(v)
        if config.Format then
            local ok, r = pcall(config.Format, v)
            if ok and r ~= nil then return tostring(r) end
        end
        if step < 1 then return string.format("%.2f", v) end
        return tostring(v)
    end

    local lastText = ""
    local function render()
        local range = max - min
        local ratio = range == 0 and 0 or clamp((state.Value - min) / range, 0, 1)
        Tween(fill, 0.18, { Size = UDim2.new(ratio, 0, 1, 0) }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(knob, 0.18, { Position = UDim2.new(ratio, 0, 0.5, 0) }, EASE_SOFT, Enum.EasingDirection.Out)

        local newText = (config.Prefix or "") .. format(state.Value) .. (config.Suffix or "")
        if newText ~= lastText then
            lastText = newText
            valueLabel.Text = newText
        end
    end

    function obj:Set(v, fire)
        state.Value = snap(tonumber(v) or state.Value)
        render()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    local function updateFromX(x)
        local width = math.max(1, track.AbsoluteSize.X)
        local ratio = clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        obj:Set(min + ((max - min) * ratio), true)
    end

    track.MouseEnter:Connect(function()
        Tween(knob, 0.22, {
            Size = UDim2.fromOffset((config.KnobSize or 11) + 3, (config.KnobSize or 11) + 3)
        }, EASE_OUT, Enum.EasingDirection.Out)
    end)
    track.MouseLeave:Connect(function()
        if not state.Dragging then
            Tween(knob, 0.28, {
                Size = UDim2.fromOffset(config.KnobSize or 11, config.KnobSize or 11)
            }, EASE_OUT, Enum.EasingDirection.Out)
        end
    end)

    track.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            state.Dragging = true
            Tween(knob, 0.2, {
                Size = UDim2.fromOffset((config.KnobSize or 11) + 4, (config.KnobSize or 11) + 4)
            }, EASE_OUT, Enum.EasingDirection.Out)
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not state.Dragging or state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if state.Dragging then
                state.Dragging = false
                Tween(knob, 0.28, {
                    Size = UDim2.fromOffset(config.KnobSize or 11, config.KnobSize or 11)
                }, EASE_OUT, Enum.EasingDirection.Out)
            end
        end
    end)

    AttachLockAPI(obj, state, track)
    render()
    return obj
end

