    function Window:ImportBlueprints(payload,replaceExisting)
        if self.Destroyed or not self.BlueprintEditor then return false,"Editor unavailable." end
        if type(payload)=="string" then
            if #payload>(self.Config.MaxBlueprintImportBytes or 2000000) then return false,"File too large." end
            local ok,decoded=pcall(function() return HttpService:JSONDecode(payload) end)
            if not ok then return false,"Invalid JSON." end; payload=decoded
        end
        if type(payload)=="table" and payload.Version==nil and payload.Blueprints==nil and (#payload>0 or next(payload)==nil) then payload={Version=1,Blueprints=payload} end
        if type(payload)~="table" or payload.Version~=1 or type(payload.Blueprints)~="table" then return false,"Invalid format or version." end
        local prepared,names={},{} ,{}
        if not replaceExisting then for _,r in ipairs(self.CustomBlueprints) do names[r.Name:lower()]=true end end
        local maxCount=self.Config.MaxBlueprints or 100
        if #payload.Blueprints+(replaceExisting and 0 or #self.CustomBlueprints)>maxCount then return false,"Too many blueprints." end
        for _,data in ipairs(payload.Blueprints) do
            if type(data)~="table" then return false,"Invalid blueprint." end
            local name,err=validName(data.Name); if not name then return false,err end
            if names[name:lower()] then return false,"Duplicate name: " .. name end; names[name:lower()]=true
            if type(data.Nodes)~="table" or type(data.Links)~="table" or #data.Nodes>(self.Config.MaxBlueprintNodes or 150) or #data.Links>2000 then return false,"Invalid or too large graph." end
            local nodes,ids,counter={}, {},0
            for _,n in ipairs(data.Nodes) do
                if type(n)~="table" or type(n.Id)~="string" or not n.Id:match("^node_%d+$") or ids[n.Id] or not Catalog[n.Type] then return false,"Unknown node or invalid id." end
                if type(n.X)~="number" or type(n.Y)~="number" or n.X~=n.X or n.Y~=n.Y or math.abs(n.X)>100000 or math.abs(n.Y)>100000 then return false,"Invalid position." end
                if n.Values~=nil and type(n.Values)~="table" then return false,"Invalid values." end
                local values={}
                for key,value in pairs(n.Values or {}) do
                    if type(key)~="string" or type(value)~="string" or #value>8192 then return false,"Invalid literal." end; values[key]=value
                end
                local settings={ Property="Name",ValueType="string" }
                if Catalog[n.Type].Dynamic then
                    if type(n.Settings)~="table" or type(n.Settings.Property)~="string" or not n.Settings.Property:match("^[%w_]+$") or type(n.Settings.ValueType)~="string" or #n.Settings.ValueType>80 then return false,"Invalid property configuration." end
                    settings={ Property=n.Settings.Property,ValueType=n.Settings.ValueType }
                end
                ids[n.Id]=true; counter=math.max(counter,tonumber(n.Id:sub(6)) or 0)
                table.insert(nodes,{ Id=n.Id,Type=n.Type,X=n.X,Y=n.Y,Values=values,Settings=settings })
            end
            local links={}
            for _,l in ipairs(data.Links) do
                if type(l)~="table" or not ids[l.From] or not ids[l.To] or type(l.Input)~="string" or type(l.Output)~="string" then return false,"Invalid connection." end
                table.insert(links,{ From=l.From,Output=l.Output,To=l.To,Input=l.Input })
            end
            local view={ X=30,Y=30,Zoom=0.85 }
            if type(data.View)=="table" then
                for _,key in ipairs({"X","Y","Zoom"}) do local v=data.View[key]; if type(v)=="number" and v==v and math.abs(v)<100000 then view[key]=v end end
                view.Zoom=clamp(view.Zoom,0.35,1.6)
            end
            local trial={ Id="__import__",Name=name,Nodes=nodes,Links=links,View=view,Window=self }
            self._blueprintsById[trial.Id]=trial
            local valid,errors,invalid=self:ValidateBlueprint(trial)
            self._blueprintsById[trial.Id]=nil
            -- Missing required inputs can be saved as an unfinished graph; bad links/cycles cannot.
            local structural=true
            for _,l in ipairs(links) do
                local a,b=nodeById(trial,l.From),nodeById(trial,l.To)
                local p,q=getPort(a,l.Output,"out"),getPort(b,l.Input,"in")
                if not p or not q or not compatible(p.Type,q.Type) then structural=false end
            end
            for _,message in ipairs(errors) do if message:find("Cycle",1,true) or message:find("more than one",1,true) then structural=false end end
            if not structural then return false,"Import contains invalid connections or cycles." end
            table.insert(prepared,{ Name=name,Nodes=nodes,Links=links,View=view,Counter=counter,Invalid=valid and nil or invalid })
        end
        self._loadingBlueprints=true
        if replaceExisting then
            if self.ActiveBlueprint then self:_LeaveBlueprintEditor() end
            for _,r in ipairs(self.CustomBlueprints) do self:StopBlueprint(r,true) end
            self.CustomBlueprints={}; self._blueprintsById={}
        end
        for _,data in ipairs(prepared) do
            local r=self:CreateBlueprint({ Name=data.Name,Empty=true,Open=false })
            r.Nodes,r.Links,r.View,r.Counter,r.Invalid=data.Nodes,data.Links,data.View,data.Counter,data.Invalid
        end
        self._loadingBlueprints=false; self:_RenderBlueprintRows()
        if self.CustomBlueprints[1] then self:_BlueprintChanged(self.CustomBlueprints[1],true) end
        return true
    end
