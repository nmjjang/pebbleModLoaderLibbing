    local window = self
    function modal:Close()
        if self.Closed then return end
        self.Closed = true
        if window._scriptModal == self then window._scriptModal = nil end
        if input:IsFocused() then input:ReleaseFocus() end
        overlay:Destroy()
    end
    function modal:Confirm()
        if self.Closed then return nil end
        local created, err
        if blueprint then
            if record then created, err = window:RenameBlueprint(record, input.Text)
            else created, err = window:CreateBlueprint({ Name = input.Text, Open = false }) end
        elseif record then created, err = window:RenameScript(record, input.Text)
        else created, err = window:CreateScript({ Name = input.Text, Open = false }) end
        if not created then
            errorLabel.Text = err or "Could not create the script."
            inputBorder.Color = window.Theme.Danger
            input:CaptureFocus()
            return nil, err
        end
        self:Close()
        if blueprint then window:OpenBlueprint(created) else window:OpenScript(created) end
        return created
    end
