function Section:Input(config)
    config = config or {}
    local window = self.Window
    local theme = window.Theme

    local compact = config.Compact
    if compact == nil then compact = window.Config.CompactControls ~= false end
    local holder = New("Frame", {
        Name = config.Title or "Input",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, config.Height or (compact and 28 or 50)),
        LayoutOrder = self:_nextOrder(),
        Parent = self.Content,
    })

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Input",
        TextColor3 = theme.Text,
        TextSize = config.TextSize or 12,
        Font = theme.Font,
        Size = compact and UDim2.new(0.4, -8, 1, 0) or UDim2.new(1, 0, 0, 18),
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = holder,
    })

    local box = New("TextBox", {
        BackgroundColor3 = config.BackgroundColor or theme.Input,
        BorderSizePixel = 0,
        ClearTextOnFocus = config.ClearOnFocus == true,
        PlaceholderText = config.Placeholder or "Type here...",
        PlaceholderColor3 = config.PlaceholderColor or theme.DimText,
        Text = tostring(config.Default or config.Value or ""),
        TextColor3 = config.InputTextColor or theme.Text,
        TextSize = config.InputTextSize or 11,
        Font = theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        AnchorPoint = compact and Vector2.new(1, 0.5) or Vector2.new(0, 0),
        Position = compact and UDim2.new(1, 0, 0.5, 0) or UDim2.fromOffset(0, 22),
        Size = UDim2.new(compact and 0.6 or 1, 0, 0, config.BoxHeight or 24),
        Parent = holder,
    })
    Corner(box, config.Corner or theme.ControlRadius)
    local inputStroke = FineStroke(box, theme.Border, 0.25)
    Padding(box, 8, 8, 0, 0)
    BindTheme(window, title, "Font", "Font")
    BindTheme(window, box, "Font", "Font")
    BindTheme(window, box, "TextColor3", "Text", config.InputTextColor)
    BindTheme(window, box, "PlaceholderColor3", "DimText", config.PlaceholderColor)
    BindTheme(window, box, "BackgroundColor3", "Input", config.BackgroundColor)
    BindTheme(window, inputStroke, "Color", "Border")

    box.Focused:Connect(function()
        Tween(box, 0.22, { BackgroundColor3 = config.FocusColor or theme.Surface2 }, EASE_OUT, Enum.EasingDirection.Out)
        Tween(inputStroke, 0.22, { Color = theme.Accent, Transparency = 0.05 }, EASE_SOFT, Enum.EasingDirection.Out)
    end)
    box.FocusLost:Connect(function()
        Tween(box, 0.25, { BackgroundColor3 = config.BackgroundColor or theme.Input }, EASE_OUT, Enum.EasingDirection.Out)
        Tween(inputStroke, 0.25, { Color = theme.Border, Transparency = 0.25 }, EASE_SOFT, Enum.EasingDirection.Out)
    end)

    local state = { Value = box.Text, Locked = config.Locked or false }
    local obj = { __type = "Input", UIElements = { Holder = holder, Title = title, Input = box } }

    function obj:Set(v, fire)
        state.Value = tostring(v or "")
        box.Text = state.Value
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    box.FocusLost:Connect(function(enter)
        if state.Locked then return end
        state.Value = box.Text
        safeCallback(config.Callback, state.Value, enter)
    end)

    local function renderLocked()
        box.TextEditable = not state.Locked
        if state.Locked and box:IsFocused() then box:ReleaseFocus() end
        title.TextColor3 = state.Locked and theme.MutedText or (config.TextColor or theme.Text)
        box.TextTransparency = state.Locked and 0.4 or 0
    end
    AttachLockAPI(obj, state, renderLocked)
    WatchTheme(window, holder, renderLocked)
    return obj
end

--============================================================
-- Keybind standalone
--============================================================

function Section:Keybind(config)
    config = config or {}
    local window = self.Window
    local theme = window.Theme
    local displayHeight = config.DisplayHeight or 22
    local displayRightPadding = config.DisplayRightPadding or 0
    local displayMinWidth = config.DisplayWidth or displayHeight
    local emptyText = config.Display or config.Text or "="
    local requestedReserve = config.RightReserve or 0
    config.RightReserve = math.max(requestedReserve, displayMinWidth + displayRightPadding + 10)

    local row, title, desc = MakeRow(self, config, RowHeight(config, math.max(26, displayHeight)))

    local display = New("TextButton", {
        Name = "StandaloneKeybind",
        BackgroundColor3 = config.KeyBackgroundColor or theme.Surface2,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        Text = emptyText,
        TextColor3 = config.KeyTextColor or theme.Accent,
        TextSize = config.KeyTextSize or 11,
        Font = config.KeyFont or theme.FontMedium,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -displayRightPadding, 0.5, 0),
        Size = UDim2.fromOffset(displayMinWidth, displayHeight),
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        AutoButtonColor = false,
        ZIndex = 8,
        Parent = row,
    })
    Corner(display, config.DisplayCorner or theme.ControlRadius)
    local displayStroke = FineStroke(display, config.KeyBorderColor or theme.Border, 0.55)

    local state = {
        Value = config.Value or config.Default or nil,
        Locked = config.Locked or false,
        Picking = false,
        Blacklist = config.Blacklist or { Enum.KeyCode.Escape },
    }

    local obj = { __type = "Keybind", UIElements = { Row = row, Title = title, Display = display, Border = displayStroke } }

    local hovered = false

    local function render()
        if state.Picking then
            display.Text = "..."
            display.TextColor3 = theme.Accent
        else
            display.Text = typeof(state.Value) == "EnumItem" and state.Value.Name or emptyText
            display.TextColor3 = config.KeyTextColor or theme.Accent
        end

        -- Keep short keys square; allow longer names to fit without overlapping the labels.
        local textBounds = TextService:GetTextSize(display.Text, display.TextSize,
            display.Font, Vector2.new(10000, displayHeight))
        local displayWidth = math.max(displayMinWidth, displayHeight, math.ceil(textBounds.X) + 12)
        display.Size = UDim2.fromOffset(displayWidth, displayHeight)
        local reserve = math.max(requestedReserve, displayWidth + displayRightPadding + 10)
        title.Size = UDim2.new(1, -(title.Position.X.Offset + reserve), title.Size.Y.Scale, title.Size.Y.Offset)
        if desc then
            desc.Size = UDim2.new(1, -(desc.Position.X.Offset + reserve), desc.Size.Y.Scale, desc.Size.Y.Offset)
        end

        local highlighted = state.Picking or (hovered and not state.Locked)
        display.BackgroundColor3 = highlighted and (config.KeyHoverColor or theme.SurfaceHover)
            or (config.KeyBackgroundColor or theme.Surface2)
        displayStroke.Transparency = highlighted and 0.18 or 0.55
    end

    display.MouseEnter:Connect(function()
        hovered = true
        render()
    end)
    display.MouseLeave:Connect(function()
        hovered = false
        render()
    end)

    function obj:Set(v, fire)
        state.Value = v
        render()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    display.MouseButton1Click:Connect(function()
        if state.Locked then return end
        state.Picking = true
        render()
    end)

    local conn
    conn = UserInputService.InputBegan:Connect(function(input, gp)
        if not row.Parent then conn:Disconnect() return end
        if not state.Picking or gp then return end
        local key = input.KeyCode
        if key == Enum.KeyCode.Unknown then return end
        state.Picking = false
        state.Value = key
        render()
        safeCallback(config.Callback, key)
    end)

    BindTheme(window, display, "Font", "FontMedium", config.KeyFont)
    BindTheme(window, displayStroke, "Color", "Border", config.KeyBorderColor)
    local function renderLocked()
        if state.Locked then state.Picking = false end
        render()
        title.TextColor3 = state.Locked and theme.MutedText or (config.TextColor or theme.Text)
        display.TextTransparency = state.Locked and 0.45 or 0
    end
    AttachLockAPI(obj, state, renderLocked)
    WatchTheme(window, row, renderLocked)
    render()
    return obj
end

