-- Intro cinematica: fundo limpo, marca, letras e progresso.
-- A interface real ja esta construida sob a cobertura.
local function PlayStartupIntro(window)
    local config = window.Config
    if config.Loading == false then return end
    local main = window.Main
    local theme = window.Theme
    local duration = math.max(0.15, tonumber(config.LoadingDuration) or 2.4)
    local introFadeDuration = math.max(0.08, tonumber(config.LoadingIntroFadeDuration) or 0.35)
    local titleText = tostring(config.LoadingTitle or window.Title)
    local iconName = config.LoadingIcon or "cat"

    local cover = New("CanvasGroup", {
        Name = "StartupIntro",
        BackgroundColor3 = theme.BackgroundTop,
        BackgroundTransparency = 0, -- Fundo opaco desde o primeiro frame, sem preview da UI.
        BorderSizePixel = 0,
        AnchorPoint = main.AnchorPoint,
        Position = main.Position,
        Size = main.Size,
        GroupTransparency = 0,
        ZIndex = 10000,
        Active = true,
        Parent = window.ScreenGui,
    })
    Corner(cover, config.CornerRadius or Defaults.CornerRadius)
    window.LoadingOverlay = cover
    local notifiedLoaded = false
    local function notifyLoaded()
        if notifiedLoaded then return end
        notifiedLoaded = true
        safeCallback(config.OnLoaded, window)
    end

    -- Fail-safe: nenhuma animação pode deixar um painel preto preso.
    local maxIntroSeconds = math.max(5, duration + introFadeDuration + 5)
    task.delay(maxIntroSeconds, function()
        if not cover.Parent then return end
        warn("[PebbleUI] Intro timed out; restoring window visibility.")
        cover:Destroy()
        if window.LoadingOverlay == cover then window.LoadingOverlay = nil end
        if main.Parent and window.Visible then main.Visible = true end
        notifyLoaded()
    end)

    local stack = New("Frame", {
        Name = "Identity", BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.47),
        Size = UDim2.new(1, -30, 0, 126),
        ZIndex = 10001, Parent = cover,
    })
    -- Animar um contêiner separado evita conflitos com o ImageLabel do Lucide.
    local logoHolder = New("CanvasGroup", {
        Name = "LoadingCatMotion",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 48),
        Size = UDim2.fromOffset(43, 43),
        GroupTransparency = 1,
        ZIndex = 10002,
        Parent = stack,
    })
    local logo = CreateIcon(iconName, 43, theme.Text, 10003)
    logo.Name = "LoadingCat"
    logo.Position = UDim2.fromOffset(0, 0)
    logo.ImageTransparency = 0
    logo.Parent = logoHolder

    local letters = New("Frame", {
        Name = "Letters", BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56),
        Size = UDim2.new(1, 0, 0, 34), ZIndex = 10002, Parent = stack,
    })
    local letterLayout = New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 0), Parent = letters,
    })
    local glyphs = {}
    local utf = {}
    for _, codepoint in utf8.codes(titleText) do
        table.insert(utf, utf8.char(codepoint))
    end
    if #utf > 32 then
        utf = { table.unpack(utf, 1, 32) }
    end
    local font = theme.FontDisplay or Enum.Font.GothamBold
    for index, char in ipairs(utf) do
        local measured = TextService:GetTextSize(char, 23, font, Vector2.new(100, 40))
        local glyph = New("TextLabel", {
            Name = "Glyph" .. index, BackgroundTransparency = 1,
            Text = char, Font = font, TextSize = 23,
            TextColor3 = theme.Text, TextTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Center,
            Size = UDim2.fromOffset(math.max(char == " " and 7 or 2, measured.X + 1), 34),
            LayoutOrder = index, ZIndex = 10002, Parent = letters,
        })
        table.insert(glyphs, glyph)
    end

    local track = New("Frame", {
        Name = "LoadingTrack", AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 111),
        Size = UDim2.fromOffset(170, 3),
        BackgroundColor3 = theme.SliderTrack,
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ClipsDescendants = true, ZIndex = 10002, Parent = stack,
    })
    Corner(track, 99)
    local fill = New("Frame", {
        Name = "LoadingFill", Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = theme.Accent, BackgroundTransparency = 0,
        BorderSizePixel = 0, ZIndex = 10003, Parent = track,
    })
    Corner(fill, 99)

    task.spawn(function()
        if not cover.Parent then return end

        -- A ScreenGui ja foi ativada, mas aguardamos a primeira renderizacao.
        while cover.Parent and not window.ScreenGui.Enabled do
            RunService.RenderStepped:Wait()
        end
        if not cover.Parent then return end
        RunService.RenderStepped:Wait()

        -- Fundo ja esta opaco antes da ScreenGui ser exibida.
        -- Pequena pausa preserva o ritmo do loading sem revelar a UI.
        task.wait(introFadeDuration)
        if not cover.Parent then return end

        -- Preload evita que o icon apareca no meio do slide por atraso da textura.
        if logo.Image ~= "" then
            local loaded = false
            task.spawn(function()
                pcall(function()
                    game:GetService("ContentProvider"):PreloadAsync({logo})
                end)
                loaded = true
            end)
            local startedAt = os.clock()
            while not loaded and os.clock() - startedAt < 3 and cover.Parent do
                RunService.RenderStepped:Wait()
            end
        end
        if not cover.Parent then return end
        RunService.RenderStepped:Wait()

        -- Slide-up claro: o holder percorre 48px e revela a imagem ao mesmo tempo.
        local rise = Tween(logoHolder, 0.45, {
            Position = UDim2.new(0.5, 0, 0, 0),
            GroupTransparency = 0,
        }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        rise.Completed:Wait()
        if not cover.Parent then return end
        task.wait(0.07)
        local stepTime = math.min(0.075, 0.62 / math.max(#glyphs, 1))
        for _, glyph in ipairs(glyphs) do
            if not cover.Parent then return end
            Tween(glyph, 0.25, { TextTransparency = 0 }, EASE_SOFT)
            task.wait(stepTime)
        end
        task.wait(0.14)
        if not cover.Parent then return end
        Tween(track, 0.28, { BackgroundTransparency = 0 }, EASE_SOFT)
        task.wait(0.12)
        local progress = Tween(fill, duration, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Sine)
        progress.Completed:Wait()
        if not cover.Parent then return end
        task.wait(0.12)
        -- O conteudo principal so pode ser renderizado a partir daqui.
        local mainScale = EnsureScale(main)
        mainScale.Scale = 0.985
        main.Visible = true
        Tween(mainScale, 0.65, { Scale = 1 }, EASE_SOFT)
        local fade = Tween(cover, 0.58, { GroupTransparency = 1 }, EASE_SOFT)
        fade.Completed:Wait()
        if cover.Parent then cover:Destroy() end
        if window.LoadingOverlay == cover then window.LoadingOverlay = nil end
        notifyLoaded()
    end)
end

-- Register existing and future standard stateful widgets without editing each factory.
for _,kind in ipairs({"Checkbox","Slider","Input","Dropdown","Colorpicker","Keybind"}) do
    local original=Section[kind]
    if original then
        Section[kind]=function(section,config,...)
            local obj=original(section,config,...)
            return section.Window:_PersistControl(kind,config or {},obj)
        end
    end
end

function PebbleUI:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, Window)

    self.Config = config
    self._persistEnabled = config.AutoSave ~= false and type(writefile)=="function" and type(readfile)=="function"
    self._persistPath = PersistFileName(config)
    self._persistState = self._persistEnabled and PersistLoad(self._persistPath) or {controls={}}
    local saved = self._persistState
    self.Theme = merge(DefaultTheme, config.Theme or {})
    if self._persistEnabled and type(saved.theme)=="table" then self.Theme=merge(self.Theme,PersistDecode(saved.theme)) end
    if config.SelectColor then self.Theme.Accent = config.SelectColor end

    self.Title = config.Title or Defaults.Title
    self.Tabs = {}
    self.Notifications = {}
    self.ActiveTab = nil
    self.ActiveDropdown = nil
    self.ActiveColorpicker = nil
    self.SidebarOrder = 0
    self.Visible = true
    self.Destroyed = false
    self._themeBindings = {}
    self._ownedConnections = {}
    self._themeRenderers = {}
    self.CustomScripts = {}
    self._scriptsById = {}
    self._scriptCounter = 0
    self._scriptConnections = {}
    self._scriptSelectionRects = {}
    self.CustomBlueprints = {}
    self._blueprintsById = {}
    self._blueprintConnections = {}

    -- Fundo principal sempre opaco.
    self.BackgroundTransparency = clamp01((self._persistEnabled and tonumber(saved.opacity)) or 0)

    local size = (self._persistEnabled and saved.size and PersistDecode(saved.size)) or config.Size or Defaults.Size
    if not (self._persistEnabled and saved.size) and config.Layout ~= "Studio" and config.ScriptExplorer ~= false and config.ExpandWindowForScripts ~= false then
        local width = size.X.Offset + (config.ScriptExplorerWidth or 192) + 12
        if size.X.Scale == 0 then width = math.min(width, (config.MaxSize or Defaults.MaxSize).X) end
        size = UDim2.new(size.X.Scale, width, size.Y.Scale, size.Y.Offset)
    end
    if config.Layout == nil then config.Layout = "Studio" end
    local studio = config.Layout == "Studio"
    local sidebarWidth = studio and 0 or (config.SidebarWidth or Defaults.SidebarWidth)
    local topHeight = studio and (config.StudioHeaderHeight or Defaults.StudioHeaderHeight) or (config.TopbarHeight or Defaults.TopbarHeight)
    local corner = (self._persistEnabled and saved.corner) or config.CornerRadius or Defaults.CornerRadius
    self.SidebarWidth = sidebarWidth
    self.TopbarHeight = topHeight

    local guiName = config.Name or ("PebbleUI_" .. tostring(math.random(100000, 999999)))
    local foundCore, existing = pcall(function() return CoreGui:FindFirstChild(guiName) end)
    if foundCore and existing then existing:Destroy() end
    local existingPlayerGui = PlayerGui:FindFirstChild(guiName)
    if existingPlayerGui then existingPlayerGui:Destroy() end

    local screen = New("ScreenGui", {
        Name = guiName,
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Enabled = false, -- Construir completamente antes de exibir.
    })
    local ok = pcall(function() screen.Parent = CoreGui end)
    if not ok then screen.Parent = PlayerGui end
    self.ScreenGui = screen

    local main = New("Frame", {
        Name = "Main",
        Visible = config.Loading == false, -- Escondida ate o loading terminar.
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = (self._persistEnabled and saved.position and PersistDecode(saved.position)) or config.Position or Defaults.Position,
        Size = size,
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = self.BackgroundTransparency,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 2,
        Parent = screen,
    })
    Corner(main, corner)
    local mainStroke = FineStroke(main, self.Theme.Stroke, 0.08)
    BindTheme(self, mainStroke, "Color", "Stroke")
    self.Main = main

    -- Background ImageLabel under all interface controls; keeps Main as Frame
    -- to avoid breaking resize, drag and other code that depends on it.
    local backgroundImage = New("ImageLabel", {
        Name = "CustomBackgroundImage",
        Size = UDim2.fromScale(1, 1),
        Position = UDim2.fromScale(0, 0),
        BackgroundTransparency = 1,
        Image = "",
        ImageTransparency = self.BackgroundTransparency,
        ScaleType = Enum.ScaleType.Crop,
        Visible = false,
        ZIndex = 0,
        Parent = main,
    })
    self.BackgroundImage = backgroundImage
    -- Match window roundify independently; Main.ClipsDescendants protects the edges.
    local backgroundImageCorner = Corner(backgroundImage, corner)
    self.BackgroundImageCorner = backgroundImageCorner

    -- Theme-colored layer above the custom image, below the window's controls.
    -- Strength 0: original image; strength 1: theme background colors.
    self.BackgroundStrength = (self._persistEnabled and tonumber(saved.strength)) or 0
    local backgroundTint = New("Frame", {
        Name = "CustomBackgroundTint",
        Position = UDim2.fromScale(0, 0),
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = self.Theme.BackgroundTop,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 1,
        Parent = main,
    })
    self.BackgroundTint = backgroundTint
    local tintCorner = Corner(backgroundTint, corner)
    self.BackgroundTintCorner = tintCorner
    local tintGradient = New("UIGradient", {
        Color = ColorSequence.new(self.Theme.BackgroundTop, self.Theme.BackgroundBottom),
        Rotation = 90,
        Parent = backgroundTint,
    })
    WatchTheme(self, backgroundTint, function()
        backgroundTint.BackgroundColor3 = self.Theme.BackgroundTop
        tintGradient.Color = ColorSequence.new(self.Theme.BackgroundTop, self.Theme.BackgroundBottom)
    end)
    function self:SetBackgroundStrength(strength)
        self.BackgroundStrength = clamp01(strength)
        self:_PersistSoon()
        if self.BackgroundTint then
            self.BackgroundTint.BackgroundTransparency = 1 - self.BackgroundStrength * (1 - self.BackgroundTransparency)
        end
        return self
    end
    function self:SetBackgroundImage(asset)
        if self.Destroyed or not self.Main then return false end
        if type(asset) == "string" and asset ~= "" then
            self.BackgroundImage.Image = asset
            self.BackgroundImage.Visible = true
            self.BackgroundTint.Visible = true
            self.BackgroundTint.BackgroundTransparency = 1 - self.BackgroundStrength * (1 - self.BackgroundTransparency)
            self.BackgroundImage.ImageTransparency = self.BackgroundTransparency
            self.Main.BackgroundTransparency = 1
        else
            self.BackgroundImage.Visible = false
            self.BackgroundTint.Visible = false
            self.BackgroundImage.Image = ""
            self.Main.BackgroundTransparency = self.BackgroundTransparency
        end
        self:_PersistSoon()
        return true
    end

