    function Window:_LayoutBlueprintExplorer()
        if not self.BlueprintExplorerUI or not self.ScriptExplorerElements then return end
        local ui, scripts = self.BlueprintExplorerUI, self.ScriptExplorerElements
        local compact = self.Config.Layout == "Studio"
        local height = self.ScriptExplorer.AbsoluteSize.Y
        if compact then
            -- Content-sized tree: no proportional empty space between folders.
            local top = 78 + (self.Config.ExplorerHeaderOffset or 44)
            local available = math.max(90, height - top - 196)
            local scriptsCount = #self.CustomScripts
            local blueprintsCount = #self.CustomBlueprints
            local scriptWanted = self._scriptsCollapsed and 0 or (scriptsCount == 0 and 46 or scriptsCount * 31 + 2)
            local blueprintWanted = self._blueprintsCollapsed and 0 or (blueprintsCount == 0 and 48 or blueprintsCount * 31 + 2)
            local fixed = 24 + 7 + 27 + 8 + 26
            local remaining = math.max(45, available - fixed)
            local scriptHeight = math.min(scriptWanted, remaining)
            local blueprintHeight = math.min(blueprintWanted, math.max(0, remaining - scriptHeight))
            if blueprintWanted > 0 and blueprintHeight < math.min(48, blueprintWanted) and scriptHeight > 48 then
                local transfer = math.min(scriptHeight - 48, math.min(48, blueprintWanted) - blueprintHeight)
                scriptHeight -= transfer
                blueprintHeight += transfer
            end
            scripts.List.Position = UDim2.fromOffset(8, top)
            scripts.List.Size = UDim2.new(1, -16, 0, scriptHeight)
            scripts.List.Visible = not self._scriptsCollapsed and not self._explorerCollapsed
            scripts.Empty.Position = UDim2.fromOffset(18, top + 5)
            scripts.Empty.Size = UDim2.new(1, -36, 0, math.min(42, scriptHeight))
            scripts.Empty.Visible = scriptsCount == 0 and not self._scriptsCollapsed and not self._explorerCollapsed
            local folderY = top + scriptHeight + 7
            ui.Folder.Position = UDim2.fromOffset(8, folderY)
            ui.Folder.Visible = not self._explorerCollapsed
            ui.List.Position = UDim2.fromOffset(8, folderY + 27)
            ui.List.Size = UDim2.new(1, -16, 0, blueprintHeight)
            ui.List.Visible = not self._blueprintsCollapsed and not self._explorerCollapsed
            ui.Empty.Position = UDim2.fromOffset(18, folderY + 32)
            ui.Empty.Size = UDim2.new(1, -36, 0, math.min(44, blueprintHeight))
            ui.Empty.Visible = blueprintsCount == 0 and not self._blueprintsCollapsed and not self._explorerCollapsed
            local footerY = folderY + 27 + blueprintHeight + 8
            scripts.FooterLine.Position = UDim2.fromOffset(8, footerY)
            scripts.Count.Position = UDim2.fromOffset(12, footerY + 3)
            scripts.Count.Size = UDim2.new(1, -24, 0, 23)
        else
            local explorerOffset = self.Config.ExplorerHeaderOffset or 44
            local room = math.max(90, height - 274 - explorerOffset)
            local scriptsHeight = self._scriptsCollapsed and 0 or math.floor(room * 0.46)
            local y = 80 + explorerOffset + scriptsHeight + 8
