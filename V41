    local function safeInstance(obj)
        assert(typeof(obj) == "Instance", "An object reference is required.")
        assert(not obj:IsA("Script") and not obj:IsA("RemoteEvent")
            and not obj:IsA("RemoteFunction") and not obj:IsA("UnreliableRemoteEvent"), "Object unavailable in the local editor.")
        assert(not obj:IsA("ServerStorage") and not obj:IsA("ServerScriptService"), "Server-only service.")
        local parent = obj
        while parent do
            assert(parent.Name ~= "ServerStorage" and parent.Name ~= "ServerScriptService", "Server-only object.")
            parent = parent.Parent
        end
        return obj
    end
