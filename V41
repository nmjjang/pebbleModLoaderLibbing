    local function validName(name)
        if type(name) ~= "string" then return nil, "Enter a name." end
        name = name:match("^%s*(.-)%s*$"):gsub("%.blueprint$", ""):gsub("%.bp$", "")
        if name == "" or #name > 60 or name:find("[%c/\\]") then return nil, "Use a short name without slashes or line breaks." end
        return name .. ".bp"
    end
    function Window:GetBlueprint(id)
        if type(id) == "table" then return id.Window == self and self._blueprintsById[id.Id] or nil end
        for _, r in ipairs(self.CustomBlueprints or {}) do if r.Id == id or r.Name == id then return r end end
    end
    function Window:GetBlueprints()
        local out = {}
        for _, record in ipairs(self.CustomBlueprints or {}) do table.insert(out, snapshot(record)) end
        return out
    end
    function Window:GetBlueprintCatalog()
        local out = {}
        for _, def in pairs(Catalog) do table.insert(out, { Id = def.Id, Title = def.Title, Category = def.Category, Description = def.Description }) end
        table.sort(out, function(a,b) return a.Title < b.Title end)
        return out
    end
    function Window:ExportBlueprints()
        return HttpService:JSONEncode({ Version = 1, Blueprints = self:GetBlueprints() })
    end
    function Window:SaveBlueprints()
        if not self._blueprintsDirty then return true end
        if self._blueprintStorageBlocked then return false, "Previous load failed; export a copy before saving." end
        local ok, result = true, nil
        if type(self.Config.SaveBlueprints) == "function" then ok, result = pcall(self.Config.SaveBlueprints, self:GetBlueprints(), self)
        elseif self._blueprintStorageFile and type(writefile) == "function" then ok, result = pcall(writefile, self._blueprintStorageFile, self:ExportBlueprints()) end
        if not ok or result == false then self:_BlueprintNotice("Could not save: " .. tostring(result), true); return false, result end
        self._blueprintsDirty = false
        for _, r in ipairs(self.CustomBlueprints) do r.Dirty = false end
        self:_RenderBlueprintRows()
        self:_BlueprintStatus(self._hasBlueprintStorage and "Saved" or "Saved in this window · export to keep it")
        safeCallback(self.Config.OnBlueprintsChanged, self:GetBlueprints(), self)
        return true
    end
    function Window:_BlueprintChanged(record, saveOnly)
        if not record then return end
        record.Dirty = true
        if not saveOnly then
            record.Revision = (record.Revision or 0) + 1
            if record.Runtime then self:StopBlueprint(record, true) end
            local _, _, invalid = self:ValidateBlueprint(record)
            record.Invalid = invalid
        end
        self._blueprintsDirty = true
        self._blueprintSaveRevision = (self._blueprintSaveRevision or 0) + 1
        self:_RenderBlueprintRows()
        if self._loadingBlueprints then return end
        local revision = self._blueprintSaveRevision
        task.delay(0.6, function()
            if not self.Destroyed and self._blueprintSaveRevision == revision then self:SaveBlueprints() end
        end)
    end
    function Window:CreateBlueprint(config)
        if self.Destroyed or not self.BlueprintEditor then return nil, "Editor unavailable." end
        config = type(config) == "string" and { Name = config } or (config or {})
        local name, err = validName(config.Name or "Blueprint")
        if not name then return nil, err end
        for _, r in ipairs(self.CustomBlueprints) do if r.Name:lower() == name:lower() then return nil, "A blueprint with that name already exists." end end
        if #self.CustomBlueprints >= (self.Config.MaxBlueprints or 100) then return nil, "Blueprint limit reached." end
        self._blueprintCounter = self._blueprintCounter + 1
        local id = "blueprint_" .. self._blueprintCounter
        while self._blueprintsById[id] do self._blueprintCounter = self._blueprintCounter + 1; id = "blueprint_" .. self._blueprintCounter end
        local record = { Id = id, Name = name, Window = self, Nodes = {}, Links = {}, View = { X = 30, Y = 30, Zoom = 0.85 }, Revision = 0, Counter = 0 }
        function record:Open() return self.Window:OpenBlueprint(self) end
        function record:AddNode(kind, pos, values) return self.Window:AddBlueprintNode(self, kind, pos, values) end
        function record:Connect(a, output, b, input) return self.Window:ConnectBlueprint(self, a, output, b, input) end
        function record:Run() return self.Window:RunBlueprint(self) end
        function record:Stop() return self.Window:StopBlueprint(self) end
        function record:Delete() return self.Window:DeleteBlueprint(self) end
        function record:Rename(newName) return self.Window:RenameBlueprint(self, newName) end
        table.insert(self.CustomBlueprints, record); self._blueprintsById[id] = record
        if config.Empty ~= true then
            local start = self:AddBlueprintNode(record, "Start", { X = 0, Y = 40 })
            local notify = self:AddBlueprintNode(record, "Notify", { X = 320, Y = 40 })
            self:ConnectBlueprint(record, start.Id, "Exec", notify.Id, "Exec")
        end
        self:_BlueprintChanged(record)
        if config.Open ~= false then self:OpenBlueprint(record) end
        return record
    end
    function Window:RenameBlueprint(id, newName)
        local r = self:GetBlueprint(id); if not r then return nil, "Blueprint not found." end
        local name, err = validName(newName); if not name then return nil, err end
        for _, other in ipairs(self.CustomBlueprints) do if other ~= r and other.Name:lower() == name:lower() then return nil, "Name already used." end end
        r.Name = name; self:_BlueprintChanged(r, true)
        if self.ActiveBlueprint == r then self.BlueprintUI.Title.Text = name end
        return r
    end
    function Window:DeleteBlueprint(id)
        local r = self:GetBlueprint(id); if not r then return false end
        self:StopBlueprint(r, true)
        if self.ActiveBlueprint == r then self:CloseBlueprintEditor() end
        for i, item in ipairs(self.CustomBlueprints) do if item == r then table.remove(self.CustomBlueprints, i); break end end
        self._blueprintsById[r.Id] = nil
        self:_BlueprintChanged(r, true)
        return true
    end
    function Window:AddBlueprintNode(id, kind, position, values)
        local r = self:GetBlueprint(id)
        if not r or not Catalog[kind] then return nil, "Unknown node." end
        if #r.Nodes >= (self.Config.MaxBlueprintNodes or 150) then return nil, "Node limit reached." end
        r.Counter = r.Counter + 1
        local node = { Id = "node_" .. r.Counter, Type = kind, X = tonumber(position and position.X) or 0, Y = tonumber(position and position.Y) or 0, Values = copyTable(values or {}), Settings = {} }
        if Catalog[kind].Dynamic then node.Settings = { Property = kind == "Cast" and "Part" or "Name", ValueType = "string" } end
        table.insert(r.Nodes, node); self:_BlueprintChanged(r)
        if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end
        return node
    end
    function Window:DeleteBlueprintNode(id, nodeId)
        local r = self:GetBlueprint(id); if not r then return false end
        for i = #r.Nodes, 1, -1 do if r.Nodes[i].Id == nodeId then table.remove(r.Nodes, i) end end
        for i = #r.Links, 1, -1 do if r.Links[i].From == nodeId or r.Links[i].To == nodeId then table.remove(r.Links, i) end end
        self._bpSelection = nil; self:_BlueprintChanged(r)
        if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end
        return true
    end
    function Window:ConnectBlueprint(id, a, output, b, input)
        local r = self:GetBlueprint(id); if not r then return false, "Blueprint not found." end
        local source, target = nodeById(r,a), nodeById(r,b)
        local p, q = source and getPort(source,output,"out"), target and getPort(target,input,"in")
        if a == b or not p or not q then return false, "Invalid ports." end
        if not compatible(p.Type,q.Type) then return false, "Incompatible: " .. p.Type .. " → " .. q.Type end
        -- Adding a -> b must not find a path from b back to a.
        local visited = {}
        local function reaches(id)
            if id == a then return true end
            if visited[id] then return false end; visited[id] = true
            for _, link in ipairs(r.Links) do
                if link.From == id and not (link.To == b and link.Input == input) and reaches(link.To) then return true end
            end
            return false
        end
        if reaches(b) then return false, "This connection would create a cycle." end
        for i = #r.Links,1,-1 do if r.Links[i].To == b and r.Links[i].Input == input then table.remove(r.Links,i) end end
        table.insert(r.Links, { From = a, Output = output, To = b, Input = input })
        self:_BlueprintChanged(r)
        if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end
        return true
    end
    function Window:DisconnectBlueprint(id, nodeId, input)
        local r = self:GetBlueprint(id); if not r then return false end
        for i = #r.Links,1,-1 do if r.Links[i].To == nodeId and r.Links[i].Input == input then table.remove(r.Links,i) end end
        self:_BlueprintChanged(r)
        if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end
        return true
    end
    function Window:ValidateBlueprint(id)
        local r = self:GetBlueprint(id); if not r then return false, { "Blueprint not found." }, {} end
        local errors, invalid, seen, targets = {}, {}, {}, {}
        local function issue(nodeId,msg) invalid[nodeId] = true; table.insert(errors,msg) end
        for _, n in ipairs(r.Nodes) do
            local def = definition(n)
            if seen[n.Id] then issue(n.Id,"Duplicate id: " .. n.Id) end; seen[n.Id] = true
            if not def then issue(n.Id,"Unknown node: " .. n.Type)
            elseif def.Disabled then issue(n.Id,def.Title .. ": " .. def.Disabled)
            else
                for _, p in ipairs(def.Inputs) do
                    local link = incoming(r,n.Id,p.Name)
                    if not link and p.Type ~= "Exec" then
                        local raw = n.Values[p.Name]; if raw == nil then raw = p.Default end
                        if p.Required and (raw == nil or raw == "") then issue(n.Id,def.Title .. ": connect " .. p.Name)
                        elseif (raw ~= nil and (raw ~= "" or acceptsLiteral(p.Type))) or p.Type == "string" or p.Type == "any" then
                            local ok, err = pcall(parseValue,raw,p.Type)
                            if not ok then issue(n.Id,def.Title .. "." .. p.Name .. ": " .. tostring(err)) end
                        end
                    end
                end
                if def.Dynamic and (not n.Settings or type(n.Settings.Property) ~= "string" or not n.Settings.Property:match("^[%w_]+$")) then issue(n.Id,"Invalid property name.") end
            end
        end
        for _, l in ipairs(r.Links) do
            local a,b = nodeById(r,l.From),nodeById(r,l.To)
            local p,q = a and getPort(a,l.Output,"out"), b and getPort(b,l.Input,"in")
            local key = l.To .. ":" .. l.Input
            if targets[key] then issue(l.To,"Input with more than one connection: " .. key) end; targets[key] = true
            if not p or not q or not compatible(p.Type,q.Type) then issue(l.To,"Invalid connection: " .. l.Output .. " → " .. l.Input) end
            if p and q and p.Type == "Exec" and q.Type == "Exec" and l.From == l.To then
                issue(l.To, "A node cannot execute itself.")
            end
        end
        local state = {}
        local function visit(id)
            if state[id] == 1 then issue(id,"Cycle found in the graph."); return end
            if state[id] == 2 then return end
            state[id] = 1
            for _, l in ipairs(r.Links) do if l.To == id and seen[l.From] then visit(l.From) end end
            state[id] = 2
        end
        for _, n in ipairs(r.Nodes) do visit(n.Id) end
        return #errors == 0, errors, invalid
    end
    function Window:StopBlueprint(id, quiet)
        local r = self:GetBlueprint(id or self.ActiveBlueprint); if not r or not r.Runtime then return true end
        local runtime = r.Runtime; runtime.Cancelled = true
        if runtime.Thread and coroutine.status(runtime.Thread) ~= "dead" and runtime.Thread ~= coroutine.running() then pcall(task.cancel,runtime.Thread) end
        for i = #runtime.Undo,1,-1 do pcall(runtime.Undo[i]) end
        for i = #runtime.Created,1,-1 do pcall(function() runtime.Created[i]:Destroy() end) end
        r.Runtime = nil
        if not quiet then self:_BlueprintStatus("Stopped · created objects and local changes removed") end
        return true
    end
    function Window:RunBlueprint(id)
        local r = self:GetBlueprint(id or self.ActiveBlueprint); if not r then return false,"Blueprint not found." end
        if self.ActiveBlueprint == r and self._bpPending then self:_BlueprintNotice("Finish the pending connection or press Esc before running.",true); return false,"Pending connection." end
        if self.Config.AllowBlueprintExecution == false then self:_BlueprintNotice("Execution disabled.",true); return false,"Execution disabled." end
        local valid, errors, invalid = self:ValidateBlueprint(r)
        r.Invalid = invalid
        if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end
        if not valid then warn("[PebbleUI Blueprint] Validation: " .. tostring(errors[1])); self:_BlueprintNotice(errors[1],true); return false,errors end
        self:StopBlueprint(r,true)
        local rt = { Created = {}, Undo = {}, Values = {}, Projected = {}, Assigned = {}, Cancelled = false, Revision = r.Revision }
        r.Runtime = rt
        self:_BlueprintStatus("Validating properties...")
        -- Preflight creates objects detached; all data and property checks run before any commit.
        rt.Thread = task.spawn(function()
            local operations, parents = {}, {}
            local currentNode
            local function check() assert(not rt.Cancelled and not self.Destroyed and rt.Revision == r.Revision,"Execution cancelled.") end
            local function plannedValue(obj,name)
                if rt.Assigned[obj] and rt.Assigned[obj][name] then return rt.Projected[obj][name] end
                return obj[name]
            end
            local eval
            local function resolve(node,p)
                local link = incoming(r,node.Id,p.Name)
                if link then
                    local sourceNode = nodeById(r, link.From)
                    assert(sourceNode, "Missing source node for " .. p.Name)
                    local value = eval(sourceNode)[link.Output]
                    if p.Required then assert(value ~= nil,"Missing reference on " .. p.Name) end
                    if value ~= nil and p.Type:match("^Class:") then assert(typeof(value)=="Instance" and value:IsA(p.Type:sub(7)),"Incompatible class on " .. p.Name) end
                    return value
                end
                local raw = node.Values[p.Name]; if raw == nil then raw = p.Default end
                if raw == nil or (raw == "" and not acceptsLiteral(p.Type)) then return nil end
                return parseValue(raw,p.Type)
            end
            local function validateProperty(obj,name,value)
                safeInstance(obj)
                assert(name:match("^[%w_]+$") and name ~= "Source" and name ~= "Capabilities" and name ~= "Sandboxed", "Property blocked.")
                local old = obj[name]
                if old ~= nil and value ~= nil then
                    local kind = fieldType(old)
                    assert(compatible(fieldType(value),kind), "Invalid type on " .. obj.ClassName .. "." .. name .. ": " .. kind)
                end
                if name == "Parent" and value then safeInstance(value) end
                return old
            end
            eval = function(node)
                check(); assert(node,"Missing node.")
                if rt.Values[node.Id] then return rt.Values[node.Id] end
                currentNode = node.Id
                local def, values, out = definition(node), {}, { Exec = true }
                for _, p in ipairs(def.Inputs) do
                    if p.Type ~= "Exec" then values[p.Name] = resolve(node,p) end
                end
                currentNode = node.Id
                if def.Class then
                    local obj = def.Service and game:GetService(def.Class) or Instance.new(def.Class)
                    if not def.Service then table.insert(rt.Created,obj) end
                    safeInstance(obj)
                    for _, p in ipairs(def.Inputs) do
                        if p.Property then
                            local value = values[p.Name]
                            -- Empty defaults leave complex Roblox properties unchanged.
                            local supplied = node.Values[p.Name] ~= nil or incoming(r,node.Id,p.Name) ~= nil
                            if supplied and (value ~= nil or p.Type == "Instance") then
                                local old = validateProperty(obj,p.Name,value)
                                rt.Projected[obj] = rt.Projected[obj] or {}; rt.Projected[obj][p.Name] = value
                                rt.Assigned[obj] = rt.Assigned[obj] or {}; rt.Assigned[obj][p.Name] = true
                                if not def.Service and p.Name ~= "Parent" then obj[p.Name] = value
                                else
                                    local target, name, nextValue, previous = obj,p.Name,value,old
                                    local op = function()
                                        check(); target[name] = nextValue
                                        table.insert(rt.Undo,function() target[name] = previous end)
                                    end
                                    if p.Name == "Parent" then table.insert(parents,op) else table.insert(operations,op) end
                                end
                            end
                        end
                    end
                    out.Object = obj
                    for _, p in ipairs(def.Outputs) do if p.Property then
                        out[p.Name] = plannedValue(obj,p.Name)
                    end end
                elseif def.Ref then
                    local obj
                    if def.Ref == "LocalPlayer" then obj = LocalPlayer
                    elseif def.Ref == "PlayerGui" then obj = PlayerGui
                    elseif def.Ref == "Character" then obj = LocalPlayer.Character
                    elseif def.Ref == "CurrentCamera" then obj = workspace.CurrentCamera
                    else obj = LocalPlayer:FindFirstChild(def.Ref) end
                    assert(obj,"Unavailable reference: " .. def.Ref); out.Object = safeInstance(obj)
                    for _, p in ipairs(def.Outputs) do if p.Property then out[p.Name] = obj[p.Name] end end
                elseif def.Literal then out.Value = values.Value
                elseif node.Type == "FindChild" then
                    out.Object = safeInstance(values.Parent):FindFirstChild(values.Name,values.Recursive)
                    assert(out.Object,"Object not found: " .. values.Name); safeInstance(out.Object)
                elseif node.Type == "GetProperty" then
                    local obj = safeInstance(values.Object)
                    validateProperty(obj,node.Settings.Property,nil)
                    out.Value = plannedValue(obj,node.Settings.Property)
                    assert(compatible(fieldType(out.Value),node.Settings.ValueType),"Read type differs from the chosen type.")
                elseif node.Type == "Cast" then
                    out.Object = safeInstance(values.Object)
                    assert(out.Object:IsA(node.Settings.Property),"Object is not " .. node.Settings.Property)
                elseif node.Type == "SetProperty" then
                    local obj,name,value = safeInstance(values.Object),node.Settings.Property,values.Value
                    local old = validateProperty(obj,name,value)
                    rt.Projected[obj] = rt.Projected[obj] or {}; rt.Projected[obj][name] = value
                    rt.Assigned[obj] = rt.Assigned[obj] or {}; rt.Assigned[obj][name] = true
                    -- Test on a detached copy when creatable; inaccessible/read-only setters fail here.
                    local ok, probe = pcall(Instance.new,obj.ClassName)
                    if ok and probe then
                        local assignOk, assignErr = pcall(function() probe[name] = value end)
                        probe:Destroy(); assert(assignOk,assignErr)
                    else
                        local defService = Catalog["Service:" .. obj.ClassName]
                        local allowed = false
                        for _, propName in ipairs(defService and defService.Writable or {}) do if propName == name then allowed = true end end
                        assert(allowed,"This property cannot be edited by this node.")
                    end
                    table.insert(operations,function()
                        check(); obj[name] = value
                        table.insert(rt.Undo,function() obj[name] = old end)
                    end)
                    out.Object = obj
                elseif node.Type == "Add" then out.Result = values.A + values.B
                elseif node.Type == "Multiply" then out.Result = values.A * values.B
                elseif node.Type == "MakeVector3" then out.Value = Vector3.new(values.X,values.Y,values.Z)
                elseif node.Type == "MakeColor3" then
                    for _,channel in ipairs({values.R,values.G,values.B}) do assert(channel>=0 and channel<=255,"RGB must be between 0 and 255.") end
                    out.Value = Color3.fromRGB(values.R,values.G,values.B)
                elseif node.Type == "MakeUDim2" then out.Value = UDim2.new(values.ScaleX,values.OffsetX,values.ScaleY,values.OffsetY)
                elseif node.Type == "NumberSequence" then out.Value = NumberSequence.new(values.Start,values.End)
                elseif node.Type == "ColorSequence" then out.Value = ColorSequence.new(values.Start,values.End)
                elseif node.Type == "Wait" then
                    assert(values.Seconds >= 0 and values.Seconds <= 60,"The wait must be between 0 and 60 seconds.")
                    table.insert(operations,function() check(); task.wait(values.Seconds); check() end)
                elseif node.Type == "Print" then table.insert(operations,function() check(); print("[Blueprint " .. r.Name .. "]",values.Message) end)
                elseif node.Type == "Notify" then table.insert(operations,function() check(); self:Notify({ Content = values.Message }) end)
                elseif node.Type == "PlaySound" then
                    assert(safeInstance(values.Sound):IsA("Sound"),"Connect a Sound.")
                    table.insert(operations,function() check(); values.Sound:Play(); table.insert(rt.Undo,function() values.Sound:Stop() end) end)
                end
                rt.Values[node.Id] = out
                for _, value in pairs(out) do if typeof(value) == "number" then assert(value == value and math.abs(value) < math.huge,"Invalid numeric result.") end end
                return out
            end
            local ok, err = pcall(function()
                -- Evaluate only nodes reachable by Exec from Start. Pure value
                -- nodes are evaluated lazily when a reachable node needs them.
                local walked = {}
                local function walk(node)
                    check()
                    if walked[node.Id] then return end
                    walked[node.Id] = true
                    eval(node)
                    for _, link in ipairs(r.Links) do
                        if link.From == node.Id and link.Output == "Exec" then
                            local nextNode = nodeById(r, link.To)
                            local nextPort = nextNode and getPort(nextNode, link.Input, "in")
                            if nextPort and nextPort.Type == "Exec" then walk(nextNode) end
                        end
                    end
                end
                local starts = 0
                for _, n in ipairs(r.Nodes) do
                    if n.Type == "Start" then starts += 1; walk(n) end
                end
                -- A graph made only of value nodes has nothing to execute.
                assert(starts > 0, "Add a Start node to run this blueprint.")
                for obj,properties in pairs(rt.Projected) do
                    if properties.Parent then
                        local visited = { [obj] = true }; local ancestor = properties.Parent
                        while ancestor do
                            assert(not visited[ancestor],"Parent cycle between objects."); visited[ancestor]=true
                            ancestor = plannedValue(ancestor,"Parent")
                        end
                    end
                end
                check(); self:_BlueprintStatus("Running...")
                for _, op in ipairs(parents) do op() end
                for _, op in ipairs(operations) do op() end
            end)
            if not ok then
                if currentNode then r.Invalid = { [currentNode] = true } end
                self:StopBlueprint(r,true)
                if not self.Destroyed then warn("[PebbleUI Blueprint] " .. tostring(err)); self:_BlueprintNotice("Failure: " .. tostring(err),true); if self.ActiveBlueprint == r then self:_BuildBlueprintBoard() end end
                safeCallback(self.Config.OnBlueprintError,err,r,self)
            elseif not rt.Cancelled and not self.Destroyed then
                r.Invalid = {}
                self:_BlueprintStatus("Blueprint executed: " .. r.Name)
                safeCallback(self.Config.OnBlueprintRun,r,self)
            end
        end)
        return true
    end

    local GuiService = game:GetService("GuiService")
    local function pointer(input)
        local p = input and Vector2.new(input.Position.X,input.Position.Y) or UserInputService:GetMouseLocation()
        if not input or input.UserInputType ~= Enum.UserInputType.Touch then p = UserInputService:GetMouseLocation() end
        local inset = Vector2.new()
        local ok, topLeft = pcall(function() return GuiService:GetGuiInset() end)
        if ok then inset = topLeft end
        return p - inset
    end
    local function inside(gui,p)
        if not gui or not gui.Visible then return false end
        local a,b = gui.AbsolutePosition,gui.AbsoluteSize
        return p.X >= a.X and p.Y >= a.Y and p.X <= a.X+b.X and p.Y <= a.Y+b.Y
    end
