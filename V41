            {"TopRight", 1, -1, UDim2.new(1,-11,0,0), UDim2.fromOffset(11,11), "move-diagonal"},
            {"BottomLeft", -1, 1, UDim2.new(0,0,1,-11), UDim2.fromOffset(11,11), "move-diagonal"},
            {"BottomRight", 1, 1, UDim2.new(1,-11,1,-11), UDim2.fromOffset(11,11), "move-diagonal-2"},
        }
        local resizing, mouseOver, currentZone, initialPoint, initialSize, initialCenter
        local cursor = CreateIcon("move-horizontal", 19, self.Theme.Accent, 1002)
        cursor.Name = "StudioResizeCursor"
        cursor.Visible = false
        cursor.Parent = screen
        local function stopResize()
            resizing = false
            if not mouseOver then
                cursor.Visible = false
                UserInputService.MouseIconEnabled = true
            end
        end
        for _, z in ipairs(zones) do
            local zone = New("TextButton", {
                Name = "Resize" .. z[1], Text = "", AutoButtonColor = false,
                BackgroundTransparency = 1, BorderSizePixel = 0,
                Position = z[4], Size = z[5], ZIndex = 1000, Parent = main,
            })
            zone.MouseEnter:Connect(function()
                if isMinimized or isMaximized then return end
                mouseOver = z
                cursor.Image = GetIcon(z[6])
                cursor.Visible = true
                UserInputService.MouseIconEnabled = false
            end)
            zone.MouseLeave:Connect(function()
                if mouseOver == z then mouseOver = nil end
                if not resizing then
                    cursor.Visible = false
                    UserInputService.MouseIconEnabled = true
                end
            end)
            zone.InputBegan:Connect(function(input)
                if isMinimized or isMaximized then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                resizing = true
                currentZone = z
                initialPoint = input.Position
                initialSize = main.AbsoluteSize
                initialCenter = main.AbsolutePosition + initialSize / 2
            end)
        end
        local changed = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if cursor.Visible then
                cursor.Position = UDim2.fromOffset(input.Position.X + 10, input.Position.Y + 10)
            end
            if not resizing or not currentZone then return end
            local dx = input.Position.X - initialPoint.X
            local dy = input.Position.Y - initialPoint.Y
            local minSize = config.MinSize or Defaults.MinSize
            local maxSize = config.MaxSize or Defaults.MaxSize
            local vp = screen.AbsoluteSize
            local w = math.clamp(initialSize.X + currentZone[2]*dx, math.min(minSize.X,math.max(240,vp.X-8)), math.max(math.min(minSize.X,math.max(240,vp.X-8)), math.min(maxSize.X,math.max(240,vp.X-8))))
            local h = math.clamp(initialSize.Y + currentZone[3]*dy, math.min(minSize.Y,math.max(180,vp.Y-8)), math.max(math.min(minSize.Y,math.max(180,vp.Y-8)), math.min(maxSize.Y,math.max(180,vp.Y-8))))
            local x = initialCenter.X + currentZone[2]*(w-initialSize.X)/2
            local y = initialCenter.Y + currentZone[3]*(h-initialSize.Y)/2
            main.AnchorPoint = Vector2.new(0.5, 0.5)
            main.Size = UDim2.fromOffset(w,h)
            main.Position = UDim2.fromOffset(x,y)
        end)
        local ended = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then stopResize() end
        end)
        table.insert(self._scriptConnections, changed)
        table.insert(self._scriptConnections, ended)
    end

    -- Global navigation search: tabs, sections and controls.
    local searchWidth = 198
    local searchBar = New("Frame", {
        Name = "GlobalSearchBar", AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -44, 0, 13), Size = UDim2.fromOffset(searchWidth, 24),
        BackgroundColor3 = self.Theme.Input, BorderSizePixel = 0,
        ZIndex = 60, Parent = main,
    })
    if studio then searchBar.Visible = false end
    Corner(searchBar, self.Theme.ControlRadius)
    BindTheme(self, searchBar, "BackgroundColor3", "Input")
    local searchBorder = FineStroke(searchBar, self.Theme.Border, 0.2)
    BindTheme(self, searchBorder, "Color", "Border")
    local searchIcon = CreateIcon("search", 13, self.Theme.SubText, 61)
    searchIcon.AnchorPoint = Vector2.new(0, 0.5)
    searchIcon.Position = UDim2.new(0, 8, 0.5, 0)
    searchIcon.Parent = searchBar
    BindTheme(self, searchIcon, "ImageColor3", "SubText")
    local searchInput = New("TextBox", {
        Name = "SearchInput", BackgroundTransparency = 1, BorderSizePixel = 0,
        ClearTextOnFocus = false, Text = "", PlaceholderText = "Search tabs & settings...",
        TextColor3 = self.Theme.Text, PlaceholderColor3 = self.Theme.DimText,
        TextSize = 11, Font = self.Theme.Font,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        Position = UDim2.fromOffset(28, 0), Size = UDim2.new(1, -34, 1, 0),
        ZIndex = 61, Parent = searchBar,
    })
    BindTheme(self, searchInput, "TextColor3", "Text")
    BindTheme(self, searchInput, "PlaceholderColor3", "DimText")
    BindTheme(self, searchInput, "Font", "Font")
    local searchResults = New("ScrollingFrame", {
        Name = "GlobalSearchResults", Visible = false, BorderSizePixel = 0,
        BackgroundColor3 = self.Theme.Popup, BackgroundTransparency = 0,
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -44, 0, 41),
        Size = UDim2.fromOffset(292, 0), ZIndex = 70,
        ScrollBarThickness = 2, ScrollBarImageColor3 = self.Theme.Scrollbar,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = main,
    })
    Corner(searchResults, self.Theme.PopupRadius)
    local searchResultsBorder = FineStroke(searchResults, self.Theme.Border, 0.1)
    BindTheme(self, searchResults, "BackgroundColor3", "Popup")
    BindTheme(self, searchResultsBorder, "Color", "Border")
    List(searchResults, 2)
    Padding(searchResults, 5, 7, 5, 5)
    self.SearchBar, self.SearchInput, self.SearchResults = searchBar, searchInput, searchResults

    local foundItems = {}
    local selectedIndex = 1
    local searchClosing = false
    local function clearResults()
        for _, child in ipairs(searchResults:GetChildren()) do
            if child:IsA("GuiButton") then child:Destroy() end
        end
        foundItems = {}
        searchResults.Visible = false
    end
    local function visitItem(item)
        if not item then return end
        searchClosing = true
        clearResults()
        searchInput.Text = ""
        searchInput:ReleaseFocus()
        searchClosing = false
        self:_setActiveTab(item.Tab)
        if item.Section then
            local scroll = item.Section.Side == "Right" and item.Tab.RightScroll or item.Tab.LeftScroll
            task.defer(function()
                if self.Destroyed or not scroll.Parent or not item.Target.Parent then return end
                local top = item.Target.AbsolutePosition.Y - scroll.AbsolutePosition.Y + scroll.CanvasPosition.Y
                local target = math.max(0, top - 12)
                local limit = math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y)
                Tween(scroll, 0.28, { CanvasPosition = Vector2.new(0, math.min(target, limit)) })
                local original = item.Target.BackgroundTransparency
                if item.Target:IsA("GuiObject") then
                    item.Target.BackgroundTransparency = math.min(original, 0.55)
                    task.delay(0.7, function()
                        if item.Target.Parent then Tween(item.Target, 0.3, {BackgroundTransparency = original}) end
                    end)
                end
            end)
        end
    end
    local function rebuildSearch()
        clearResults()
        if searchClosing then return end
        local query = string.lower((searchInput.Text or ""):match("^%s*(.-)%s*$"))
        if query == "" then return end
        for _, tab in ipairs(self.Tabs) do
            local tabTitle = tostring(tab.Title or "Tab")
            local tabMatch = string.find(string.lower(tabTitle), query, 1, true) ~= nil
            if tabMatch then
                table.insert(foundItems, { Tab = tab, Target = tab.Button, Label = tabTitle, Path = "TAB" })
            end
            for _, section in ipairs(tab.Sections) do
                local secTitle = section.Title and section.Title.Text or section.Frame.Name
                local secMatch = string.find(string.lower(secTitle), query, 1, true) ~= nil
                if secMatch then
                    table.insert(foundItems, { Tab = tab, Section = section, Target = section.Frame,
                        Label = secTitle, Path = tabTitle .. "  /  SECTION" })
                end
                for _, row in ipairs(section.Content:GetChildren()) do
                    if row:IsA("GuiObject") and row.LayoutOrder > 0 and row.Name ~= "Space" and row.Name ~= "Divider" then
                        local label = row.Name
                        if string.find(string.lower(label), query, 1, true) then
                            table.insert(foundItems, { Tab = tab, Section = section, Target = row,
                                Label = label, Path = tabTitle .. "  /  " .. secTitle })
                        end
                    end
                end
            end
        end
        if #foundItems == 0 then
            searchResults.Visible = false
            return
        end
        -- Bound the popup and avoid creating hundreds of UI instances for broad searches.
        while #foundItems > 40 do table.remove(foundItems) end
        selectedIndex = 1
        searchResults.Size = UDim2.fromOffset(292, math.min(310, #foundItems * 43 + 10))
        searchResults.CanvasPosition = Vector2.new(0, 0)
        searchResults.Visible = true
        for i, item in ipairs(foundItems) do
            local result = New("TextButton", {
                Name = "SearchResult", Text = "", AutoButtonColor = false,
                BackgroundColor3 = self.Theme.SurfaceHover,
                BackgroundTransparency = i == selectedIndex and 0.1 or 1,
                Size = UDim2.new(1, -3, 0, 41), LayoutOrder = i,
                BorderSizePixel = 0, ZIndex = 71, Parent = searchResults,
            })
            Corner(result, 4)
            local heading = New("TextLabel", {
                BackgroundTransparency = 1, Text = item.Label, Font = self.Theme.FontMedium,
                TextColor3 = self.Theme.Text, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.fromOffset(9, 3), Size = UDim2.new(1, -18, 0, 18),
                ZIndex = 72, Parent = result,
            })
            local path = New("TextLabel", {
                BackgroundTransparency = 1, Text = item.Path, Font = self.Theme.Font,
                TextColor3 = self.Theme.SubText, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Position = UDim2.fromOffset(9, 21), Size = UDim2.new(1, -18, 0, 15),
                ZIndex = 72, Parent = result,
            })
            item.Button = result
            BindTheme(self, heading, "TextColor3", "Text")
            BindTheme(self, path, "TextColor3", "SubText")
            result.MouseButton1Click:Connect(function() visitItem(item) end)
            result.MouseEnter:Connect(function()
                selectedIndex = i
                for j, entry in ipairs(foundItems) do
                    if entry.Button and entry.Button.Parent then entry.Button.BackgroundTransparency = j == i and 0.1 or 1 end
                end
            end)
        end
    end
    searchInput:GetPropertyChangedSignal("Text"):Connect(rebuildSearch)
    searchInput.Focused:Connect(rebuildSearch)
    searchInput.FocusLost:Connect(function()
        task.delay(0.16, function()
            if searchInput.Parent and not searchInput:IsFocused() then clearResults() end
        end)
    end)
    self:_TrackConnection(UserInputService.InputBegan:Connect(function(input)
        if self.Destroyed or not searchResults.Visible or not searchInput:IsFocused() then return end
        if input.KeyCode == Enum.KeyCode.Down or input.KeyCode == Enum.KeyCode.Up then
            local delta = input.KeyCode == Enum.KeyCode.Down and 1 or -1
            if #foundItems == 0 then return end
            selectedIndex = (selectedIndex - 1 + delta) % #foundItems + 1
            for i, item in ipairs(foundItems) do
                if item.Button and item.Button.Parent then item.Button.BackgroundTransparency = i == selectedIndex and 0.1 or 1 end
            end
            searchResults.CanvasPosition = Vector2.new(0, math.max(0, (selectedIndex - 6) * 43))
        elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
            visitItem(foundItems[selectedIndex])
        elseif input.KeyCode == Enum.KeyCode.Escape then
            clearResults()
            searchInput:ReleaseFocus()
        end
    end), searchBar)
    -- Keep search next to Close even when the script explorer changes the right inset.
    local function positionSearch()
        if not closeBtn.Parent then return end
        local inset = self._scriptRightInset or 0
        searchBar.Position = UDim2.new(1, -(44 + inset), 0, 13)
        searchResults.Position = UDim2.new(1, -(44 + inset), 0, 41)
        local available = closeBtn.AbsolutePosition.X - (topbar.AbsolutePosition.X + 110)
        searchBar.Size = UDim2.fromOffset(math.max(100, math.min(searchWidth, available)), 24)
    end
    self._PositionGlobalSearch = positionSearch
    main:GetPropertyChangedSignal("AbsoluteSize"):Connect(positionSearch)
    task.defer(positionSearch)

    local contentHost = New("Frame", {
        Name = "ContentHost",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(sidebarWidth + 12, topHeight + 10),
        Size = UDim2.new(1, -(sidebarWidth + 24), 1, -(topHeight + 22)),
        Parent = main,
    })
    self.ContentHost = contentHost

    -- The profile card follows the same auto-fit rules as tabs, so long display names stay readable.
    self:_fitSidebarText(displayName, 12, self.Theme.FontDisplay or self.Theme.FontBold, true, 12)

    local notifHolder = New("Frame", {
        Name = "NotificationHolder",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.fromOffset(12, 12),
        Size = UDim2.fromOffset(520, 400),
        ZIndex = 200,
        Parent = screen,
    })
    List(notifHolder, 4)
    self.NotificationHolder = notifHolder

    -- A animacao inicial da janela so roda sem loading.
    -- Com loading, o painel permanece oculto ate a transicao final.
    if config.Loading == false then
        main.BackgroundTransparency = (backgroundImage.Visible and 1 or self.BackgroundTransparency)
        local mainScale = EnsureScale(main)
        mainScale.Scale = 0.99
        task.defer(function()
            Tween(mainScale, 0.28, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
        end)
    end

    local toggleKey = config.ToggleKey or Defaults.ToggleKey
    local inputConn
    inputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if self.Destroyed then inputConn:Disconnect() return end
        if gp then return end
        if input.KeyCode == toggleKey then
            self:ToggleVisibility()
        end
    end)

    table.insert(self._scriptConnections, inputConn)
    if config.Draggable ~= false then
        local dragging, dragStart, startPos, dragInput

        local function beginDrag(input)
            if isMinimized then return end
            if studio and self.StudioToolbarGroup then
                local pos = input.Position
                local group = self.StudioToolbarGroup
                local gp, gs = group.AbsolutePosition, group.AbsoluteSize
                if pos.X >= gp.X and pos.X <= gp.X + gs.X
                    and pos.Y >= gp.Y and pos.Y <= gp.Y + gs.Y then return end
            end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end
        local function trackDragInput(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end
        local function attachDragSource(gui)
            if not gui then return end
            gui.InputBegan:Connect(beginDrag)
            gui.InputChanged:Connect(trackDragInput)
        end

        if studio then
            attachDragSource(self.StudioDragHandle)
        else
            attachDragSource(topbar)
        end

        local windowDragConnection = UserInputService.InputChanged:Connect(function(input)
            if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end)
        table.insert(self._scriptConnections, windowDragConnection)
    end
    self:_CreateScriptExplorer()
    self:_CreateCustomBlueprints()
    self:_CreateArchiveExplorer()
    self:_CreateTerminal()
    task.defer(function()
        if not self.Destroyed then self:_RunAutoArchives() end
    end)
    if config.SettingsTab ~= false then self:CreateSettingsView() end
    if studio and self.ScriptExplorer then self:_SetExplorerCollapsed(self._persistEnabled and saved.explorerCollapsed == true, true) end

    -- Monta o loading com a ScreenGui DESLIGADA.
    -- Assim a primeira renderizacao mostra apenas o loading, nunca a UI.
    if config.Loading ~= false then
        main.Visible = false
        PlayStartupIntro(self)
        screen.Enabled = true
    else
        main.Visible = true
        screen.Enabled = true
        task.defer(function()
            if not self.Destroyed then safeCallback(config.OnLoaded, self) end
        end)
    end

    -- Manual recovery for unexpected overlays; call window:RestoreVisibility().
    function self:RestoreVisibility()
        if self.Destroyed then return false end
        if self.LoadingOverlay then
            self.LoadingOverlay:Destroy()
            self.LoadingOverlay = nil
        end
        for _, child in ipairs(self.ScreenGui:GetChildren()) do
            if child.Name == "StartupIntro" then child:Destroy() end
        end
        self.ScreenGui.Enabled = true
        self.Visible = true
        self.Main.Visible = true
        self.Main.BackgroundTransparency = (self.BackgroundImage and self.BackgroundImage.Visible) and 1 or self.BackgroundTransparency
        if self.BackgroundImage then self.BackgroundImage.ImageTransparency = self.BackgroundTransparency end
        if self.BackgroundTint then self.BackgroundTint.BackgroundTransparency = 1 - (self.BackgroundStrength or 0) * (1 - self.BackgroundTransparency) end
        local scale = EnsureScale(self.Main)
        scale.Scale = 1
        return true
    end

    screen.Destroying:Connect(function()
        self:_DisposeBlueprints()
        self:_DisposeScripts()
        self:_DisposeConnections()
        self.Destroyed = true
    end)
    return self
end

print("[PebbleUI] Loaded v" .. PebbleUI.Version)
return PebbleUI
