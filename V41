    BindTheme(window, valueInput, "TextColor3", "Text", config.ValueColor)
    BindTheme(window, valueInput, "Font", "Font", config.Font)
    BindTheme(window, title, "Font", "Font", config.Font)
    BindTheme(window, valueLabel, "Font", "Font", config.Font)

    local state = {
        Value = default,
        Locked = config.Locked or false,
        Dragging = false,
    }

    local obj = {
        __type = "Slider",
        UIElements = { Holder = holder, Title = title, Track = track, Rail = rail, Fill = fill, Knob = knob, Value = valueLabel, ValueInput = valueInput },
    }

    local function format(v)
        if config.Format then
            local ok, r = pcall(config.Format, v)
            if ok and r ~= nil then return tostring(r) end
        end
        if step < 1 then return string.format("%.2f", v) end
        return tostring(v)
    end

    local lastText = ""
    local function render()
        local range = max - min
        local ratio = range == 0 and 0 or clamp((state.Value - min) / range, 0, 1)
        Tween(fill, 0.18, { Size = UDim2.new(ratio, 0, 1, 0) }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(knob, 0.18, { Position = UDim2.new(ratio, 0, 0.5, 0) }, EASE_SOFT, Enum.EasingDirection.Out)

        local newText = (config.Prefix or "") .. format(state.Value) .. (config.Suffix or "")
        if newText ~= lastText then
            lastText = newText
            valueLabel.Text = newText
        end
    end

    function obj:Set(v, fire)
        state.Value = snap(tonumber(v) or state.Value)
        render()
        if fire ~= false then safeCallback(config.Callback, state.Value) end
        return self
    end
    function obj:Get() return state.Value end

    local editStartingValue = default
    local editing = false
    local function stopEditing(enterPressed)
        if not editing then return end
        editing = false
        local proposed = tonumber((valueInput.Text or ""):gsub(",", "."):match("^%s*(.-)%s*$"))
        valueInput.Visible = false
        valueLabel.Visible = true
        -- Invalid or out-of-range entries revert to the value before editing.
        if enterPressed and proposed and proposed == proposed and proposed >= min and proposed <= max then
            obj:Set(proposed, true)
        else
            obj:Set(editStartingValue, false)
        end
    end
    valueLabel.MouseButton1Click:Connect(function()
        if state.Locked or editing then return end
        editing = true
        editStartingValue = state.Value
        valueLabel.Visible = false
        valueInput.Text = ""
        valueInput.Visible = true
        valueInput:CaptureFocus()
    end)
    valueInput.FocusLost:Connect(function(enterPressed)
        stopEditing(enterPressed)
    end)

    local function updateFromX(x)
        local width = math.max(1, track.AbsoluteSize.X)
        local ratio = clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        obj:Set(min + ((max - min) * ratio), true)
    end

    track.MouseEnter:Connect(function()
        Tween(knob, 0.22, {
            Size = UDim2.fromOffset((config.KnobSize or 6) + 3, (config.KnobSize or 6) + 3)
        }, EASE_OUT, Enum.EasingDirection.Out)
    end)
    track.MouseLeave:Connect(function()
        if not state.Dragging then
            Tween(knob, 0.28, {
                Size = UDim2.fromOffset(config.KnobSize or 6, config.KnobSize or 6)
            }, EASE_OUT, Enum.EasingDirection.Out)
        end
    end)

    track.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            state.Dragging = true
            Tween(knob, 0.2, {
                Size = UDim2.fromOffset((config.KnobSize or 6) + 4, (config.KnobSize or 6) + 4)
            }, EASE_OUT, Enum.EasingDirection.Out)
            updateFromX(input.Position.X)
        end
    end)
    window:_TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if not state.Dragging or state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end), holder)
    window:_TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if state.Dragging then
                state.Dragging = false
                Tween(knob, 0.28, {
                    Size = UDim2.fromOffset(config.KnobSize or 6, config.KnobSize or 6)
                }, EASE_OUT, Enum.EasingDirection.Out)
            end
        end
    end), holder)

    local function renderLocked()
        if state.Locked then
            state.Dragging = false
            if editing then stopEditing(false); valueInput:ReleaseFocus() end
        end
        title.TextColor3 = state.Locked and theme.MutedText or (config.TextColor or theme.SubText)
        valueLabel.TextColor3 = state.Locked and theme.MutedText or (config.ValueColor or theme.Text)
        fill.BackgroundTransparency = state.Locked and 0.55 or 0
        knob.BackgroundTransparency = state.Locked and 0.55 or 0
    end
    AttachLockAPI(obj, state, renderLocked)
    WatchTheme(window, holder, renderLocked)
    render()
    return obj
end

