local function StyleScrollBar(sf, opts)
    opts = opts or {}
    sf.ScrollBarThickness        = opts.Thickness or 2
    sf.ScrollBarImageColor3      = opts.Color or Color3.fromRGB(75, 82, 98)
    sf.ScrollBarImageTransparency = opts.Transparency or 0.6
