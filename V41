function Window:_setActiveTab(tab)
    if self.SettingsView and self.SettingsView.Visible then
        self.SettingsView.Visible = false
        self.SettingsOpen = false
        if self.ActiveTab and self.ActiveTab.Container then
            self.ActiveTab.Container.Visible = true
        end
    end
    if not tab or (self.ActiveTab == tab and not self.ActiveScript and not self.ActiveBlueprint) then return end
    if self.ActiveBlueprint then self:_LeaveBlueprintEditor() end
    if self.ActiveScript then self:_LeaveScriptEditor() end

    if self.ActiveDropdown then self.ActiveDropdown:Close() end
    if self.ActiveColorpicker then self.ActiveColorpicker:Close() end

    for _, t in ipairs(self.Tabs) do
        local selected = t == tab
        t.Container.Visible = selected
        Tween(t.ButtonLabel, 0.22, {
            TextColor3 = selected and self.Theme.Accent or self.Theme.SubText
        }, EASE_SOFT, Enum.EasingDirection.Out)
        if t.ButtonIcon then
            Tween(t.ButtonIcon, 0.22, {
                ImageColor3 = selected and self.Theme.Accent or self.Theme.Icon
            }, EASE_SOFT, Enum.EasingDirection.Out)
        end
        if t.Button then
            Tween(t.Button, 0.24, {
                BackgroundTransparency = selected and 0 or 1,
                BackgroundColor3 = selected and self.Theme.SurfaceHover or self.Theme.Sidebar,
            }, EASE_SOFT, Enum.EasingDirection.Out)
        end
        if t.Accent then
            Tween(t.Accent, 0.22, { BackgroundTransparency = selected and 0 or 1 }, EASE_SOFT, Enum.EasingDirection.Out)
        end
    end

    self.ActiveTab = tab
    PopIn(tab.Container, 0)
    safeCallback(self.Config.OnTabChange, tab)
end

-- Keeps the sidebar readable when a tab/display name is wider than the default width.
-- By default the main window grows together with the sidebar, preserving the content area width.
function Window:_applySidebarWidth(targetWidth, animated)
    local minWidth = self.Config.SidebarWidth or Defaults.SidebarWidth
    local maxWidth = self.Config.MaxSidebarWidth or Defaults.MaxSidebarWidth
    targetWidth = math.floor(clamp(tonumber(targetWidth) or minWidth, minWidth, maxWidth) + 0.5)

    local current = self.SidebarWidth or minWidth
    if self.Config.Layout == "Studio" then return self end
    if targetWidth <= current then return self end

    local delta = targetWidth - current
    self.SidebarWidth = targetWidth

    local sidebarSize = UDim2.new(0, targetWidth - 8, 1, -16)
    local topbarPosition = UDim2.fromOffset(targetWidth + 12, 6)
    local topbarSize = UDim2.new(1, -(targetWidth + 24 + (self._scriptRightInset or 0)), 0, self.TopbarHeight)
    local contentPosition = UDim2.fromOffset(targetWidth + 12, self.TopbarHeight + 10)
    local contentSize = UDim2.new(1, -(targetWidth + 24 + (self._scriptRightInset or 0)), 1, -(self.TopbarHeight + 22))

    local duration = animated == false and 0 or 0.28
    if duration > 0 then
        Tween(self.Sidebar, duration, { Size = sidebarSize }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(self.Topbar, duration, { Position = topbarPosition, Size = topbarSize }, EASE_SOFT, Enum.EasingDirection.Out)
        Tween(self.ContentHost, duration, { Position = contentPosition, Size = contentSize }, EASE_SOFT, Enum.EasingDirection.Out)
    else
        self.Sidebar.Size = sidebarSize
        self.Topbar.Position = topbarPosition
        self.Topbar.Size = topbarSize
        self.ContentHost.Position = contentPosition
        self.ContentHost.Size = contentSize
    end

    if self.Config.ExpandWindowForSidebar ~= false and self.Main then
        local currentSize = self.Main.Size
        local targetOffset = currentSize.X.Offset + delta
        local maxSize = self.Config.MaxSize or Defaults.MaxSize
        if currentSize.X.Scale == 0 and maxSize then
            targetOffset = math.min(targetOffset, maxSize.X)
        end
        local targetMainSize = UDim2.new(currentSize.X.Scale, targetOffset, currentSize.Y.Scale, currentSize.Y.Offset)
        if duration > 0 then
            Tween(self.Main, duration, { Size = targetMainSize }, EASE_SOFT, Enum.EasingDirection.Out)
        else
            self.Main.Size = targetMainSize
        end
    end

    if self.ScriptExplorer then self:_UpdateScriptLayout() end
    return self
end

function Window:_fitSidebarText(text, textSize, font, hasIcon, extraPadding)
    if self.Config.Layout == "Studio" or self.Config.AutoFitSidebar == false then return self end
    text = tostring(text or "")
    if text == "" then return self end

    local ok, bounds = pcall(function()
        return TextService:GetTextSize(
            text,
            textSize or 12,
            font or self.Theme.FontMedium,
            Vector2.new(10000, 100)
        )
    end)
    if not ok or not bounds then return self end

    -- Accounts for sidebar/list/button paddings, optional tab icon and the left selection marker.
    local chrome = hasIcon and 82 or 62
    local required = math.ceil(bounds.X + chrome + (extraPadding or 0))
    return self:_applySidebarWidth(required, true)
end

function Window:TabDivider(config)
    config = config or {}
    local holder = New("Frame", {
        Name = "TabDivider",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, config.Height or 22),
        LayoutOrder = self.SidebarOrder + 1,
        Parent = self.SidebarList,
    })
    self.SidebarOrder += 1

    if config.Title then
        New("TextLabel", {
            BackgroundTransparency = 1,
            Text = config.Title,
            TextColor3 = config.TextColor or self.Theme.DimText,
            TextSize = config.TextSize or 10,
            Font = self.Theme.Font,
            Size = UDim2.new(1, 0, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = config.TextTransparency or 0,
            Parent = holder,
        })
    else
        New("Frame", {
            BackgroundColor3 = config.Color or self.Theme.SidebarDivider,
            BackgroundTransparency = config.Transparency or 0.1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 0, 1),
            Parent = holder,
        })
    end
    return holder
end

function Window:Tab(config)
    config = config or {}
    self.SidebarOrder += 1

    local title = config.Title or "Tab"
    local theme = self.Theme

    -- Grow the sidebar before creating the visual row so long tab names never get crushed.
    self:_fitSidebarText(title, config.TextSize or 12, theme.FontMedium, config.Icon ~= nil)

    local button = New("TextButton", {
        Name = title,
        BackgroundColor3 = theme.SurfaceHover,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = self.Config.Layout == "Studio"
            and UDim2.fromOffset(math.clamp(42 + TextService:GetTextSize(title, 12, theme.FontMedium, Vector2.new(999, 30)).X, 84, 174), config.Height or 32)
            or UDim2.new(1, 0, 0, config.Height or 30),
        LayoutOrder = self.SidebarOrder,
        Text = "",
        AutoButtonColor = false,
        Parent = self.SidebarList,
    })
    Corner(button, config.Corner or 11)

    local icon
    if config.Icon then
        icon = CreateIcon(config.Icon, config.IconSize or 14,
            config.IconColor or theme.Icon, 2)
        icon.AnchorPoint = Vector2.new(0, 0.5)
        icon.Position = UDim2.new(0, 11, 0.5, 0)
        icon.Parent = button
    end

    local label = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = theme.SubText,
        TextSize = config.TextSize or 12,
        Font = theme.FontMedium,
        Position = UDim2.fromOffset(icon and 34 or 13, 0),
        Size = UDim2.new(1, -(icon and 40 or 20), 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = button,
    })

    local accent = New("Frame", {
        Name = "Accent",
        BackgroundColor3 = config.AccentColor or theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(2, 12),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Parent = button,
    })
    Corner(accent, 99)

    local container = New("Frame", {
        Name = title .. "_Container",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Visible = false,
        Parent = self.ContentHost,
    })

    local leftWidth = self.Config.LeftColumnWidth
    local splitColumns = leftWidth == nil
    local gap = self.Config.ColumnGap or Defaults.ColumnGap

    local leftScroll = StyleScrollBar(New("ScrollingFrame", {
        Name = "LeftScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ElasticBehavior = Enum.ElasticBehavior.Never,
        Position = UDim2.fromOffset(0, 0),
        Size = splitColumns and UDim2.new(0.5, -(gap / 2), 1, 0) or UDim2.new(0, leftWidth, 1, 0),
        Parent = container,
    }), {
        Thickness = self.Theme.ScrollbarThickness or 2,
        Color = self.Theme.Scrollbar,
        Transparency = self.Theme.ScrollbarTransparency or 0.6,
        Inset = Enum.ScrollBarInset.ScrollBar,
    })

    local leftContainer = New("Frame", {
        Name = "LeftContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = leftScroll,
    })
    local leftLayout = List(leftContainer, self.Config.SectionGap or Defaults.SectionGap)

    local rightScroll = StyleScrollBar(New("ScrollingFrame", {
        Name = "RightScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        ElasticBehavior = Enum.ElasticBehavior.Never,
        Position = splitColumns and UDim2.new(0.5, gap / 2, 0, 0) or UDim2.fromOffset(leftWidth + gap, 0),
        Size = splitColumns and UDim2.new(0.5, -(gap / 2), 1, 0) or UDim2.new(1, -(leftWidth + gap), 1, 0),
        Parent = container,
    }), {
        Thickness = self.Theme.ScrollbarThickness or 2,
        Color = self.Theme.Scrollbar,
        Transparency = self.Theme.ScrollbarTransparency or 0.6,
        Inset = Enum.ScrollBarInset.ScrollBar,
    })

    local rightContainer = New("Frame", {
        Name = "RightContainer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = rightScroll,
    })
    local rightLayout = List(rightContainer, self.Config.SectionGap or Defaults.SectionGap)

    local tab = setmetatable({
        __type = "Tab",
        Window = self,
        Title = title,
        Icon = config.Icon,
        Button = button,
        ButtonLabel = label,
        ButtonIcon = icon,
        Accent = accent,
        Container = container,
        LeftScroll = leftScroll,
        RightScroll = rightScroll,
        LeftContainer = leftContainer,
        RightContainer = rightContainer,
        LeftLayout = leftLayout,
        RightLayout = rightLayout,
        Sections = {},
        SectionOrders = { Left = 0, Right = 0 },
    }, Tab)

    BindTheme(self, label, "Font", "FontMedium")
    BindTheme(self, accent, "BackgroundColor3", "Accent", config.AccentColor)
    WatchTheme(self, button, function()
        local selected = self.ActiveTab == tab and not self.ActiveScript and not self.ActiveBlueprint
        label.TextColor3 = selected and theme.Accent or theme.SubText
        if icon then icon.ImageColor3 = selected and theme.Accent or (config.IconColor or theme.Icon) end
        button.BackgroundColor3 = selected and theme.SurfaceHover or theme.Sidebar
        for _, scrollFrame in ipairs({ leftScroll, rightScroll }) do
            StyleScrollBar(scrollFrame, { Thickness = theme.ScrollbarThickness, Color = theme.Scrollbar, Transparency = theme.ScrollbarTransparency })
        end
    end)
    table.insert(self.Tabs, tab)

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab or self.ActiveScript or self.ActiveBlueprint then
            Tween(button, 0.24, { BackgroundTransparency = 0.35 }, EASE_SOFT, Enum.EasingDirection.Out)
            HoverTween(label, 0.2, { TextColor3 = theme.Accent })
            if icon then HoverTween(icon, 0.2, { ImageColor3 = theme.Accent }) end
            HoverScale(button, 1.003)
        end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab or self.ActiveScript or self.ActiveBlueprint then
            Tween(button, 0.24, { BackgroundTransparency = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
            HoverTween(label, 0.24, { TextColor3 = theme.SubText })
            if icon then HoverTween(icon, 0.24, { ImageColor3 = theme.Icon }) end
            RestScale(button)
        end
    end)
    button.MouseButton1Down:Connect(function() PressScale(button) end)
    button.MouseButton1Up:Connect(function() ReleaseScale(button) end)
    button.MouseButton1Click:Connect(function() self:_setActiveTab(tab) end)

    if not self.ActiveTab then self:_setActiveTab(tab) end
    return tab
end

function Window:SetTheme(themePatch)
    -- Keep the table identity: existing component callbacks refer to it.
    local nextTheme = merge(self.Theme, themePatch or {})
    for key, value in pairs(nextTheme) do self.Theme[key] = value end
    self:_RefreshTheme()
    self:_PersistSoon()
    return self
end

function Window:SetSelectColor(color)
    if typeof(color) == "Color3" then
        return self:SetTheme({ Accent = color })
    end
    return self
end

function Window:SetBackgroundTransparency(value)
    value = clamp01(value)
    self.BackgroundTransparency = value
    self:_PersistSoon()
    if self.Main then
        local hasImage = self.BackgroundImage and self.BackgroundImage.Visible
        Tween(self.Main, 0.3, {
            BackgroundTransparency = hasImage and 1 or value,
        }, EASE_SOFT, Enum.EasingDirection.Out)
        if self.BackgroundImage then
            Tween(self.BackgroundImage, 0.3, {
                ImageTransparency = value,
            }, EASE_SOFT, Enum.EasingDirection.Out)
        end
        if self.BackgroundTint then
            Tween(self.BackgroundTint, 0.3, {
                BackgroundTransparency = 1 - (self.BackgroundStrength or 0) * (1 - value),
            }, EASE_SOFT, Enum.EasingDirection.Out)
        end
    end
    return self
end

function Window:GetBackgroundTransparency()
    return self.BackgroundTransparency or 0
end

function Window:ToggleVisibility()
    if self._minimized and self._restoreFromMinimize then
        self._restoreFromMinimize()
        return true
    end
    if self.Destroyed or not self.Main.Parent then return false end
    self.Visible = not self.Visible
    self._visibilityRevision = (self._visibilityRevision or 0) + 1
    local revision = self._visibilityRevision
    local scale = EnsureScale(self.Main)
    if self._visibilityTween then self._visibilityTween:Cancel() end
    if self.Visible then
        self.Main.Visible = true
        self._visibilityTween = Tween(scale, 0.22, { Scale = 1 }, EASE_SOFT, Enum.EasingDirection.Out)
    else
        self._visibilityTween = Tween(scale, 0.16, { Scale = 0.99 }, EASE_SOFT, Enum.EasingDirection.In)
        task.delay(0.18, function()
            if not self.Destroyed and self._visibilityRevision == revision and not self.Visible then
                self.Main.Visible = false
            end
        end)
        if self.ActiveColorpicker then self.ActiveColorpicker:Close() end
        if self.ActiveDropdown then self.ActiveDropdown:Close() end
        if self._scriptModal then self._scriptModal:Close() end
        self:_CloseCreationMenu()
        if self.CloseUserProfile then self.CloseUserProfile() end
        self._bpPending, self._bpDrag = nil, nil
        if self.BlueprintUI then self.BlueprintUI.Palette.Visible = false; self.BlueprintUI.Tooltip.Visible = false end
        local focused = UserInputService:GetFocusedTextBox()
        if focused and self.BlueprintEditor and focused:IsDescendantOf(self.BlueprintEditor) then focused:ReleaseFocus() end
        if self.ScriptEditorElements and self.ScriptEditorElements.Input:IsFocused() then
            self.ScriptEditorElements.Input:ReleaseFocus()
        end
    end
    return self.Visible
end

function Window:Close()
    self:_PersistNow()
    if self.Destroyed then return end
    if self.CloseUserProfile then self.CloseUserProfile() end
    self:_DisposeBlueprints()
    self:_DisposeScripts()
    self:_DisposeConnections()
    self.Destroyed = true
    if self.ActiveDropdown then self.ActiveDropdown:Close(); self.ActiveDropdown = nil end
    if self.ActiveColorpicker then self.ActiveColorpicker:Close(); self.ActiveColorpicker = nil end
    if self.SettingsClick then self.SettingsClick:Destroy(); self.SettingsClick = nil end
    if self.ScreenGui then self.ScreenGui:Destroy() end
    self._themeBindings = {}
    self._themeRenderers = {}
end

function Window:Destroy() self:Close() end

