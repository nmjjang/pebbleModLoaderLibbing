    function Window:_UpdateBlueprintMarquee(screenPoint)
        local ui = self.BlueprintUI
        local drag = self._bpDrag
        if not ui or not drag or not drag.Started then return end
        local startLocal = drag.Start - ui.Board.AbsolutePosition
        local currentLocal = screenPoint - ui.Board.AbsolutePosition
        local x1, y1 = math.min(startLocal.X, currentLocal.X), math.min(startLocal.Y, currentLocal.Y)
        local x2, y2 = math.max(startLocal.X, currentLocal.X), math.max(startLocal.Y, currentLocal.Y)
        ui.SelectionBox.Visible = true
        ui.SelectionBox.Position = UDim2.fromOffset(x1, y1)
        ui.SelectionBox.Size = UDim2.fromOffset(math.max(1, x2 - x1), math.max(1, y2 - y1))
        local chosen, first = {}, nil
        for nodeId, nodeUI in pairs(self._bpNodeUI or {}) do
            local p = nodeUI.Frame.AbsolutePosition
            local s = nodeUI.Frame.AbsoluteSize
            local nx1, ny1, nx2, ny2 = p.X, p.Y, p.X + s.X, p.Y + s.Y
            local intersects = nx2 >= x1 + ui.Board.AbsolutePosition.X and nx1 <= x2 + ui.Board.AbsolutePosition.X
                and ny2 >= y1 + ui.Board.AbsolutePosition.Y and ny1 <= y2 + ui.Board.AbsolutePosition.Y
            if intersects then
                chosen[nodeId] = true
                first = first or nodeId
            end
        end
        self:_SelectBlueprintNode(first, chosen)
