-- Persistent state (Real/executor workspace). New controls are tracked automatically.
local function PersistEncode(v)
    if typeof(v) == "Color3" then return {__kind="Color3",r=v.R,g=v.G,b=v.B} end
    if typeof(v) == "UDim2" then return {__kind="UDim2",xs=v.X.Scale,xo=v.X.Offset,ys=v.Y.Scale,yo=v.Y.Offset} end
    if typeof(v) == "EnumItem" then return {__kind="Enum",enum=tostring(v.EnumType),name=v.Name} end
    if type(v) == "table" then
        local out = {}
        for k,x in pairs(v) do if type(k)=="string" or type(k)=="number" then out[k]=PersistEncode(x) end end
        return out
    end
    if type(v)=="string" or type(v)=="number" or type(v)=="boolean" then return v end
    return nil
end
local function PersistDecode(v)
    if type(v) ~= "table" then return v end
    if v.__kind == "Color3" then return Color3.new(v.r,v.g,v.b) end
    if v.__kind == "UDim2" then return UDim2.new(v.xs,v.xo,v.ys,v.yo) end
    if v.__kind == "Enum" then
        local typ = tostring(v.enum):match("Enum%.(.+)")
        return typ and Enum[typ] and Enum[typ][v.name] or nil
    end
    local out = {}
    for k,x in pairs(v) do out[k]=PersistDecode(x) end
    return out
end
local function PersistFileName(config)
    local label = tostring(config.SaveId or config.Name or config.Title or "PebbleUI")
    return "PebbleUI/state_" .. label:gsub("[^%w_%-]","_") .. ".json"
end
local function PersistLoad(path)
    if type(readfile)~="function" then return {} end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    return ok and type(data)=="table" and data or {}
end
function Window:_PersistNow()
    if not self._persistEnabled or self._persistRestoring or self.Destroyed then return end
    if type(writefile)~="function" then return end
    local data = self._persistState or {}
    data.version = 1
    data.controls = data.controls or {}
    data.theme = PersistEncode(self.Theme)
    data.opacity = self.BackgroundTransparency
    data.strength = self.BackgroundStrength
    data.imagePath = self._backgroundAssetPath
    data.explorerCollapsed = self._explorerCollapsed
    data.position = PersistEncode(self.Main.Position)
    data.size = PersistEncode(self.Main.Size)
    data.visible = self.Visible
    if self.Main:FindFirstChildOfClass("UICorner") then
        data.corner = self.Main:FindFirstChildOfClass("UICorner").CornerRadius.Offset
    end
    local ok,err = pcall(function()
        if type(makefolder)=="function" then pcall(makefolder,"PebbleUI") end
        writefile(self._persistPath,HttpService:JSONEncode(data))
    end)
    if not ok then warn("[PebbleUI] Save error:",err) end
end
function Window:_PersistSoon()
    if not self._persistEnabled or self._persistRestoring then return end
    self._persistRevision = (self._persistRevision or 0)+1
    local revision=self._persistRevision
    task.delay(0.45,function()
        if revision==self._persistRevision then self:_PersistNow() end
    end)
end
function Window:SaveState() self:_PersistNow(); return self end
function Window:ClearSavedState()
    if type(delfile)=="function" then pcall(delfile,self._persistPath) end
    self._persistState={controls={}}
    return self
end
function Window:_PersistControl(kind, config, obj)
    if not self._persistEnabled or not obj or type(obj.Get)~="function" or type(obj.Set)~="function" then return obj end
    self._persistControlIndex=(self._persistControlIndex or 0)+1
    -- Explicit Flag is recommended for controls added/reshuffled in future updates.
    local key=tostring(config.Flag or config.SaveKey or (kind.."_"..self._persistControlIndex))
    local data=self._persistState
    data.controls=data.controls or {}
    local prior=data.controls[key]
    if prior~=nil then
        self._persistRestoring=true
        local ok,err=pcall(function() obj:Set(PersistDecode(prior),true) end)
        self._persistRestoring=false
        if not ok then warn("[PebbleUI] Restore control "..key..":",err) end
    end
    local originalSet=obj.Set
    obj.Set=function(control,...)
        local result=originalSet(control,...)
        local ok,value=pcall(control.Get,control)
        if ok then data.controls[key]=PersistEncode(value); self:_PersistSoon() end
        return result
    end
    -- Some widgets update internal state directly instead of calling obj:Set.
    local root=obj.UIElements and (obj.UIElements.Holder or obj.UIElements.Row or obj.UIElements.Button)
    if root then
        local function capture()
            task.defer(function()
                if self.Destroyed then return end
                local ok,value=pcall(obj.Get,obj)
                if ok then data.controls[key]=PersistEncode(value); self:_PersistSoon() end
            end)
        end
        for _,node in ipairs(root:GetDescendants()) do
            if node:IsA("GuiButton") then node.Activated:Connect(capture)
            elseif node:IsA("TextBox") then node.FocusLost:Connect(capture) end
        end
    end
    return obj
end


