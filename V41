function Window:_RefreshTerminalTabs()
    local ui = self.TerminalUI
    if not ui then return end
    local counts = {Problems=0, Output=0, Terminal=0}
    for _, entry in ipairs(ui.Entries) do
        counts.Output += 1
        if entry.Severity == "warn" or entry.Severity == "error" then
            counts.Problems += 1
        end
        if entry.IsLocal then counts.Terminal += 1 end
        entry.Label.Visible = ui.ActiveTab == "Output"
            or (ui.ActiveTab == "Problems" and (entry.Severity == "warn" or entry.Severity == "error"))
            or (ui.ActiveTab == "Terminal" and entry.IsLocal)
    end
    for name, button in pairs(ui.Tabs) do
        local selected = ui.ActiveTab == name
        local labelColor = selected and self.Theme.Text or self.Theme.MutedText
        local countColor = selected and self.Theme.SubText or self.Theme.DimText
        if ui.AnimateTabs and self.Config.TerminalAnimations ~= false then
            Tween(button.Label, 0.22, {TextColor3=labelColor}, Enum.EasingStyle.Quart)
            Tween(button.Count, 0.22, {TextColor3=countColor}, Enum.EasingStyle.Quart)
        else
            button.Label.TextColor3 = labelColor
            button.Count.TextColor3 = countColor
        end
        button.Underline.Visible = false
        button.Count.Text = tostring(counts[name])
    end
    if ui.TabIndicator and ui.Tabs[ui.ActiveTab] then
        local target = ui.Tabs[ui.ActiveTab].Button
        local x = target.Position.X.Offset
        local width = target.Size.X.Offset - 4
        if ui.AnimateTabs and self.Config.TerminalAnimations ~= false then
            Tween(ui.TabIndicator, 0.25, {Position=UDim2.new(0,x,1,-2),
                Size=UDim2.fromOffset(width,2)}, Enum.EasingStyle.Quart)
        else
            ui.TabIndicator.Position=UDim2.new(0,x,1,-2)
            ui.TabIndicator.Size=UDim2.fromOffset(width,2)
        end
    end
    -- AutomaticCanvasSize.Y respects the visibility of items in UIListLayout.
    task.defer(function()
        if self.Destroyed or not ui.LogList.Parent then return end
        local maxY = math.max(0, ui.LogList.AbsoluteCanvasSize.Y - ui.LogList.AbsoluteWindowSize.Y)
        ui.LogList.CanvasPosition = Vector2.new(0, maxY)
    end)
end

function Window:_TerminalLog(message, severity, forceLocal)
    if not self.TerminalUI or self.Destroyed then return end
    local ui = self.TerminalUI
    local line = tostring(message or "")
    -- Internal execution lifecycle messages are statuses, not user output.
    if severity ~= "error" and severity ~= "warn" and (
        line:match("^%[Script%] Running:")
        or line:match("^%[Script%] Completed:")
        or line:match("^%[PebbleUI%] Completed:")
        or line:match("^%[PebbleUI Blueprint%] Executed:")
        or line:match("^%[Blueprint%] Blueprint executed:")
    ) then return end
    local isLocal = forceLocal == true or line:find("%[PebbleUI",1) ~= nil
        or line:find("%[Blueprint",1) ~= nil
        or line:find("%[Script%]",1) ~= nil
    -- Ignore the duplicate echo if LogService also reports a directly captured print.
    if not forceLocal and ui.LastDirectLine == line
        and os.clock() - (ui.LastDirectAt or -100) < 0.6 then
        return
    end
    if forceLocal then
        ui.LastDirectLine = line
        ui.LastDirectAt = os.clock()
    end
    local entry = New("TextLabel", {
        Name = "LogEntry", BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = os.date("%H:%M:%S") .. "  " .. line,
        TextColor3 = severity == "error" and self.Theme.Danger
            or severity == "warn" and self.Theme.Warning or self.Theme.SubText,
        Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1,-16,0,16),
        LayoutOrder = ui.NextOrder, ZIndex = 51, Parent = ui.LogList,
    })
    ui.NextOrder += 1
    if ui.Expanded and self.Config.TerminalAnimations ~= false then
        entry.TextTransparency = 0.65
        Tween(entry,0.24,{TextTransparency=0},Enum.EasingStyle.Quart)
    end
    table.insert(ui.Entries, {Label=entry, Severity=severity, IsLocal=isLocal})
    if #ui.Entries > 350 then
        local old = table.remove(ui.Entries,1)
        if old and old.Label then old.Label:Destroy() end
    end
    self:_RefreshTerminalTabs()
end

-- Smooth terminal docking. Toggle transitions animate; drag remains direct and responsive.
function Window:_LayoutTerminal(animated)
    local ui = self.TerminalUI
    if not ui or not self.ScriptEditor then return end
    local active = (self.ScriptEditor.Visible and self.ActiveScript ~= nil)
        or (self.BlueprintEditor and self.BlueprintEditor.Visible and self.ActiveBlueprint ~= nil)
    local host = self.ContentHost
    local height = ui.Expanded and math.clamp(ui.Height,105,
        math.max(105,self.Main.AbsoluteSize.Y-215)) or 31
    local panelPosition = UDim2.new(host.Position.X.Scale,host.Position.X.Offset,1,-(height+8))
    local panelSize = UDim2.new(host.Size.X.Scale,host.Size.X.Offset,0,height)
    local inset = active and (height+5) or 0
    local duration = math.clamp(tonumber(self.Config.TerminalAnimationDuration) or 0.32, 0.08, 0.8)
    local function move(target, props)
        if not target then return end
        if ui.LayoutTweens[target] then
            ui.LayoutTweens[target]:Cancel()
            ui.LayoutTweens[target] = nil
        end
        if animated and self.Config.TerminalAnimations ~= false and SettingsMotion.Enabled then
            local tw = TweenService:Create(target, TweenInfo.new(duration,
                Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
            ui.LayoutTweens[target] = tw
            tw:Play()
        else
            for property,value in pairs(props) do target[property]=value end
        end
    end
    -- Do not hide the panel while shrinking: the content remains clipped inside it.
    ui.Panel.Visible = active == true
    move(ui.Panel, { Position=panelPosition, Size=panelSize })
    for _, editor in ipairs({self.ScriptEditor,self.BlueprintEditor}) do
        if editor then
            move(editor, { Size=UDim2.new(host.Size.X.Scale,host.Size.X.Offset,
                host.Size.Y.Scale,host.Size.Y.Offset-inset) })
        end
    end
    ui.LogList.Visible = ui.Expanded
    move(ui.Header, {BackgroundTransparency=ui.Expanded and 0 or 0.12})
    -- Rotate a single Lucide chevron instead of swapping images mid-animation.
    ui.Arrow.Image = GetIcon('chevron-down')
    move(ui.Arrow, {Rotation=ui.Expanded and 0 or 180})
end

