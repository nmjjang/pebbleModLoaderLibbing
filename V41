    function Window:_RefreshBlueprintCompatibility()
        local r = self.ActiveBlueprint; if not r then return end
        local pending = self._bpPending
        for id,ui in pairs(self._bpNodeUI or {}) do
            local node, anyCompatible = nodeById(r,id),false
            for _, endpoint in ipairs(ui.Endpoints) do
                local allowed = true
                if pending then
                    if endpoint.Direction == pending.Direction or endpoint.Node == pending.Node then allowed = false
                    else
                        local from,to = pending.Port,endpoint.Port
                        if pending.Direction == "in" then from,to = endpoint.Port,pending.Port end
                        allowed = compatible(from.Type,to.Type)
                        if allowed then anyCompatible = true end
                    end
                end
                HoverTween(endpoint.Button,0.16,{ BackgroundTransparency = allowed and 0 or 0.82 })
            end
            local def = definition(node)
            local faded = def.Disabled or (r.Invalid and r.Invalid[id]) or self._bpRejectedTarget == id or (pending and id ~= pending.Node and not anyCompatible)
            HoverTween(ui.Frame,0.18,{ GroupTransparency = faded and 0.74 or 0 })
        end
        self._bpWireDirty = true
    end
    function Window:_BlueprintPortPressed(endpoint,input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local r = self.ActiveBlueprint; if not r then return end
        local pending = self._bpPending
        if pending and pending.Node == endpoint.Node and pending.Direction == endpoint.Direction and pending.Port.Name == endpoint.Port.Name then
            self._bpPending = nil; self._bpRejectedTarget = nil; self:_RefreshBlueprintCompatibility(); return
        end
        if pending and pending.Direction ~= endpoint.Direction then
            local source,target = pending,endpoint
            if source.Direction == "in" then source,target = endpoint,pending end
            local ok,err = self:ConnectBlueprint(r,source.Node,source.Port.Name,target.Node,target.Port.Name)
            if not ok then
                self._bpPending = source; self._bpRejectedTarget = target.Node
                self:_BlueprintNotice(err,true)
            else self._bpPending = nil; self._bpRejectedTarget = nil; self:_BlueprintStatus("Connection created") end
            self:_RefreshBlueprintCompatibility()
        else
            self._bpPending = endpoint; self._bpRejectedTarget = nil; self._bpPendingStart = pointer(input)
            self:_BlueprintStatus(endpoint.Port.Name .. " · " .. endpoint.Port.Type .. " · drag to a port or empty space for a filtered catalog")
            self:_RefreshBlueprintCompatibility()
        end
    end
