            self.Sidebar.Visible = true
            if self.ScriptExplorer then self.ScriptExplorer.Visible = true end
            if self.Topbar then self.Topbar.Visible = true end
            if self.ContentHost then self.ContentHost.Visible = true end
            if self.ScriptEditor and self.ActiveScript then self.ScriptEditor.Visible = true end
            if self.BlueprintEditor and self.ActiveBlueprint then self.BlueprintEditor.Visible = true end
        end
        if not isMaximized then
            restoreSize, restorePosition = main.Size, main.Position
            local viewport = screen.AbsoluteSize
            main.Size = UDim2.fromOffset(math.max(420, viewport.X - 16), math.max(280, viewport.Y - 16))
            main.Position = UDim2.fromScale(0.5, 0.5)
            isMaximized = true
        else
            main.Size, main.Position = restoreSize, restorePosition
            isMaximized = false
        end
        if maximizeIcon then maximizeIcon.Image = GetIcon(isMaximized and "copy" or "maximize-2") end
        self:_UpdateScriptLayout()
    end
    local function restoreFromMinimize()
        if not isMinimized then return end
        isMinimized = false
        self._minimized = false
        main.Visible = true
        self.Visible = true
        main.Size = restoreSize
        if self.StudioToolbar then self.StudioToolbar.Visible = true end
        if self.Sidebar then self.Sidebar.Visible = self.Config.Layout ~= "Studio" end
        if self.ScriptExplorer then self.ScriptExplorer.Visible = true end
        if self.Topbar then self.Topbar.Visible = true end
        if self.ContentHost then self.ContentHost.Visible = not (self.ActiveScript or self.ActiveBlueprint) end
        if self.ScriptEditor and self.ActiveScript then self.ScriptEditor.Visible = true end
        if self.BlueprintEditor and self.ActiveBlueprint then self.BlueprintEditor.Visible = true end
    end
