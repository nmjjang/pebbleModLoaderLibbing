--============================================================
-- Theme binding
--============================================================

local function ThemeValue(window, key)
    return (window.Theme and window.Theme[key]) or DefaultTheme[key]
end

local function BindTheme(window, instance, prop, key, override)
    if override ~= nil then
        instance[prop] = override
        return
    end
    local v = ThemeValue(window, key)
    if v ~= nil then instance[prop] = v end
    table.insert(window._themeBindings, { Instance = instance, Property = prop, Key = key })
end

local function WatchTheme(window, instance, render)
    table.insert(window._themeRenderers, { Instance = instance, Render = render })
end

-- Lifecycle registry: service connections must never outlive their window.
function Window:_TrackConnection(connection, owner)
    if not connection then return nil end
    if self.Destroyed then
        connection:Disconnect()
        return connection
    end
    self._ownedConnections = self._ownedConnections or {}
    table.insert(self._ownedConnections, connection)
    if owner then
        -- Prevent dangling global listeners when a widget is removed early.
        local cleanup
        cleanup = owner.Destroying:Connect(function()
            if connection.Connected then connection:Disconnect() end
            if cleanup.Connected then cleanup:Disconnect() end
        end)
        table.insert(self._ownedConnections, cleanup)
    end
    return connection
end

function Window:_DisposeConnections()
    local connections = self._ownedConnections or {}
    self._ownedConnections = {}
    for i = #connections, 1, -1 do
        local connection = connections[i]
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
end

function Window:_RefreshTheme()
    for i = #self._themeBindings, 1, -1 do
        local b = self._themeBindings[i]
        if b.Instance and b.Instance.Parent then
            local v = ThemeValue(self, b.Key)
            if v ~= nil then b.Instance[b.Property] = v end
        else
            table.remove(self._themeBindings, i)
        end
    end
    for i = #self._themeRenderers, 1, -1 do
        local b = self._themeRenderers[i]
        if b.Instance and b.Instance.Parent then
            b.Render()
        else
            table.remove(self._themeRenderers, i)
        end
    end
end

