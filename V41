-- Stop cancels this library's scheduled runner coroutine. It cannot undo
-- side-effects or stop tasks/connections created independently by user scripts.
function Window:StopScript()
    local thread = self._runningScriptThread
    self._runningScriptToken = (self._runningScriptToken or 0) + 1
    self._runningScriptThread = nil
    if not thread or coroutine.status(thread) == "dead" then
        self:_ScriptStatus("No running script")
        return false
    end
    if thread ~= coroutine.running() then
        pcall(task.cancel, thread)
    end
    self:_ScriptStatus("Stopped runner (external tasks may continue)")
    return true
end

function Window:RunScript(idOrName)
    local record = self:GetScript(idOrName or self.ActiveScript)
    if not record then
        self:_ScriptStatus("Open or select a script first.", true)
        return false, "Script not found."
    end
    if self.Config.AllowScriptExecution == false then
        self:_ScriptStatus("Script execution is disabled in Window settings.", true)
        return false, "Script execution disabled."
    end

    -- Capture the latest unsaved editor text before execution.
    if self.ActiveScript == record and self.ScriptEditorElements and self.ScriptEditorElements.Input then
        local edited = NormalizeSource(self.ScriptEditorElements.Input.Text)
        if edited ~= record.Source then
            record.Source = edited
            record.Dirty = true
        end
    end
    local source, name = record.Source, record.Name
    if not source:match("%S") then
        self:_ScriptStatus("Script is empty.", true)
        return false, "Script is empty."
    end

    local runner = self.Config.OnRunScript
    if type(runner) ~= "function" then
        if type(loadstring) ~= "function" then
            local msg = "Text scripts cannot run here: no Luau compiler is exposed to this client. Use OnRunScript in a supported environment."
            self:_ScriptStatus(msg, true)
            warn("[PebbleUI] " .. msg)
            self:_TerminalLog("[Script] " .. msg, "error")
            return false, msg
        end
        -- Some runtime compilers accept only a source argument.
        local ok, compiled, compileErr = pcall(loadstring, source)
        if not ok or type(compiled) ~= "function" then
            local msg = tostring(compileErr or compiled or "Compilation failed")
            self:_ScriptStatus("Compile error: " .. msg, true)
            warn("[PebbleUI] Compile error in " .. name .. ": " .. msg)
            self:_TerminalLog("[Script] Compile error: " .. msg, "error")
            return false, msg
        end
        -- Capture prints and warnings from this compiled script directly.
        -- Some executors do not forward their output through LogService.MessageOut.
        if type(setfenv) == "function" and type(getfenv) == "function" then
            local envOk, originalEnvironment = pcall(getfenv, compiled)
            if envOk and type(originalEnvironment) == "table" then
                local normalPrint = originalEnvironment.print or print
                local normalWarn = originalEnvironment.warn or warn
                local scriptEnvironment = setmetatable({
                    print = function(...)
                        local parts = {}
                        for i = 1, select("#", ...) do
                            parts[i] = tostring(select(i, ...))
                        end
                        self:_TerminalLog(table.concat(parts, "\t"), "info", true)
                        return normalPrint(...)
                    end,
                    warn = function(...)
                        local parts = {}
                        for i = 1, select("#", ...) do
                            parts[i] = tostring(select(i, ...))
                        end
                        self:_TerminalLog(table.concat(parts, "\t"), "warn", true)
                        return normalWarn(...)
                    end,
                }, {__index = originalEnvironment, __newindex = originalEnvironment})
                pcall(setfenv, compiled, scriptEnvironment)
            end
        end
        runner = function() return compiled() end
    end

    self:StopScript()
    local token = (self._runningScriptToken or 0) + 1
    self._runningScriptToken = token
    self:_ScriptStatus("Running: " .. name)
    self._runningScriptThread = task.spawn(function()
        local ok, result = xpcall(function() return runner(source, record, self) end, debug.traceback)
        if self._runningScriptToken ~= token then return end
        self._runningScriptThread = nil
        if not self.Destroyed then
            local msg = ok and ("Completed: " .. name) or ("Runtime error: " .. tostring(result))
            self:_ScriptStatus(msg, not ok)
            if not ok then
                warn("[PebbleUI] " .. msg)
            end
            if not ok then self:_TerminalLog("[Script] " .. msg, "error", true) end
        end
        if not ok then safeCallback(self.Config.OnScriptError, result, record, self) end
    end)
    return true
end

function Window:_UpdateScriptLayout()
    if not self.ScriptExplorer or self.Destroyed then return end
    if self.Config.Layout == "Studio" then
        local rail = self.SidebarWidth
        local expandedWidth = self.Config.StudioExplorerWidth or Defaults.StudioExplorerWidth
        local collapsedWidth = self.Config.StudioExplorerCollapsedWidth or 48
        local explorerWidth = self._explorerCollapsed and collapsedWidth or expandedWidth
        local contentLeft = rail + explorerWidth + 14
        local animated = self._animateExplorerLayout == true
        local function apply(target, props)
            if not target then return end
            if animated then
                if self._explorerTweens == nil then self._explorerTweens = {} end
                if self._explorerTweens[target] then self._explorerTweens[target]:Cancel() end
                self._explorerTweens[target] = Tween(target, 0.38, props, Enum.EasingStyle.Quart)
            else
                for k, v in pairs(props) do target[k] = v end
            end
        end
        self._scriptRightInset = 0
        self.Sidebar.Visible = false -- Studio uses the Explorer as its leftmost column.
        self.ScriptExplorer.AnchorPoint = Vector2.new(0, 0)
        apply(self.ScriptExplorer, {
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(0, explorerWidth, 1, 0),
        })
        apply(self.StudioExplorerBackdrop, {
            Size = UDim2.new(0, explorerWidth, 1, 0),
        })
        apply(self.Topbar, {
            Position = UDim2.fromOffset(contentLeft, 44),
            Size = UDim2.new(1, -(contentLeft + 8), 0, 34),
        })
        local hostPos = UDim2.fromOffset(contentLeft, 83)
        local hostSize = UDim2.new(1, -(contentLeft + 8), 1, -91)
        apply(self.ContentHost, { Position = hostPos, Size = hostSize })
        -- Reserva espaço na barra superior para títulos mais longos.
        local toolbarLeft = math.max(contentLeft, (self._explorerBrandRight or 0) + 14)
        apply(self.StudioToolbar, {
            Position = UDim2.fromOffset(toolbarLeft, 5),
            Size = UDim2.new(1, -(toolbarLeft + 116), 0, 34),
        })
        apply(self.StudioDragHandle, {
            Position = UDim2.fromOffset(toolbarLeft, 5),
            Size = UDim2.new(1, -(toolbarLeft + 116), 0, 34),
        })
        apply(self.ScriptEditor, { Position = hostPos, Size = hostSize })
        apply(self.BlueprintEditor, { Position = hostPos, Size = hostSize })
        if self.TerminalUI then self:_LayoutTerminal() end
        self.CloseButton.Position = UDim2.new(1, -12, 0, 13)
        if self._PositionGlobalSearch then self._PositionGlobalSearch() end
        if self.BlueprintEditor and not animated then self:_LayoutBlueprintExplorer() end
        return
    end
    if not self.ScriptExplorer or self.Destroyed then return end
    local desired = self.Config.ScriptExplorerWidth or 192
    local available = self.Main.AbsoluteSize.X - self.SidebarWidth - 336
    local width = math.floor(clamp(available, math.min(148, desired), desired))
    self._scriptRightInset = width + 12
    self.ScriptExplorer.Size = UDim2.new(0, width, 1, -16)
    self.ScriptExplorer.Position = UDim2.new(1, -8, 0, 8)
    local side, top = self.SidebarWidth, self.TopbarHeight
    self.Topbar.Position = UDim2.fromOffset(side + 12, 6)
    self.Topbar.Size = UDim2.new(1, -(side + 24 + self._scriptRightInset), 0, top)
    self.ContentHost.Position = UDim2.fromOffset(side + 12, top + 10)
    self.ContentHost.Size = UDim2.new(1, -(side + 24 + self._scriptRightInset), 1, -(top + 22))
    self.ScriptEditor.Position = self.ContentHost.Position
    self.ScriptEditor.Size = self.ContentHost.Size
    self.CloseButton.Position = UDim2.new(1, -(12 + self._scriptRightInset), 0, 13)
    if self._PositionGlobalSearch then self._PositionGlobalSearch() end
    if self.BlueprintEditor then
        self.BlueprintEditor.Position = self.ContentHost.Position
        self.BlueprintEditor.Size = self.ContentHost.Size
        self:_LayoutBlueprintExplorer()
    end
    if self.TerminalUI then self:_LayoutTerminal() end
end

