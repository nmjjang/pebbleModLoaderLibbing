            ui.Caret.Visible = false
            return
        end
        ui.Caret.Visible = self._editorHasHighlight
            and ((os.clock() - (self._scriptCaretTimestamp or 0)) % 1.1 < 0.65)
    end)
    table.insert(self._scriptConnections, caretConnection)
    self:_LoadCustomScripts()
end

function Window:_DisposeScripts()
    if self._scriptDisposed then return end
    self._scriptDisposed = true
    if self._scriptsDirty then self:SaveScripts() end
    if self._scriptModal then self._scriptModal:Close() end
    for _, connection in ipairs(self._scriptConnections or {}) do connection:Disconnect() end
    self._scriptConnections = {}
end


-- PebbleUI Custom Blueprints, client graph engine + native Roblox UI.
-- This block is inserted before PebbleUI:CreateWindow in the complete file.
do
    local Catalog, Categories, ClassMeta = {}, {}, {}
    local COLORS = {
        Services = Color3.fromRGB(118, 160, 248), GUI = Color3.fromRGB(101, 204, 164),
        Parts = Color3.fromRGB(104, 184, 234), Avatar = Color3.fromRGB(216, 162, 109),
        Constraints = Color3.fromRGB(163, 151, 221), Effects = Color3.fromRGB(117, 211, 222),
        Environment = Color3.fromRGB(144, 196, 140), Sounds = Color3.fromRGB(231, 163, 104),
        Values = Color3.fromRGB(220, 171, 108), Logic = Color3.fromRGB(204, 136, 196),
        Animations = Color3.fromRGB(173, 154, 234), Input = Color3.fromRGB(218, 132, 159),
        Other = Color3.fromRGB(149, 166, 186),
    }
    local function port(name, kind, default, description, required)
        return { Name = name, Type = kind, Default = default, Description = description or name, Required = required == true }
    end
    local function register(def)
        def.Color = COLORS[def.Category] or COLORS.Other
        def.Inputs, def.Outputs = def.Inputs or {}, def.Outputs or {}
        Catalog[def.Id] = def
        Categories[def.Category] = true
        return def
    end
    local function fieldType(value)
        local t = typeof(value)
        if t == "EnumItem" then return tostring(value.EnumType) end
        if t == "Instance" then return "Instance" end
        return t
    end
    local function encodeValue(value)
        local t = typeof(value)
        if t == "Vector2" then return value.X .. ", " .. value.Y end
        if t == "Vector3" then return value.X .. ", " .. value.Y .. ", " .. value.Z end
        if t == "Color3" then return math.floor(value.R * 255 + 0.5) .. ", " .. math.floor(value.G * 255 + 0.5) .. ", " .. math.floor(value.B * 255 + 0.5) end
        if t == "UDim" then return value.Scale .. ", " .. value.Offset end
        if t == "UDim2" then return value.X.Scale .. ", " .. value.X.Offset .. ", " .. value.Y.Scale .. ", " .. value.Y.Offset end
        if t == "CFrame" then return table.concat({ value:GetComponents() }, ", ") end
        if t == "EnumItem" then return tostring(value) end
        if t == "NumberRange" then return value.Min .. ", " .. value.Max end
        if t == "BrickColor" then return value.Name end
        if t == "string" or t == "number" or t == "boolean" then return tostring(value) end
        return ""
    end
    local function parseValue(text, kind)
        text = tostring(text or "")
        if kind == "string" or kind == "any" then return text end
        if kind == "Instance" or kind:match("^Class:") then
            if text == "" then return nil end
            error("Connect an object port; references are not text.", 0)
        end
        if kind == "Exec" then return true end
        if kind == "BrickColor" then
            local value = BrickColor.new(tonumber(text) or text)
            assert(tonumber(text) or value.Name:lower() == text:lower(), "Invalid BrickColor: " .. text)
            return value
        end
        if kind == "boolean" then
            if text == "true" then return true end
            if text == "false" then return false end
            error("Use true or false.", 0)
        end
        if kind == "number" then
            local n = tonumber(text)
            assert(n and n == n and math.abs(n) < math.huge, "Invalid number: " .. text)
            return n
        end
        if kind:match("^Enum%.") then
            local enumName = kind:sub(6)
            local itemName = text:match("([%w_]+)$")
            local enum = Enum[enumName]
            assert(enum and itemName and enum[itemName], "Invalid Enum: " .. kind .. "." .. tostring(itemName))
            return enum[itemName]
        end
        local numbers = {}
        for part in text:gmatch("[^,]+") do
            local n = tonumber(part:match("^%s*(.-)%s*$"))
            assert(n and n == n and math.abs(n) < math.huge, "Invalid number component: " .. part)
            table.insert(numbers, n)
        end
        local counts = { Vector2 = 2, Vector3 = 3, Color3 = 3, UDim = 2, UDim2 = 4, CFrame = 3, NumberRange = 2 }
        if counts[kind] then
            assert(#numbers == counts[kind] or (kind == "CFrame" and #numbers == 12), "Invalid format for " .. kind)
            if kind == "Color3" then
                for _, n in ipairs(numbers) do assert(n >= 0 and n <= 255, "RGB must be between 0 and 255.") end
                return Color3.fromRGB(table.unpack(numbers))
            end
            if kind == "Vector2" then return Vector2.new(table.unpack(numbers)) end
            if kind == "Vector3" then return Vector3.new(table.unpack(numbers)) end
            if kind == "UDim" then return UDim.new(table.unpack(numbers)) end
            if kind == "UDim2" then return UDim2.new(table.unpack(numbers)) end
            if kind == "CFrame" then return CFrame.new(table.unpack(numbers)) end
            if kind == "NumberRange" then return NumberRange.new(table.unpack(numbers)) end
        end
        if text == "" then return nil end
        error("For " .. kind .. ", connect a port of the same type.", 0)
    end
    local function acceptsLiteral(kind)
        return kind == "string" or kind == "any" or kind == "number" or kind == "boolean" or kind == "BrickColor"
            or kind == "Vector2" or kind == "Vector3" or kind == "Color3" or kind == "UDim" or kind == "UDim2"
            or kind == "CFrame" or kind == "NumberRange" or kind:match("^Enum%.") ~= nil
