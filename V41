    local function ensureDefinition(def)
        if def.Prepared then return def end
        if def.Ref then
            local sample
            if def.Ref == "LocalPlayer" then sample = LocalPlayer
            elseif def.Ref == "PlayerGui" then sample = PlayerGui
            elseif def.Ref == "Character" then sample = LocalPlayer.Character
            elseif def.Ref == "CurrentCamera" then sample = workspace.CurrentCamera
            else sample = LocalPlayer:FindFirstChild(def.Ref) end
            if sample then
                def.Prepared = true; def.Fields = discoverProperties(sample.ClassName, sample, {})
                for _, p in ipairs(def.Fields) do table.insert(def.Outputs, copyTable(p)) end
            end
            return def
        end
        def.Prepared = true
        if not def.Class then return def end
        local ok, sample = pcall(function() return def.Service and game:GetService(def.Class) or Instance.new(def.Class) end)
        if not ok or not sample then
            def.Disabled = "This class is not available or cannot be created on this client."
            return def
        end
        local fields = discoverProperties(def.Class, sample, def.Service and (def.Writable or {}) or nil)
        def.Fields = fields
        def.Inputs = { port("Exec", "Exec", nil, "Execution order (optional).") }
        def.Outputs = { port("Exec", "Exec"), port("Object", "Class:" .. def.Class, nil, "Reference " .. def.Class) }
        for _, p in ipairs(fields) do
            table.insert(def.Outputs, copyTable(p))
            if p.Writable then table.insert(def.Inputs, copyTable(p)) end
        end
        ClassMeta[def.Class] = sample
        if not def.Service then sample:Destroy(); ClassMeta[def.Class] = nil end
        return def
    end
