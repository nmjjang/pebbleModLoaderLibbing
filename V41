    end
    modal.UIElements.Cancel = action("Cancel", "x", -232, false, function() modal:Close() end)
    modal.UIElements.Confirm = action("Confirm", "check", -121, true, function() modal:Confirm() end)
    modal.UIElements.Close = ScriptIconButton(self, panel, "x", UDim2.new(1, -34, 0, 16), function() modal:Close() end)
    input.Focused:Connect(function() inputBorder.Color = window.Theme.Accent end)
    input.FocusLost:Connect(function(enter) if enter then modal:Confirm() end end)
    input:GetPropertyChangedSignal("Text"):Connect(function() errorLabel.Text = ""; inputBorder.Color = window.Theme.Border end)
    overlay.MouseButton1Click:Connect(function() modal:Close() end)
    self._scriptModal = modal
    PopIn(panel, 0)
    task.defer(function()
        if not modal.Closed and not self.Destroyed then
            input:CaptureFocus()
            if record then input.SelectionStart = 1; input.CursorPosition = #input.Text + 1 end
        end
    end)
    return modal
end

