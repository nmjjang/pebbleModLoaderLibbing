    local function definition(node)
        local base = Catalog[node.Type]
        if not base then return nil end
        base = ensureDefinition(base)
        if not base.Dynamic then return base end
        local def = copyTable(base)
        if node.Type == "Cast" then def.Outputs[1].Type = "Class:" .. (node.Settings and node.Settings.Property or "Part"); return def end
        local kind = node.Settings and node.Settings.ValueType or "string"
        for _, p in ipairs(def.Inputs) do if p.Name == "Value" then p.Type = kind end end
        for _, p in ipairs(def.Outputs) do if p.Name == "Value" then p.Type = kind end end
        return def
    end
    local function getPort(node, name, direction)
        local def = definition(node)
        if not def then return nil end
        for _, p in ipairs(def[direction == "in" and "Inputs" or "Outputs"]) do if p.Name == name then return p end end
    end
    local function compatible(from, to)
        if from == "Exec" or to == "Exec" then return from == to end
        if to == "any" then return true end
        if from == to then return true end
        if to == "Instance" then return from == "Instance" or from:match("^Class:") ~= nil end
        if from:match("^Class:") and to:match("^Class:") then
            local ok, obj = pcall(Instance.new, from:sub(7))
            if ok and obj then local yes = obj:IsA(to:sub(7)); obj:Destroy(); return yes end
            return false
        end
        return false
    end
    local function portVisual(kind)
        if kind == "Exec" then return "git-commit", Color3.fromRGB(235, 239, 248) end
        if kind == "string" then return "type", Color3.fromRGB(127, 200, 255) end
        if kind == "number" then return "hash", Color3.fromRGB(255, 206, 120) end
        if kind == "boolean" then return "toggle-right", Color3.fromRGB(144, 228, 170) end
        if kind == "Instance" or tostring(kind):match("^Class:") then return "cubes", Color3.fromRGB(173, 154, 234) end
        if tostring(kind):match("^Enum%.") then return "list-tree", Color3.fromRGB(241, 159, 189) end
        return "circle-dot", Color3.fromRGB(146, 209, 221)
    end
    local function definitionMatchesContext(def, pending)
        if not def or not pending then return true, nil end
        local wantInputs = pending.Direction == "out"
        local want = pending.Port and pending.Port.Type
        local ports = def[wantInputs and "Inputs" or "Outputs"] or {}
        for _, p in ipairs(ports) do
            local from, to = wantInputs and want or p.Type, wantInputs and p.Type or want
            if compatible(from, to) then return true, p end
        end
        return false, nil
    end
