function Section:Colorpicker(config)
    config = config or {}
    local window = self.Window
    local theme = window.Theme
    config.RightReserve = config.RightReserve or 40

    local row, title = MakeRow(self, config, RowHeight(config, 26))
    local initial = config.Default or config.Value or Color3.new(1, 1, 1)
    local h, s, v = Color3.toHSV(initial)

    local swatch = New("TextButton", {
        Name = "ColorSwatch",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(config.SwatchWidth or config.SwatchSize or 22,
            config.SwatchHeight or config.SwatchSize or 12),
        BackgroundColor3 = initial,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Active = true,
        ZIndex = 20,
        Parent = row,
    })
    Corner(swatch, config.Corner or theme.ControlRadius)
    local swatchStroke = FineStroke(swatch, theme.Border, 0.12)
    BindTheme(window, swatchStroke, "Color", "Border")

    local state = { Value = initial, Locked = config.Locked or false, Open = false }

    local popupWidth = config.PopupWidth or 240
    local fieldHeight = config.FieldHeight or 120
    local bottomHeight = config.BottomHeight or 42
    local hueHeight = config.HueHeight or 8
    local popupHeight = fieldHeight + bottomHeight

    local popup = New("Frame", {
        Name = "ColorpickerPopup",
        BackgroundColor3 = config.PopupBackground or theme.Popup,
        BorderSizePixel = 0,
        Visible = false,
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(popupWidth, popupHeight),
        ClipsDescendants = true,
        ZIndex = 1000,
        Parent = window.ScreenGui,
    })
    Corner(popup, config.PopupCorner or theme.PopupRadius)
    local popupStroke = FineStroke(popup, theme.Border, 0.12)
    BindTheme(window, popup, "BackgroundColor3", "Popup", config.PopupBackground)
    BindTheme(window, popupStroke, "Color", "Border")

    local svArea = New("TextButton", {
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Active = true,
        Size = UDim2.new(1, 0, 0, fieldHeight),
        ZIndex = popup.ZIndex + 1,
        Parent = popup,
    })

    local whiteLayer = New("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = popup.ZIndex + 2,
        Parent = svArea,
    })
    New("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = whiteLayer,
    })

    local blackLayer = New("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = popup.ZIndex + 3,
        Parent = svArea,
    })
    New("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Parent = blackLayer,
    })

    local svPicker = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(18, 18),
        BackgroundTransparency = 1,
        ZIndex = popup.ZIndex + 6,
        Parent = svArea,
    })
    Corner(svPicker, 99)
    Stroke(svPicker, Color3.new(1, 1, 1), 2, 0)

    local hueBar = New("TextButton", {
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Active = true,
        Position = UDim2.new(0, 12, 1, -(bottomHeight / 2) - (hueHeight / 2)),
        Size = UDim2.new(1, -24, 0, hueHeight),
        ZIndex = popup.ZIndex + 2,
        Parent = popup,
    })
    Corner(hueBar, 99)
    New("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 45, 45)),
            ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 70, 255)),
            ColorSequenceKeypoint.new(0.82, Color3.fromRGB(210, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 25, 65)),
        }),
        Parent = hueBar,
    })

    local hueKnob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        ZIndex = popup.ZIndex + 5,
        Parent = hueBar,
    })
    Corner(hueKnob, 99)
    Stroke(hueKnob, Color3.new(1, 1, 1), 2, 0)

    local closeBtn = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -5, 0, 5),
        Size = UDim2.fromOffset(18, 18),
        BackgroundColor3 = theme.Accent,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Text = "×",
        TextColor3 = theme.AccentText,
        TextSize = 17,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Active = true,
        ZIndex = popup.ZIndex + 20,
        Parent = popup,
    })
    Corner(closeBtn, 5)
    local closeStroke = FineStroke(closeBtn, theme.AccentHover, 0.25)
    BindTheme(window, closeBtn, "BackgroundColor3", "Accent")
    BindTheme(window, closeBtn, "TextColor3", "AccentText")
    BindTheme(window, closeStroke, "Color", "AccentHover")

    local obj = {
        __type = "Colorpicker",
        UIElements = { Row = row, Title = title, Swatch = swatch, Popup = popup },
    }

    local function updatePopupPosition()
        local screenSize = window.ScreenGui.AbsoluteSize
        if screenSize.X <= 0 then
            local cam = workspace.CurrentCamera
            screenSize = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        end
        local sp = swatch.AbsolutePosition
        local ss = swatch.AbsoluteSize
        local margin = 6
        local gap = 6
        local x = sp.X + ss.X - popupWidth
        local y = sp.Y + ss.Y + gap

        if y + popupHeight > screenSize.Y - margin then
            y = sp.Y - popupHeight - gap
        end
        x = clamp(x, margin, math.max(margin, screenSize.X - popupWidth - margin))
        y = clamp(y, margin, math.max(margin, screenSize.Y - popupHeight - margin))
        popup.Position = UDim2.fromOffset(x, y)
    end

    local function render(fire)
        state.Value = Color3.fromHSV(h, s, v)
        local hc = Color3.fromHSV(h, 1, 1)
        Tween(swatch, 0.18, { BackgroundColor3 = state.Value }, EASE_SOFT, Enum.EasingDirection.Out)
        svArea.BackgroundColor3 = hc
        svPicker.Position = UDim2.fromScale(s, 1 - v)
        hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
        hueKnob.BackgroundColor3 = hc
        if fire ~= false then safeCallback(config.Callback, state.Value) end
    end

    local draggingSV, draggingHue = false, false

    local function updateSV(pos)
        local p = svArea.AbsolutePosition
        local sz = svArea.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then return end
        s = clamp((pos.X - p.X) / sz.X, 0, 1)
        v = 1 - clamp((pos.Y - p.Y) / sz.Y, 0, 1)
        render(true)
    end

    local function updateHue(pos)
        local p = hueBar.AbsolutePosition
        local sz = hueBar.AbsoluteSize
        if sz.X <= 0 then return end
        h = clamp((pos.X - p.X) / sz.X, 0, 1)
        render(true)
    end

    svArea.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true
            updateSV(input.Position)
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            updateHue(input.Position)
        end
    end)
    window:_TrackConnection(UserInputService.InputChanged:Connect(function(input)
        if state.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSV then updateSV(input.Position) end
            if draggingHue then updateHue(input.Position) end
        end
    end), holder)
    window:_TrackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false
            draggingHue = false
        end
    end), holder)

    function obj:Set(color, fire)
        if typeof(color) ~= "Color3" then return self end
        h, s, v = Color3.toHSV(color)
        render(fire)
        return self
    end
    function obj:Get() return state.Value end
    function obj:GetHSV() return h, s, v end

    function obj:Open()
        if state.Locked then return self end
        if window.ActiveColorpicker and window.ActiveColorpicker ~= self then
            window.ActiveColorpicker:Close()
        end
        window.ActiveColorpicker = self
        state.Open = true
        popup.Visible = true
        popup.Size = UDim2.fromOffset(popupWidth, 0)
        popup.BackgroundTransparency = 1
        task.defer(function()
            if state.Open and popup.Parent then
                updatePopupPosition()
                render(false)
                Tween(popup, 0.28, {
                    Size = UDim2.fromOffset(popupWidth, popupHeight),
                    BackgroundTransparency = 0
                }, EASE_SOFT, Enum.EasingDirection.Out)
            end
        end)
        return self
    end

    function obj:Close()
        state.Open = false
        draggingSV = false
        draggingHue = false
        Tween(popup, 0.2, {
            Size = UDim2.fromOffset(popupWidth, 0),
            BackgroundTransparency = 1
        }, EASE_SOFT, Enum.EasingDirection.Out)
        task.delay(0.22, function()
            if not state.Open then popup.Visible = false end
        end)
        if window.ActiveColorpicker == self then window.ActiveColorpicker = nil end
        return self
    end

    function obj:Toggle()
        if state.Open then return self:Close() end
        return self:Open()
    end

    swatch.MouseButton1Click:Connect(function()
        if not state.Locked then obj:Toggle() end
    end)
    closeBtn.MouseButton1Click:Connect(function() obj:Close() end)

    swatch:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if state.Open then updatePopupPosition() end
    end)

    local function renderLocked()
        if state.Locked and state.Open then obj:Close() end
        title.TextColor3 = state.Locked and theme.MutedText or (config.TextColor or theme.Text)
        swatch.BackgroundTransparency = state.Locked and 0.45 or 0
    end
    AttachLockAPI(obj, state, renderLocked)
    WatchTheme(window, row, renderLocked)
    render(false)
    return obj
end

--============================================================
-- Tab
--============================================================

function Tab:_nextSectionOrder(side)
    self.SectionOrders[side] += 1
    return self.SectionOrders[side]
end

function Tab:Section(config)
    config = config or {}
    local side = string.lower(config.Side or "Left")
    side = side == "right" and "Right" or "Left"

    local parent = side == "Right" and self.RightContainer or self.LeftContainer
    local theme = self.Window.Theme

    local frame = New("Frame", {
        Name = config.Title or "Section",
        BackgroundColor3 = config.BackgroundColor or theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 40),
        LayoutOrder = self:_nextSectionOrder(side),
        Parent = parent,
    })
    Corner(frame, config.Corner or theme.SectionRadius)
    local border = FineStroke(frame, config.BorderColor or theme.Border, 0.42)
    BindTheme(self.Window, frame, "BackgroundColor3", "Surface", config.BackgroundColor)
    BindTheme(self.Window, border, "Color", "Border", config.BorderColor)

    local headerHeight = config.HeaderHeight or 26

    local header = New("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -20, 0, headerHeight),
        Parent = frame,
    })

    local iconOffset = 0
    if config.Icon then
        local iconBubble = New("Frame", {
            BackgroundColor3 = config.IconBackground or theme.Surface2,
            BackgroundTransparency = config.IconBackground and 0 or 1,
            BorderSizePixel = 0,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            Parent = header,
        })
        Corner(iconBubble, 3)
        local icon = CreateIcon(config.Icon, config.IconSize or 13,
            config.IconColor or theme.Accent, 3)
        icon.AnchorPoint = Vector2.new(0.5, 0.5)
        icon.Position = UDim2.fromScale(0.5, 0.5)
        icon.Parent = iconBubble
        BindTheme(self.Window, icon, "ImageColor3", "Accent", config.IconColor)
        iconOffset = 22
    end

    local title = New("TextLabel", {
        BackgroundTransparency = 1,
        Text = config.Title or "Section",
        TextColor3 = config.TextColor or theme.Text,
        TextSize = config.TextSize or 12,
        Font = config.Font or theme.FontMedium,
        Position = UDim2.fromOffset(iconOffset, 0),
        Size = UDim2.new(1, -iconOffset, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        Parent = header,
    })

    BindTheme(self.Window, title, "TextColor3", "Text", config.TextColor)
    BindTheme(self.Window, title, "Font", "FontMedium", config.Font)
    local headerLine = New("Frame", {
        Name = "HeaderLine",
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, headerHeight),
        Size = UDim2.new(1, -20, 0, 1),
        Parent = frame,
    })
    BindTheme(self.Window, headerLine, "BackgroundColor3", "Border")
    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, headerHeight + 5),
        Size = UDim2.new(1, -20, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = frame,
    })

    local contentLayout = List(content, config.ElementGap or 2)

    local section = setmetatable({
        __type = "Section",
        Window = self.Window,
        Tab = self,
        Side = side,
        Frame = frame,
        Header = header,
        Title = title,
        Content = content,
        Layout = contentLayout,
        HeaderHeight = headerHeight + 5,
        PaddingBottom = config.PaddingBottom or 8,
        Order = 0,
    }, Section)

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        section:_recalculateHeight()
    end)

    section:_recalculateHeight()
    PopIn(frame, math.min(0.03 * frame.LayoutOrder, 0.18))
    table.insert(self.Sections, section)
    return section
end

--============================================================
-- Built-in Settings tab (reference-inspired, native Roblox controls)
--============================================================
function Window:CreateSettingsTab()
    if self.SettingsTab then return self.SettingsTab end
    local tab = self:Tab({ Title = "Settings", Icon = "settings" })
    self.SettingsTab = tab
    local theme = self.Theme
    local main = self.Main
    local state = {
        PanelOpacity = 100, Rainbow = false,
        SoundKind = "Poppy", SoundId = "93927627634818", SoundMuted = true,
    }
    self.SettingsState = state
    -- Outside-only shadow: the window shadow is a sibling of the clipped Main,
    -- not a descendant, so the window cannot clip it or draw it over content.
    local outerShadow = New("ImageLabel", {
        Name = "PebbleOuterDepth", BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 1, ZIndex = 0,
        AnchorPoint = main.AnchorPoint,
        Position = main.Position, Size = main.Size,
        Visible = main.Visible, Parent = self.ScreenGui,
    })
    -- Sibling draw order: shadow first, Main after it.
    outerShadow.LayoutOrder = -1
    local function syncOuterShadow()
        if not main.Parent or not outerShadow.Parent then return end
        local spread = outerShadow:GetAttribute("Spread") or 0
        outerShadow.AnchorPoint = main.AnchorPoint
        outerShadow.Position = main.Position
        outerShadow.Size = UDim2.new(main.Size.X.Scale, main.Size.X.Offset + spread * 2,
            main.Size.Y.Scale, main.Size.Y.Offset + spread * 2)
        outerShadow.Visible = main.Visible and (state.PanelDepth or 0) > 0
    end
    main:GetPropertyChangedSignal("Position"):Connect(syncOuterShadow)
    main:GetPropertyChangedSignal("Size"):Connect(syncOuterShadow)
    main:GetPropertyChangedSignal("Visible"):Connect(syncOuterShadow)

    local function updateDepth(value)
        state.PanelDepth = value
        local strength = math.clamp(value / 200, 0, 1)
        local spread = math.floor(8 + 24 * strength)
        outerShadow:SetAttribute("Spread", spread)
        Tween(outerShadow, 0.28, {
            ImageTransparency = value > 0 and (1 - strength * 0.8) or 1,
        }, EASE_SOFT, Enum.EasingDirection.Out)
        syncOuterShadow()
        -- Clean up the previous inside-panel shadows, if present.
        for _, element in ipairs(main:GetDescendants()) do
            if element.Name == "PebbleDepthShadow" then element:Destroy() end
        end
    end
    self.SettingsApplyPanelDepth = updateDepth
    -- Space(4) after every native Settings control.
    local function spaced(section)
        for _, method in ipairs({"Slider", "Checkbox", "Dropdown", "Input", "Button", "Colorpicker"}) do
            section[method] = function(self, config)
                local element = Section[method](self, config)
                Section.Space(self, 4)
                return element
            end
        end
        return section
    end
    local sWindow = spaced(tab:Section({Title = "WINDOW", Side = "Left", Icon = "app-window"}))
    sWindow:Slider({Title="Window Opacity", Min=0, Max=100, Step=1, Default=100, Suffix="%",
        Callback=function(v) self:SetBackgroundTransparency(1 - v/100) end})
    sWindow:Slider({Title="Panel Depth", Min=0, Max=200, Step=5, Default=100, Suffix="%",
        Callback=updateDepth})
    sWindow:Slider({Title="Window Corner Radius", Min=0, Max=32, Step=1, Default=8,
        Callback=function(v)
            local radius = UDim.new(0, v)
            local c = main:FindFirstChildOfClass("UICorner")
            if c then c.CornerRadius = radius end
            if self.BackgroundImageCorner then self.BackgroundImageCorner.CornerRadius = radius end
            if self.BackgroundTintCorner then self.BackgroundTintCorner.CornerRadius = radius end
        end})
    local borderStroke=main:FindFirstChildOfClass("UIStroke")
    sWindow:Slider({Title="Window Border Thickness", Min=0, Max=6, Step=0.5, Default=1,
        Callback=function(v) if borderStroke then borderStroke.Thickness=v end end})
    sWindow:Colorpicker({Title="Window Border Color", Default=theme.Stroke,
        Callback=function(c) state.BorderColor=c; if borderStroke then borderStroke.Color=c end end})
    sWindow:Checkbox({Title="Rainbow Border", Default=false, Keybind=false,
        Callback=function(v) state.Rainbow=v; if not v and borderStroke then borderStroke.Color=state.BorderColor or theme.Stroke end end})

    local sAnimations=spaced(tab:Section({Title="ANIMATIONS", Side="Right", Icon="sparkles"}))
    sAnimations:Checkbox({Title="Enable Animations", Default=true, Keybind=false,
        Callback=function(v) SettingsMotion.Enabled=v end})
    sAnimations:Slider({Title="Animation Speed", Min=0.25, Max=3, Step=0.05, Default=1, Suffix="x",
        Callback=function(v) SettingsMotion.Speed=v end})
    sAnimations:Dropdown({Title="Animation Style", Values={"Smooth","Snappy","Minimal"}, Default="Smooth",
        Callback=function(v) SettingsMotion.Style=v end})
    -- Button click sounds are selected in Window Settings.
    -- Keep the asset IDs in one place so the setting is easy to extend.
    local buttonSounds = {
        Poppy = "93927627634818",
        Clicky = "9083627113",
        Futuristic = "116394299154002",
    }
    local fx=New("Sound", {
        Name="PebbleSettingsClick",
        SoundId="rbxassetid://" .. buttonSounds.Poppy,
        Volume=0.35,
        Parent=SoundService,
    })
    self.SettingsClick=fx
    sWindow:Dropdown({
        Title="Button Click Sound",
        Values={"Poppy", "Clicky", "Futuristic"},
        Default="Poppy",
        Callback=function(selected)
            local id = buttonSounds[selected]
            if not id then return end
            state.SoundKind = selected
            state.SoundId = id
            fx.SoundId = "rbxassetid://" .. id
        end,
    })
    sWindow:Checkbox({
        Title="Mute Click Sound",
        Default=true,
        Keybind=false,
        Callback=function(muted)
            state.SoundMuted = muted == true
            if state.SoundMuted then fx:Stop() end
        end,
    })
    -- Play only when a genuine GuiButton is ACTIVATED, never merely because
    -- the pointer is inside its rectangle. Dropdown menus and dialogs may be
    -- siblings of Main, so monitor ScreenGui rather than Main alone.
    local soundButtonConnections = {}
    local function isButtonUsable(button)
        if self.Destroyed or not self.Visible or not self.ScreenGui.Enabled then return false end
        if not button:IsDescendantOf(self.ScreenGui) or not button.Active then return false end
        local current = button
        while current and current ~= self.ScreenGui do
            if current:IsA("GuiObject") and not current.Visible then return false end
            current = current.Parent
        end
        return true
    end
    local function isActualControl(button)
        -- Backdrop hit targets close popups, but aren't visible buttons.
        local name = string.lower(button.Name)
        if name == "overlay" or name == "backdrop" or name == "modaloverlay"
            or name == "dimmer" or name == "clickcatcher" then return false end
        -- Transparent, unlabeled full-panel hit areas are not click controls.
        if button.BackgroundTransparency >= 0.99 and button:IsA("TextButton")
            and button.Text == "" and button.AbsoluteSize.X >= self.Main.AbsoluteSize.X * 0.8
            and button.AbsoluteSize.Y >= self.Main.AbsoluteSize.Y * 0.7 then return false end
        return true
    end
    local function attachClickSound(button)
        if not button:IsA("GuiButton") or soundButtonConnections[button] then return end
        if not isActualControl(button) then return end
        local connection = button.Activated:Connect(function()
            if not isButtonUsable(button) or not isActualControl(button) then return end
            if state.SoundMuted or state.SoundId == "" or not fx.Parent then return end
            fx:Stop()
            fx.TimePosition = 0
            fx:Play()
        end)
        soundButtonConnections[button] = connection
        table.insert(self._scriptConnections, connection)
    end
    for _, descendant in ipairs(self.ScreenGui:GetDescendants()) do
        attachClickSound(descendant)
    end
    local buttonAddedConnection = self.ScreenGui.DescendantAdded:Connect(attachClickSound)
    table.insert(self._scriptConnections, buttonAddedConnection)
    local buttonRemovedConnection = self.ScreenGui.DescendantRemoving:Connect(function(descendant)
        local connection = soundButtonConnections[descendant]
        if connection then
            connection:Disconnect()
            soundButtonConnections[descendant] = nil
        end
    end)
    table.insert(self._scriptConnections, buttonRemovedConnection)
    local rainbowConn=RunService.Heartbeat:Connect(function()
        if self.Destroyed then return end
        if state.Rainbow and borderStroke then borderStroke.Color=Color3.fromHSV((os.clock()*0.15)%1,1,1) end
    end)
    table.insert(self._scriptConnections,rainbowConn)
    self.ScreenGui.Destroying:Connect(function()
        if fx then fx:Destroy() end
    end)
    return tab
end

--============================================================
-- Live Theme Studio: 50 presets plus individual color editing.
--============================================================
function Window:CreateThemeEditorTab(settingsTab)
    if self.ThemeEditorTab then return self.ThemeEditorTab end
    local tab = settingsTab or self:Tab({ Title = "Themes", Icon = "palette" })
    self.ThemeEditorTab = tab

    local function spaced(section)
        for _, method in ipairs({"Slider", "Checkbox", "Dropdown", "Input", "Button", "Colorpicker"}) do
            section[method] = function(self, config)
                local element = Section[method](self, config)
                Section.Space(self, 4)
                return element
            end
        end
        return section
    end

    local paletteSection = spaced(tab:Section({Title="THEME PRESETS", Side="Left", Icon="swatch-book"}))
    local editorSection = spaced(tab:Section({Title="CUSTOM COLORS", Side="Right", Icon="sliders-horizontal"}))

    local backgrounds = {
        { "Midnight", Color3.fromRGB(13, 15, 24) },
        { "Obsidian", Color3.fromRGB(17, 17, 20) },
        { "Graphite", Color3.fromRGB(27, 30, 35) },
        { "Ocean", Color3.fromRGB(11, 24, 37) },
        { "Forest", Color3.fromRGB(15, 28, 25) },
        { "Bordeaux", Color3.fromRGB(34, 18, 27) },
        { "Plum", Color3.fromRGB(26, 18, 38) },
        { "Espresso", Color3.fromRGB(33, 26, 22) },
        { "Slate", Color3.fromRGB(25, 33, 45) },
        { "Cloud", Color3.fromRGB(227, 231, 240) },
    }
    local accents = {
        { "Amethyst", Color3.fromRGB(161, 118, 255) },
        { "Cyan", Color3.fromRGB(59, 207, 231) },
        { "Rose", Color3.fromRGB(242, 115, 170) },
        { "Mint", Color3.fromRGB(78, 213, 165) },
        { "Amber", Color3.fromRGB(245, 180, 85) },
    }
    local names, presets = {}, {}
    local function mix(a, b, t) return a:Lerp(b, t) end
    for _, base in ipairs(backgrounds) do
        for _, accent in ipairs(accents) do
            local name = base[1] .. " / " .. accent[1]
            local light = base[1] == "Cloud"
            local bg, highlight = base[2], accent[2]
            local txt = light and Color3.fromRGB(28, 32, 43) or Color3.fromRGB(235, 237, 245)
            local muted = light and Color3.fromRGB(92, 99, 115) or Color3.fromRGB(156, 161, 177)
            local raised = light and mix(bg, Color3.new(1,1,1), .35) or mix(bg, Color3.new(1,1,1), .095)
            local surface = light and mix(bg, Color3.new(1,1,1), .20) or mix(bg, Color3.new(1,1,1), .045)
            local border = light and mix(bg, Color3.new(0,0,0), .17) or mix(bg, Color3.new(1,1,1), .19)
            presets[name] = {
                BackgroundTop=bg, BackgroundBottom=bg, Sidebar=surface,
                Surface=surface, Surface2=raised, SurfaceHover=mix(raised,highlight,.13),
                Input=bg, Popup=surface, CodeBackground=bg, Button=raised,
                ButtonHover=mix(raised,highlight,.12), Accent=highlight,
                AccentHover=mix(highlight,Color3.new(1,1,1),.20),
                SliderFill=highlight, SliderTrack=border,
                Text=txt, ButtonText=txt, TopbarText=txt, TopbarTextHover=txt,
                SubText=muted, MutedText=muted, DimText=mix(muted,bg,.22),
                Icon=muted, IconSelected=txt, TopbarIcon=muted, TopbarIconHover=txt,
                Border=border, Stroke=border, SidebarDivider=border,
                CheckboxBorder=border, Scrollbar=muted, SliderKnob=txt,
                AccentText=Color3.fromRGB(255,255,255),
                Paper=surface, Sky=highlight, SkySoft=raised,
            }
            table.insert(names,name)
        end
    end
    -- Dropdown intentionally contains exactly 50 complete presets.
    paletteSection:Dropdown({
        Title="Theme Preset (50)", Values=names, Default=names[1],
        Callback=function(name)
            local preset=presets[name]
            if preset then self:SetTheme(preset) end
        end,
    })
    paletteSection:Button({Title="Restore Default Theme", Icon="rotate-ccw", Callback=function()
        self:SetTheme(copyTable(DefaultTheme))
    end})
    paletteSection:Paragraph({Content="Presets apply instantly. Change individual colors on the right to make your own theme."})
    paletteSection:Space(4)

    -- Real Executor: native Windows picker + custom workspace image asset.
    local imageSection = spaced(tab:Section({
        Title = "CUSTOM BACKGROUND IMAGE", Side = "Left", Icon = "image",
    }))
    local imageStatus = imageSection:Paragraph({
        Content = "Select a file?",
    })
    imageSection:Button({
        Title = "Select Image", Icon = "image-plus",
        Callback = function()
            if type(openfiledialog) ~= "function" or type(getcustomasset) ~= "function" then
                imageStatus:Set("This executor requires openfiledialog() and getcustomasset().")
                return
            end
            task.spawn(function()
                local ok, selected = pcall(openfiledialog, {
                    title = "Choose Background Image",
                    extensionFilter = { "png", "jpg", "jpeg", "webp" },
                })
                if not ok then
                    imageStatus:Set("File dialog error: " .. tostring(selected))
                    return
                end
                if not selected then return end -- Cancel keeps previous image.
                local nameOk, name = pcall(function() return selected:GetName() end)
                if not nameOk or type(name) ~= "string" then
                    imageStatus:Set("Unable to obtain the selected file name.")
                    return
                end
                local ext = name:lower():match("%.([a-z0-9]+)$")
                if not ({png=true,jpg=true,jpeg=true,webp=true})[ext] then
                    imageStatus:Set("Unsupported image format: " .. tostring(ext))
                    return
                end

                -- The documented Real getcustomasset() only accepts workspace files.
                -- Try the selected item if it exposes binary content, or an existing
                -- workspace file by the same name. Nothing reads arbitrary PC paths.
                local assetPath
                local bytes
                for _, method in ipairs({"GetBinaryContents", "Read", "GetContent"}) do
                    local methodOk, result = pcall(function()
                        local fn = selected[method]
                        if type(fn) == "function" then return fn(selected) end
                    end)
                    if methodOk and type(result) == "string" and #result > 0 then
                        bytes = result
                        break
                    end
                end
                if bytes and type(writefile) == "function" then
                    -- A new path for every selection prevents custom-asset caches
                    -- from serving an older image saved under the same filename.
                    local uniqueId = HttpService:GenerateGUID(false):gsub("%-", "")
                    assetPath = "PebbleUI/background_" .. uniqueId .. "." .. ext
                    local writeOk, writeErr = pcall(writefile, assetPath, bytes)
                    if not writeOk then
                        warn("[PebbleUI] Could not save selected image:", writeErr)
                        assetPath = nil
                    end
                end
                if not assetPath and type(isfile) == "function" then
                    local existsOk, exists = pcall(isfile, name)
                    if existsOk and exists then assetPath = name end
                end
                if not assetPath then
                    imageStatus:Set("Selected: " .. name .. ". Real did not expose the file bytes. Copy it to the executor workspace and select it again.")
                    return
                end
                local assetOk, asset = pcall(getcustomasset, assetPath)
                if not assetOk or type(asset) ~= "string" or asset == "" then
                    imageStatus:Set("Asset load failed: " .. tostring(asset))
                    return
                end
                self._backgroundAssetPath = assetPath
                self:SetBackgroundImage(asset)
                imageStatus:Set("Background applied: " .. name)
            end)
        end,
    })
    imageSection:Slider({
        Title = "Background Strength", Min = 0, Max = 100, Step = 1,
        Default = math.floor((self.BackgroundStrength or 0) * 100 + 0.5),
        Suffix = "%",
        Callback = function(value)
            self:SetBackgroundStrength(value / 100)
        end,
    })
    imageSection:Button({
        Title = "Remove Image", Icon = "x",
        Callback = function()
            self._backgroundAssetPath = nil
            self:SetBackgroundImage(nil)
            imageStatus:Set("Background image removed.")
        end,
    })

    local colors = {
        {"Accent", "Accent"}, {"Accent Hover", "AccentHover"},
        {"Background Top", "BackgroundTop"}, {"Background Bottom", "BackgroundBottom"},
        {"Explorer / Sidebar", "Sidebar"}, {"Sidebar Divider", "SidebarDivider"},
        {"Surface", "Surface"}, {"Raised Surface", "Surface2"},
        {"Surface Hover", "SurfaceHover"}, {"Input", "Input"},
        {"Popup", "Popup"}, {"Code Background", "CodeBackground"},
        {"Button", "Button"}, {"Button Hover", "ButtonHover"},
        {"Text", "Text"}, {"Secondary Text", "SubText"},
        {"Muted Text", "MutedText"}, {"Dim Text", "DimText"},
        {"Button Text", "ButtonText"}, {"Accent Text", "AccentText"},
        {"Border", "Border"}, {"Stroke", "Stroke"},
        {"Icon", "Icon"}, {"Selected Icon", "IconSelected"},
        {"Slider Track", "SliderTrack"}, {"Slider Fill", "SliderFill"},
        {"Slider Knob", "SliderKnob"}, {"Scrollbar", "Scrollbar"},
        {"Topbar Text", "TopbarText"}, {"Topbar Icon", "TopbarIcon"},
    }
    for _, pair in ipairs(colors) do
        local label, key = pair[1], pair[2]
        editorSection:Colorpicker({
            Title=label, Default=self.Theme[key] or DefaultTheme[key],
            Callback=function(color) self:SetTheme({[key]=color}) end,
        })
    end
    return tab
end

-- Settings is a standalone view, not an ordinary tab. Existing native control
-- factories are reused internally, then their frames are moved into one column.
function Window:CreateSettingsView()
    if self.SettingsView then return self.SettingsView end
    local previousTab = self.ActiveTab
    local settings = self:CreateSettingsTab()
    -- Theme presets and individual color controls now live inside Settings.
    self:CreateThemeEditorTab(settings)
    -- Undo the temporary navigation entry. The settings screen is accessed
    -- only through the cog in the top toolbar.
    for i = #self.Tabs, 1, -1 do
        if self.Tabs[i] == settings then table.remove(self.Tabs, i) break end
    end
    if settings.Button then settings.Button:Destroy() end
    settings.Button = nil
    if self.ActiveTab == settings then self.ActiveTab = previousTab end
    settings.Container.Visible = false

    local view = New("Frame", {
        Name = "StandaloneSettings", BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1), Visible = false,
        Parent = self.ContentHost,
    })
    self.SettingsView = view
    local scroll = StyleScrollBar(New("ScrollingFrame", {
        Name = "SettingsRows", BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.Never, Parent = view,
    }), { Thickness = 3, Color = self.Theme.Scrollbar, Transparency = 0.35 })
    local column = New("Frame", {
        Name = "SettingsColumn", BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = scroll,
    })
    Padding(column, 0, 0, 4, 12)
    List(column, 14)
    local heading = New("TextLabel", {
        Name = "SettingsHeading", BackgroundTransparency = 1,
        Text = "Settings", TextColor3 = self.Theme.Text,
        Font = self.Theme.FontBold, TextSize = 19,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, 0, 0, 35), LayoutOrder = 0, Parent = column,
    })
    BindTheme(self, heading, "TextColor3", "Text")
    local order = { WINDOW = 1, ANIMATIONS = 2, ["THEME PRESETS"] = 3,
        ["CUSTOM BACKGROUND IMAGE"] = 4, ["CUSTOM COLORS"] = 5 }
    for _, section in ipairs(settings.Sections) do
        section.Frame.Parent = column
        section.Frame.LayoutOrder = order[section.Title.Text] or 10
        section.Frame.Size = UDim2.new(1, 0, 0, section.Frame.Size.Y.Offset)
        section.Frame.BackgroundTransparency = 0
        -- Hide the ordinary boxed-section chrome. Rows and separators remain.
        local border = section.Frame:FindFirstChildOfClass("UIStroke")
        if border then border.Transparency = 1 end
    end
    -- Remove the unused split-column frame, preserving relocated sections.
    settings.Container:Destroy()
    settings.Container = nil
    self.SettingsTab = nil
    task.defer(function()
        if self.SettingsApplyPanelDepth then self.SettingsApplyPanelDepth(100) end
    end)
    return view
end

function Window:ToggleSettings(force)
    if not self.SettingsView then return self end
    local opening = force
    if opening == nil then opening = not self.SettingsView.Visible end
    if opening then
        if self.ActiveBlueprint then self:_LeaveBlueprintEditor() end
        if self.ActiveScript then self:_LeaveScriptEditor() end
        if self.ActiveDropdown then self.ActiveDropdown:Close() end
        if self.ActiveColorpicker then self.ActiveColorpicker:Close() end
        for _, tab in ipairs(self.Tabs) do tab.Container.Visible = false end
        self.SettingsView.Visible = true
        self.SettingsOpen = true
    else
        self.SettingsView.Visible = false
        self.SettingsOpen = false
        if self.ActiveTab then self.ActiveTab.Container.Visible = true
        elseif self.Tabs[1] then self:_setActiveTab(self.Tabs[1]) end
    end
    return self
end

