    local function discoverProperties(class, sample, service)
        local names, seen, fields = {}, {}, {}
        local function add(name) if not seen[name] then seen[name] = true; table.insert(names, name) end end
        for _, name in ipairs(BASIC) do add(name) end
        do
            for ancestor, props in pairs(PROPERTIES) do
                local ok, isA = pcall(function() return sample:IsA(ancestor) end)
                if ok and (isA or (ancestor == "TextLabel" and (class == "TextButton" or class == "TextBox"))
                    or (ancestor == "ImageLabel" and class == "ImageButton")) then
                    for _, name in ipairs(props) do add(name) end
                end
            end
        end
        if service then
            for _, name in ipairs(service) do add(name) end
        end
        local ok, reflected = pcall(function() return game:GetService("ReflectionService"):GetPropertiesOfClass(class) end)
        if ok and type(reflected) == "table" then
            for _, property in ipairs(reflected) do if type(property.Name) == "string" then add(property.Name) end end
        end
        table.sort(names, function(a, b)
            if a == "Name" then return b ~= "Name" end
            if b == "Name" then return false end
            if a == "Parent" then return b ~= "Parent" end
            if b == "Parent" then return false end
            return a < b
        end)
        for _, name in ipairs(names) do
            if name ~= "Source" and name ~= "ScriptGuid" and name ~= "UniqueId" and name ~= "Capabilities" and name ~= "Sandboxed" then
                local readOk, value = pcall(function() return sample[name] end)
                if readOk then
                    local kind = value == nil and "Instance" or fieldType(value)
                    local writable = false
                    if not service then writable = pcall(function() sample[name] = value end) end
                    if service then
                        for _, allowed in ipairs(service) do if allowed == name then writable = true end end
                    end
                    local p = port(name, kind, encodeValue(value), class .. "." .. name .. " · " .. kind .. (writable and " · local read/write" or " · read-only"))
                    p.Writable, p.Property = writable, true
                    -- Unknown complex literals are read-only unless explicitly connected.
                    fields[#fields + 1] = p
                end
            end
        end
        return fields
    end
