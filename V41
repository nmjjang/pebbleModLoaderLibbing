-- Smooth, reusable Explorer reveal (fade + slide from the left edge).
local function ExplorerReveal(window, items)
    if not items then return end
    for index, item in ipairs(items) do
        if item and item:IsA("GuiObject") then
            local finalPosition = item.Position
            local finalTransparency = item:IsA("TextLabel") or item:IsA("TextButton") and item.Text ~= "" and item.TextTransparency or nil
            -- Only change presentation; existing UI controls and callbacks remain intact.
            local textObjects = {}
            if item:IsA("TextLabel") or item:IsA("TextButton") then table.insert(textObjects,item) end
            for _,child in ipairs(item:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then table.insert(textObjects,child) end
            end
            item.Position = finalPosition - UDim2.fromOffset(11,0)
            for _,textObj in ipairs(textObjects) do
                textObj.TextTransparency = 1
            end
            for _,child in ipairs(item:GetDescendants()) do
                if child:IsA("ImageLabel") then
                    local target = child:GetAttribute("PebbleRevealAlpha")
                    if target == nil then target = child.ImageTransparency; child:SetAttribute("PebbleRevealAlpha",target) end
                    child.ImageTransparency = 1
                    task.delay((index-1)*0.035,function()
                        if child.Parent then Tween(child,0.3,{ImageTransparency=target},Enum.EasingStyle.Quart) end
                    end)
                end
            end
            task.delay((index-1)*0.035,function()
                if not item.Parent then return end
                Tween(item,0.34,{Position=finalPosition},Enum.EasingStyle.Quart)
                for _,textObj in ipairs(textObjects) do
                    if textObj.Parent then Tween(textObj,0.32,{TextTransparency=0},Enum.EasingStyle.Quart) end
                end
            end)
        end
    end
end

-- A pasta ignora cliques durante a transição (trava individual).
-- O tempo acompanha o stagger do fade/slide ao abrir.
local function ExplorerBeginTransition(window, folder, list, empty, opening)
    window._explorerTransitionLocks = window._explorerTransitionLocks or {}
    if window._explorerTransitionLocks[folder] then return false end
    local count = 0
    if opening and list then
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject") then count += 1 end
        end
    end
    if opening and empty and empty.Visible then count = 1 end
    local duration = opening and (0.36 + math.max(0, count - 1) * 0.035) or 0.26
    duration = math.min(duration, 1.25)
    window._explorerTransitionLocks[folder] = true
    task.delay(duration, function()
        if window._explorerTransitionLocks then
            window._explorerTransitionLocks[folder] = nil
        end
    end)
    return true
end

local function ExplorerRevealList(window, list, empty)
    local targets = {}
    if empty and empty.Visible then
        table.insert(targets,empty)
    elseif list and list.Visible then
        for _,child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("UIListLayout") then
                table.insert(targets,child)
            end
        end
    end
    ExplorerReveal(window,targets)
end

-- Reverse animation for closing Explorer folders. The list layout is only
-- recalculated after the fade finishes, preventing abrupt disappearing rows.
local function ExplorerHideList(window, list, empty, done)
    window._folderCloseTokens = window._folderCloseTokens or {}
    local key = list or empty
    local token = (window._folderCloseTokens[key] or 0) + 1
    window._folderCloseTokens[key] = token
    local targets = {}
    if empty and empty.Visible then
        table.insert(targets, empty)
    elseif list and list.Visible then
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject") then table.insert(targets, child) end
        end
    end
    local originals = {}
    for _, item in ipairs(targets) do
        local objects = {item}
        for _, descendant in ipairs(item:GetDescendants()) do
            if descendant:IsA("GuiObject") then table.insert(objects, descendant) end
        end
        for _, obj in ipairs(objects) do
            local props = {}
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                props.TextTransparency = obj.TextTransparency
                Tween(obj, 0.23, {TextTransparency = 1}, Enum.EasingStyle.Quart)
            end
            if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                props.ImageTransparency = obj.ImageTransparency
                Tween(obj, 0.23, {ImageTransparency = 1}, Enum.EasingStyle.Quart)
            end
            if obj.BackgroundTransparency < 1 then
                props.BackgroundTransparency = obj.BackgroundTransparency
                Tween(obj, 0.23, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
            end
            if next(props) then table.insert(originals, {obj, props}) end
        end
        -- UIListLayout controls row positions. Move their contents instead.
        -- Empty placeholders have no UIListLayout and can slide directly.
        if item == empty then
            local position = item.Position
            Tween(item, 0.23, {Position = position - UDim2.fromOffset(10, 0)}, Enum.EasingStyle.Quart)
            table.insert(originals, {item, {Position = position}})
        end
    end
    task.delay(0.24, function()
        if window.Destroyed then return end
        local current = window._folderCloseTokens[key] == token
        if current then done() end
        -- Reset visual values so opening always starts with valid base state.
        for _, entry in ipairs(originals) do
            if entry[1] and entry[1].Parent then
                for prop, value in pairs(entry[2]) do entry[1][prop] = value end
            end
        end
    end)
end

