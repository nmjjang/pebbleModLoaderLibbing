function Window:_ArchiveFile()
    if self.Config.ArchiveFile == false then return nil end
    if type(self.Config.ArchiveFile) == "string" then return self.Config.ArchiveFile end
    local identity = tostring(self.Config.Name or self.Title or "PebbleUI"):gsub("[^%w_-]", "_"):sub(1,64)
    return "PebbleUI_" .. identity .. "_archives.json"
end
function Window:_SaveArchives()
    if type(self.Config.SaveArchives) == "function" then
        local ok, err=pcall(self.Config.SaveArchives, copyTable(self.Archives), self)
        if not ok then warn("[PebbleUI Archive] Save failed:",err) end
        return ok
    end
    if not self._archiveFile or type(writefile) ~= "function" then return false end
    local ok, err=pcall(function() writefile(self._archiveFile,HttpService:JSONEncode({Version=1,Entries=self.Archives})) end)
    if not ok then warn("[PebbleUI Archive] Save failed:",err) end
    return ok
end
function Window:_LoadArchives()
    self.Archives={Cloud={},Auto={}}
    self._archiveFile=self:_ArchiveFile()
    local payload
    if type(self.Config.LoadArchives)=="function" then
        local ok,result=pcall(self.Config.LoadArchives,self)
        if ok then payload=result else warn("[PebbleUI Archive] Load failed:",result) end
    elseif self._archiveFile and type(readfile)=="function" then
        local exists=true
        if type(isfile)=="function" then
            local ok,result=pcall(isfile,self._archiveFile); exists=ok and result
        end
        if exists then
            local ok,result=pcall(function() return HttpService:JSONDecode(readfile(self._archiveFile)) end)
            if ok then payload=result else warn("[PebbleUI Archive] Load failed:",result) end
        end
    end
    if type(payload)=="table" then
        local entries=payload.Entries or payload
        for _,mode in ipairs({"Cloud","Auto"}) do
            if type(entries[mode])=="table" then
                for _,entry in ipairs(entries[mode]) do
                    if type(entry)=="table" and (entry.Kind=="Script" or entry.Kind=="Blueprint")
                        and type(entry.Name)=="string" then
                        table.insert(self.Archives[mode],entry)
                    end
                end
            end
        end
    end
end
function Window:ToggleArchive(mode,kind,record)
    if not self.Archives or not self.Archives[mode] or not record then return false end
    if kind=="Script" and self.ActiveScript==record and self.ScriptEditorElements then
        record.Source=NormalizeSource(self.ScriptEditorElements.Input.Text)
    end
    local list=self.Archives[mode]
    local key=ArchiveKey(kind,record.Name)
    for i,item in ipairs(list) do
        if ArchiveKey(item.Kind,item.Name)==key then
            table.remove(list,i)
            self:_SaveArchives(); self:_RenderArchiveRows()
            return true
        end
    end
    local entry={Kind=kind,Name=record.Name}
    if kind=="Script" then entry.Source=record.Source
    else entry.Nodes=copyTable(record.Nodes);entry.Links=copyTable(record.Links);entry.View=copyTable(record.View) end
    table.insert(list,entry)
    self:_SaveArchives();self:_RenderArchiveRows()
    return true
end
function Window:_OpenArchiveEntry(mode,entry)
    local kind=entry.Kind
    local name=entry.Name:gsub("%.lua$",""):gsub("%.bp$","")
    if kind=="Script" then
        local record=self:CreateScript({Name=name.."_copy",Open=false})
        if not record then return end
        self:SetScriptSource(record,entry.Source or "")
        self:OpenScript(record)
    else
        local record=self:CreateBlueprint({Name=name.."_copy",Empty=true,Open=false})
        if not record then return end
        record.Nodes=copyTable(entry.Nodes or {})
        record.Links=copyTable(entry.Links or {})
        record.View=copyTable(entry.View or {X=30,Y=30,Zoom=0.85})
        self:_BlueprintChanged(record)
        self:OpenBlueprint(record)
    end
end
function Window:_CreateArchiveExplorer()
    self:_LoadArchives()
    self.ArchiveUI={}
    local theme=self.Theme
    for _,mode in ipairs({"Cloud","Auto"}) do
        local folder=New("TextButton",{Name=mode.."ArchiveFolder",BackgroundTransparency=1,
            Text="",AutoButtonColor=false,Size=UDim2.new(1,-16,0,25),ZIndex=12,Parent=self.ScriptExplorer})
        local arrow=CreateIcon("chevron-down",11,theme.MutedText,14)
        arrow.Position=UDim2.fromOffset(2,7); arrow.Parent=folder
        local icon=CreateIcon(mode=="Cloud" and "cloud" or "rotate-cw",15,theme.Icon,14)
        icon.Position=UDim2.fromOffset(20,5);icon.Parent=folder
        local name=New("TextLabel",{BackgroundTransparency=1,Text=mode=="Cloud" and "Cloud Scripts" or "Auto-Execute",
            Font=theme.FontMedium,TextSize=11,TextColor3=theme.SubText,
            TextXAlignment=Enum.TextXAlignment.Left,Position=UDim2.fromOffset(42,0),
            Size=UDim2.new(1,-46,1,0),ZIndex=14,Parent=folder})
        BindTheme(self,arrow,"ImageColor3","MutedText")
        BindTheme(self,icon,"ImageColor3","Icon")
        BindTheme(self,name,"TextColor3","SubText")
        local list=StyleScrollBar(New("ScrollingFrame",{Name=mode.."ArchiveList",BackgroundTransparency=1,
            BorderSizePixel=0,CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,
            ScrollingDirection=Enum.ScrollingDirection.Y,ClipsDescendants=true,ZIndex=12,
            Parent=self.ScriptExplorer}),{Thickness=2,Color=theme.Scrollbar,Transparency=0.6})
        List(list,2)
        local empty=New("TextLabel",{Name="ArchiveEmpty",Text="No Scripts Yet",BackgroundTransparency=1,
            TextColor3=theme.MutedText,Font=theme.Font,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,
            Size=UDim2.new(1,-16,0,27),LayoutOrder=1,ZIndex=14,Parent=list})
        BindTheme(self,empty,"TextColor3","MutedText")
        self.ArchiveUI[mode]={Folder=folder,Arrow=arrow,List=list,Empty=empty,Collapsed=false}
        folder.MouseButton1Click:Connect(function()
            local ui=self.ArchiveUI[mode]
            if not ExplorerBeginTransition(self, folder, ui.List, ui.Empty, ui.Collapsed) then return end
            if ui.Collapsed then
                ui.Collapsed=false
                Tween(ui.Arrow,0.23,{Rotation=0})
                self:_LayoutArchiveExplorer()
                task.defer(function()
                    if not self.Destroyed and not self._explorerCollapsed then
                        ExplorerRevealList(self,ui.List,ui.Empty)
                    end
                end)
            else
                Tween(ui.Arrow,0.23,{Rotation=-90})
                ExplorerHideList(self,ui.List,ui.Empty,function()
                    ui.Collapsed=true
                    self:_LayoutArchiveExplorer()
                end)
            end
        end)
    end
    self:_RenderArchiveRows()
    self.Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if not self.Destroyed then self:_LayoutArchiveExplorer() end
    end)
end
function Window:_LayoutArchiveExplorer()
    if not self.ArchiveUI or not self.ScriptExplorerElements then return end
    local collapsed=self._explorerCollapsed
    local count=self.ScriptExplorerElements.Count
    local y=count.Position.Y.Offset+28
    local maxHeight=math.max(0,self.ScriptExplorer.AbsoluteSize.Y-y-8)
    for _,mode in ipairs({"Cloud","Auto"}) do
        local ui=self.ArchiveUI[mode]
        ui.Folder.Position=UDim2.fromOffset(8,y)
        ui.Folder.Visible=not collapsed
        y+=26
        local wanted=ui.Collapsed and 0 or math.min(math.max(1,#self.Archives[mode])*29,88)
        local h=math.max(0,math.min(wanted,maxHeight-55))
        ui.List.Position=UDim2.fromOffset(8,y)
        ui.List.Size=UDim2.new(1,-16,0,h)
        ui.List.Visible=not collapsed and not ui.Collapsed and h>0
        ui.Empty.Visible=not collapsed and not ui.Collapsed and h>0
            and #self.Archives[mode]==0
        y+=h+7;maxHeight-=h+33
    end
end
function Window:_RenderArchiveRows()
    if not self.ArchiveUI then return end
    for _,mode in ipairs({"Cloud","Auto"}) do
        local ui=self.ArchiveUI[mode]
        for _,child in ipairs(ui.List:GetChildren()) do
            if child:IsA("GuiObject") and child ~= ui.Empty then child:Destroy() end
        end
        ui.Empty.Visible = not self._explorerCollapsed and not ui.Collapsed
            and #self.Archives[mode] == 0
        for i,entry in ipairs(self.Archives[mode]) do
            local item=entry
            local row=New("TextButton",{Name="Archived"..i,Text="",BackgroundTransparency=1,
                AutoButtonColor=false,Size=UDim2.new(1,-4,0,27),LayoutOrder=i,ZIndex=13,Parent=ui.List})
            local glyph=CreateIcon(item.Kind=="Script" and "code" or "workflow",13,self.Theme.Icon,14)
            glyph.Position=UDim2.fromOffset(12,7);glyph.Parent=row
            local textLabel=New("TextLabel",{Text=item.Name,BackgroundTransparency=1,
                Font=self.Theme.FontMedium,TextSize=10,TextColor3=self.Theme.SubText,
                TextTruncate=Enum.TextTruncate.AtEnd,TextXAlignment=Enum.TextXAlignment.Left,
                Position=UDim2.fromOffset(32,0),Size=UDim2.new(1,-56,1,0),ZIndex=14,Parent=row})
            local remove=New("TextButton",{Text="×",BackgroundTransparency=1,Font=self.Theme.Font,
                TextSize=16,TextColor3=self.Theme.MutedText,Position=UDim2.new(1,-23,0,0),
                Size=UDim2.fromOffset(22,27),ZIndex=16,Parent=row})
            row.MouseButton1Click:Connect(function() self:_OpenArchiveEntry(mode,item) end)
            remove.MouseButton1Click:Connect(function()
                for index,v in ipairs(self.Archives[mode]) do
                    if v==item then table.remove(self.Archives[mode],index);break end
                end
                self:_SaveArchives();self:_RenderArchiveRows()
            end)
        end
    end
    self:_LayoutArchiveExplorer()
end
function Window:_RunAutoArchives()
    if not self.Archives then return end
    for i,entry in ipairs(self.Archives.Auto) do
        if self.Destroyed then return end
        local unique="__pebble_auto_"..i
        if entry.Kind=="Script" then
            local record={Id=unique,Name=entry.Name,Source=entry.Source or "",Window=self}
            self._scriptsById[unique]=record
            local ok,err=pcall(function() self:RunScript(record) end)
            if not ok then warn("[PebbleUI Auto] Script:",err) end
            local started = self._runningScriptThread
            if started then
                local deadline=os.clock()+12
                while not self.Destroyed and self._runningScriptThread==started and os.clock()<deadline do task.wait(0.05) end
            end
            self._scriptsById[unique]=nil
        elseif entry.Kind=="Blueprint" then
            local record={Id=unique,Name=entry.Name,Nodes=copyTable(entry.Nodes or {}),
                Links=copyTable(entry.Links or {}),View=copyTable(entry.View or {}),Window=self}
            self._blueprintsById[unique]=record
            local ok,err=pcall(function() self:RunBlueprint(record) end)
            if not ok then warn("[PebbleUI Auto] Blueprint:",err) end
        end
    end
end

