            scripts.Empty.Position = UDim2.fromOffset(18, 83 + explorerOffset)
            scripts.Empty.Size = UDim2.new(1, -36, 0, math.min(50, scriptsHeight))
            scripts.Empty.Visible = #self.CustomScripts == 0 and not self._scriptsCollapsed
            ui.Folder.Position = UDim2.fromOffset(8, y)
            ui.List.Position = UDim2.fromOffset(8, y + 29)
            ui.List.Size = UDim2.new(1, -16, 1, -(y + 64))
            ui.List.Visible = not self._blueprintsCollapsed
            ui.Empty.Position = UDim2.fromOffset(18, y + 33)
            ui.Empty.Visible = #self.CustomBlueprints == 0 and not self._blueprintsCollapsed
        end
        scripts.Count.Text = #self.CustomScripts .. " scripts · " .. #self.CustomBlueprints .. " BP"
        scripts.Count.Size = UDim2.new(1, -24, 0, 24)
        scripts.Storage.Visible = false
