function Window:_EditorMeasure(text)
    return TextService:GetTextSize(text, 13, Enum.Font.Code, Vector2.new(100000, 100000)).X
end

function Window:_RenderScriptEditor()
    local ui = self.ScriptEditorElements
    if not ui or not self.ActiveScript then return end
    local source, lines, numbers, maxWidth, start = self.ActiveScript.Source, {}, {}, 0, 1
    for line in (source .. "\n"):gmatch("(.-)\n") do
        table.insert(lines, { Text = line, Start = start })
        table.insert(numbers, tostring(#lines))
        start = start + #line + 1
        maxWidth = math.max(maxWidth, self:_EditorMeasure(line))
    end
    self._editorLines = lines
    local width = math.max(ui.Scroll.AbsoluteSize.X, maxWidth + 36, 120)
    local height = math.max(ui.Scroll.AbsoluteSize.Y, #lines * 20 + 28, 60)
    self._editorCanvasWidth, self._editorCanvasHeight = width, height
    ui.Scroll.CanvasSize = UDim2.fromOffset(width, height)
    ui.Input.Size = UDim2.fromOffset(width - 20, height - 20)
    ui.Highlight.Size = ui.Input.Size
    ui.Numbers.Text = table.concat(numbers, "\n")
    ui.Numbers.Size = UDim2.new(1, -12, 0, height)
    local highlighted = HighlightLua(source, self.Theme)
    self._editorHasHighlight = highlighted ~= nil
    ui.Highlight.Text = highlighted or ""
    ui.Input.TextTransparency = highlighted and 1 or 0
    ui.Highlight.TextColor3 = self.Theme.Text
    ui.Input.TextColor3 = self.Theme.Text
    ui.Caret.BackgroundColor3 = self.Theme.Accent
    ui.ActiveLine.BackgroundColor3 = self.Theme.SurfaceHover
    ui.LineCount.Text = "Lua · " .. tostring(#lines) .. (#lines == 1 and " line" or " lines")
    self:_UpdateEditorCursor(false)
end

function Window:_EditorLineAt(bytePosition)
    local lines = self._editorLines or { { Start = 1, Text = "" } }
    local low, high = 1, #lines
    while low < high do
        local middle = math.floor((low + high + 1) / 2)
        if lines[middle].Start <= bytePosition then low = middle else high = middle - 1 end
    end
    return low, lines[low]
end


