        end
        if payload==nil and err==nil and self.Config.Blueprints then payload={ Version=1,Blueprints=self.Config.Blueprints } end
        if payload~=nil then local ok,result=self:ImportBlueprints(payload,true); if not ok then err=result end end
        if err then self._blueprintStorageBlocked=true; self._hasBlueprintStorage=false; self:_BlueprintNotice("Could not load blueprints: " .. tostring(err),true) end
        self._blueprintsDirty=false; self._blueprintSaveRevision=(self._blueprintSaveRevision or 0)+1
        for _,r in ipairs(self.CustomBlueprints) do r.Dirty=false end
