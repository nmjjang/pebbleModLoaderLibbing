--============================================================

local LuaKeywords = {}
for word in ("and break continue do else elseif end false for function if in local nil not or repeat return then true until while export type"):gmatch("%S+") do
    LuaKeywords[word] = true
end
local LuaBuiltins = {}
for word in ("assert error ipairs pairs next pcall xpcall print warn tostring tonumber typeof require select unpack setmetatable getmetatable rawget rawset rawequal math string table task coroutine utf8 os debug bit32 game workspace script Enum Instance Color3 Vector2 Vector3 CFrame UDim UDim2 ColorSequence NumberSequence"):gmatch("%S+") do
    LuaBuiltins[word] = true
end

local function EscapeRichText(text)
    return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        :gsub('"', "&quot;"):gsub("'", "&apos;"))
end

local function ColorHex(color)
    return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function HighlightLua(source, theme)
    -- Never put markup into the TextBox: the RichText layer only displays it.
    if #source > 20000 then return nil end
    local parts, i, lastWord = {}, 1, nil
    local palette = {}
    for _, key in ipairs({ "SyntaxKeyword", "SyntaxString", "SyntaxNumber", "SyntaxComment", "SyntaxBuiltin", "SyntaxFunction" }) do
        palette[key] = ColorHex(theme[key])
    end
    local function append(token, key)
        local escaped = EscapeRichText(token)
        table.insert(parts, key and ('<font color="' .. palette[key] .. '">' .. escaped .. '</font>') or escaped)
    end
    local function longEnd(start)
        local equals = source:sub(start):match("^%[(=*)%[")
        if equals == nil then return nil end
        local close = "]" .. equals .. "]"
        local found = source:find(close, start + #equals + 2, true)
        return found and (found + #close - 1) or #source
    end
    while i <= #source do
        local char, pair = source:sub(i, i), source:sub(i, i + 1)
        if pair == "--" then
            local finish = longEnd(i + 2)
            if not finish then finish = (source:find("\n", i + 2, true) or (#source + 1)) - 1 end
            append(source:sub(i, finish), "SyntaxComment")
            i = finish + 1
        elseif char == '"' or char == "'" or char == "`" then
            local finish = i + 1
            while finish <= #source do
                local current = source:sub(finish, finish)
                if current == "\\" then finish = finish + 2
                elseif current == char then finish = finish + 1; break
                else finish = finish + 1 end
            end
            append(source:sub(i, finish - 1), "SyntaxString")
            i = finish
        elseif char == "[" and longEnd(i) then
            local finish = longEnd(i)
            append(source:sub(i, finish), "SyntaxString")
            i = finish + 1
        elseif char:match("[%a_]") then
            local word = source:sub(i):match("^[%w_]+")
            local key
            if LuaKeywords[word] then key = "SyntaxKeyword"
            elseif LuaBuiltins[word] then key = "SyntaxBuiltin"
            elseif lastWord == "function" or source:sub(i + #word):match("^%s*%(") then key = "SyntaxFunction" end
            append(word, key)
            lastWord = word
            i = i + #word
        elseif char:match("%d") or (char == "." and source:sub(i + 1, i + 1):match("%d")) then
            local rest = source:sub(i)
            local number = rest:match("^0[xX][%da-fA-F_]+") or rest:match("^0[bB][01_]+")
            if not number then
                if rest:match("^%d[%d_]*%.%.") then number = rest:match("^%d[%d_]*")
                else number = rest:match("^%d[%d_]*%.?[%d_]*[eE][%+%-]?[%d_]+")
                    or rest:match("^%d[%d_]*%.?[%d_]*") or rest:match("^%.%d[%d_]*") end
            end
            append(number, "SyntaxNumber")
            i = i + #number
        else
            append(char)
            if not char:match("%s") and char ~= "." and char ~= ":" then lastWord = nil end
            i = i + 1
        end
    end
    local result = table.concat(parts)
    if #result > 180000 then return nil end
    return result
end

local function NormalizeSource(source)
    return (source:gsub("\r\n", "\n"):gsub("\r", "\n"))
end

local function ScriptName(window, name, exceptId, names)
    if type(name) ~= "string" then return nil, "Enter a script name." end
    name = name:match("^%s*(.-)%s*$")
    if name:lower():sub(-4) == ".lua" then name = name:sub(1, -5):match("^%s*(.-)%s*$") end
    if name == "" or name == "." or name == ".." then return nil, "Enter a script name." end
    if #name > 60 or name:find("[%c/\\]") then return nil, "Use a short name without slashes or line breaks." end
    name = name .. ".lua"
    if names then
        if names[name:lower()] then return nil, "A script with that name already exists." end
    else
        for _, record in ipairs(window.CustomScripts) do
            if record.Id ~= exceptId and record.Name:lower() == name:lower() then
                return nil, "A script with that name already exists."
            end
        end
    end
    return name
end

